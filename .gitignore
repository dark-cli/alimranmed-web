# build output
dist/
# generated types
.astro/
# responsive image variants — regenerated by scripts/optimize-images.mjs
# on every build. The manifest.json is committed as a seed (empty on fresh
# clones) so src/lib/image.ts always has something to import; the actual
# .webp files are build artifacts.
public/optimized/*
!public/optimized/manifest.json

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# wrangler files
.wrangler
.dev.vars

# Obsidian files
src/pages/.obsidian/
.obsidian/

# package-lock — using npm but not committing lockfile
package-lock.json

# Discovery output from `npm run fetch-ar` — regenerable, not source
scripts/ar-staging/Neurosurgeon consultant website design.zip

