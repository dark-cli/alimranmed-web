{
  "name": "alimranmed-web",
  "description": "Alimran Medical Center — Neurology and Musculoskeletal Disorders",
  "private": true,
  "dependencies": {
    "@astrojs/cloudflare": "12.6.0",
    "@astrojs/mdx": "4.3.0",
    "@astrojs/rss": "4.0.11",
    "@astrojs/sitemap": "3.4.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "astro": "5.10.1",
    "astro-navbar": "^2.4.0",
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "hast-util-from-html": "^2.0.3",
    "turndown": "^7.2.4",
    "unist-util-visit": "^5.1.0",
    "wrangler": "4.21.x"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "cf-typegen": "wrangler types",
    "check": "astro build && tsc && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "astro dev --host",
    "preview": "astro build && wrangler dev",
    "migrate": "node --experimental-strip-types --no-warnings scripts/migrate.mjs",
    "migrate:dry": "node --experimental-strip-types --no-warnings scripts/migrate.mjs --dry-run --limit=5",
    "media": "node --experimental-strip-types --no-warnings scripts/download-media.mjs",
    "redirects": "node --experimental-strip-types --no-warnings scripts/generate-redirects.mjs",
    "rewrite-links": "node --experimental-strip-types --no-warnings scripts/rewrite-legacy-links.mjs"
  },
  "type": "module"
}
