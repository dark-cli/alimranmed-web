---
import "../styles/global.css";
import { SITE_TITLE, SITE_NAME, SITE_DESCRIPTION } from "../consts";
import { currentLocale, alternateHref } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = "/images/og-cover.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const locale = currentLocale(Astro);
const otherLocale = locale === "en" ? "ar" : "en";
const alternatePath = alternateHref(Astro.url.pathname, otherLocale);
const alternateURL = new URL(alternatePath, Astro.site);

// Non-production builds (beta, staging, previews) should be hidden from
// search engines. Default to PRODUCTION so that if the env var is missing
// for any reason we never accidentally noindex the live site.
const cfBranch = process.env.CF_PAGES_BRANCH || "";
const NON_PROD_BRANCHES = new Set(["beta", "staging", "preview", "dev"]);
const isProduction = !NON_PROD_BRANCHES.has(cfBranch);
const robotsContent = isProduction ? "index, follow" : "noindex, nofollow";

const businessSchema = {
  "@context": "https://schema.org",
  "@type": ["MedicalClinic", "LocalBusiness"],
  name: "Alimran Medical Center",
  description:
    "Alimran Medical Center specializes in neurology and musculoskeletal disorders in Basra, Iraq — chiropractic, rehabilitation, brain stimulation (TMS/tDCS), pain management, physiotherapy, radiofrequency, and neurosurgery.",
  url: Astro.site,
  telephone: ["+964 780 1926801", "+964 770 6774773"],
  email: "info@alimranmed.com",
  address: [
    {
      "@type": "PostalAddress",
      addressLocality: "Basra",
      addressCountry: "IQ",
      streetAddress: "Breaha, Alnkba Medical Collection",
    },
  ],
  geo: {
    "@type": "GeoCoordinates",
    latitude: 30.5156,
    longitude: 47.7804,
  },
  medicalSpecialty: [
    "Neurology",
    "Neurosurgery",
    "Chiropractic",
    "PhysicalTherapy",
    "PainMedicine",
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Saturday"],
      opens: "09:00",
      closes: "18:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Friday",
      opens: "14:00",
      closes: "18:00",
    },
  ],
};
---

<script is:inline>
  // Mark embedded contexts so overscroll containment CSS can opt out.
  if (window.self !== window.top) {
    document.documentElement.classList.add("is-embedded");
  }
  // Apply theme before paint to avoid FOUC. Preference precedence:
  // 1) explicit user choice in localStorage, 2) prefers-color-scheme.
  // Also re-apply on Astro View Transitions swaps — ClientRouter replaces
  // the <html> attributes on navigation, which would drop data-theme.
  (function () {
    function apply() {
      try {
        var stored = localStorage.getItem("theme");
        var wantsDark = stored
          ? stored === "dark"
          : window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (wantsDark) {
          document.documentElement.setAttribute("data-theme", "dark");
        } else {
          document.documentElement.removeAttribute("data-theme");
        }
      } catch (e) {}
    }
    apply();
    document.addEventListener("astro:after-swap", apply);
  })();
</script>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<!-- Font Awesome kept for legacy pages (about/contact/blog etc.) that still
     render fa-* icons. New redesigned pages use inline SVG and don't need it. -->
<link rel="stylesheet" href="/fonts/fontawesome/fontawesome.css" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Alimran Clinic" />
<meta name="robots" content={robotsContent} />
<link rel="canonical" href={canonicalURL} />

<!-- Language alternates: only declare alternates, not self-reference -->
<link rel="alternate" hreflang={otherLocale}     href={alternateURL} />
<link rel="alternate" hreflang="x-default"       href={locale === "en" ? canonicalURL : alternateURL} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={locale === "ar" ? "ar_IQ" : "en_US"} />
<meta property="og:locale:alternate" content={otherLocale === "ar" ? "ar_IQ" : "en_US"} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.site)} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-3CWMPF92YB"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-3CWMPF92YB');
</script>
