---
import "../styles/global.css";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { currentLocale, alternateHref } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = "/images/og-cover.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const locale = currentLocale(Astro);
const otherLocale = locale === "en" ? "ar" : "en";
const alternatePath = alternateHref(Astro.url.pathname, otherLocale);
const alternateURL = new URL(alternatePath, Astro.site);

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: "Alimran Medical Center",
  description:
    "Alimran Medical Center specializes in neurology and musculoskeletal disorders in Basra, Iraq — chiropractic, rehabilitation, brain stimulation (TMS/tDCS), pain management, physiotherapy, radiofrequency, and neurosurgery.",
  url: Astro.site,
  telephone: ["+964 780 1926801", "+964 770 6774773"],
  email: "info@alimranmed.com",
  address: [
    {
      "@type": "PostalAddress",
      addressLocality: "Basra",
      addressCountry: "IQ",
      streetAddress: "Breaha, Alnkba Medical Collection",
    },
  ],
  medicalSpecialty: [
    "Neurology",
    "Neurosurgery",
    "Chiropractic",
    "PhysicalTherapy",
    "PainMedicine",
  ],
};
---

<script is:inline>
  // Restore stored theme before body paints to avoid a flash.
  // Runs on initial page load AND after every View Transitions swap so
  // navigating between pages doesn't drop the theme back to light.
  function applyStoredTheme() {
    var t = null;
    try { t = localStorage.getItem("theme"); } catch (e) {}
    if (!t) {
      t = "light";
    }
    if (t === "dark") {
      document.documentElement.setAttribute("data-theme", t);
    } else {
      document.documentElement.removeAttribute("data-theme");
    }
  }
  applyStoredTheme();
  document.addEventListener("astro:after-swap", applyStoredTheme);

  // Mark embedded contexts so overscroll containment CSS can opt out.
  // (Portal-mode integration will build on this — see docs/PORTAL.md.)
  if (window.self !== window.top) {
    document.documentElement.classList.add("is-embedded");
  }
</script>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="stylesheet" href="/fonts/fontawesome/fontawesome.css" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Alimran Medical Center" />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalURL} />

<!-- Language alternates for Google (each page tells search engines about its EN + AR variants) -->
<link rel="alternate" hreflang={locale}          href={canonicalURL} />
<link rel="alternate" hreflang={otherLocale}     href={alternateURL} />
<link rel="alternate" hreflang="x-default"       href={locale === "en" ? canonicalURL : alternateURL} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={locale === "ar" ? "ar_IQ" : "en_US"} />
<meta property="og:locale:alternate" content={otherLocale === "ar" ? "ar_IQ" : "en_US"} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.site)} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
