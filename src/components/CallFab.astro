---
/**
 * Site-wide floating call button.
 * Mobile-only (< 640px) — on desktop the sticky header's "Call the
 * secretary" pill covers the same job. Fades in after ~200px scroll.
 */
import { CONTACT } from "../consts";
import { currentLocale } from "../lib/i18n";

const locale = currentLocale(Astro);
const callHref = `tel:${CONTACT.phones[0].replace(/\s/g, "")}`;
const aria = locale === "ar"
  ? `اتصل بالسكرتير — ${CONTACT.phones[0]}`
  : `Call the secretary — ${CONTACT.phones[0]}`;
---

<a class="call-fab" href={callHref} aria-label={aria}>
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
  </svg>
</a>

<script is:inline>
  (function () {
    function tick() {
      var el = document.querySelector(".call-fab");
      if (!el) return;
      if (window.scrollY > 600) el.classList.add("is-visible");
      else el.classList.remove("is-visible");
    }
    if (!window.__callFabBound) {
      window.__callFabBound = true;
      document.addEventListener("scroll", tick, { passive: true });
    }
    document.addEventListener("astro:page-load", tick);
    tick();
  })();
</script>

<style is:global>
  .call-fab {
    position: fixed;
    bottom: 20px;
    inset-inline-end: 20px;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: var(--accent);
    color: var(--white);
    border-radius: 50%;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(11, 94, 120, 0.38);
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
    transition: opacity 220ms ease, transform 220ms ease;
  }
  .call-fab.is-visible { opacity: 1; transform: translateY(0); pointer-events: auto; }
  .call-fab:hover { background: var(--accent-hover); color: var(--white); text-decoration: none; }
  /* Desktop: sticky header already carries the "Call the secretary" pill. */
  @media (min-width: 640px) {
    .call-fab { display: none; }
  }
</style>
