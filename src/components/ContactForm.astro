---
/**
 * ContactForm — Appointment/inquiry form with Cloudflare Worker submission
 *
 * Submits to POST /api/contact and handles response with client-side messaging
 */

interface Props {
  title?: string;
  description?: string;
}

const { title = "Request an Appointment", description = "Fill out the form below to book a consultation or inquiry about our services." } = Astro.props;
---

<section class="contact-form-section">
  <div class="form-header">
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>

  <form id="contact-form" class="contact-form" method="POST" action="/api/contact">
    <div class="form-group">
      <label for="name">Full Name *</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        placeholder="Your full name"
        autocomplete="name"
      />
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="phone">Phone *</label>
        <input
          type="tel"
          id="phone"
          name="phone"
          required
          placeholder="+964 7XX XXX XXXX"
          autocomplete="tel"
          pattern="[0-9\s\-\+]+"
        />
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="your@email.com"
          autocomplete="email"
        />
      </div>
    </div>

    <div class="form-group">
      <label for="service">Service Interest</label>
      <select id="service" name="service" autocomplete="off">
        <option value="">Select a service...</option>
        <option value="neurology">Neurology & Neurosurgery</option>
        <option value="chiropractic">Chiropractic</option>
        <option value="pain-management">Pain Management</option>
        <option value="brain-stimulation">Brain Stimulation (TMS/tDCS)</option>
        <option value="physiotherapy">Physiotherapy & Rehabilitation</option>
        <option value="radiofrequency">Radiofrequency</option>
        <option value="steroid-injection">Steroid Injections</option>
        <option value="ozone-therapy">Ozone Therapy</option>
        <option value="other">Other</option>
      </select>
    </div>

    <div class="form-group">
      <label for="message">Message</label>
      <textarea
        id="message"
        name="message"
        placeholder="Tell us about your condition or inquiry..."
        rows="4"
      ></textarea>
    </div>

    <div class="form-notice">
      <small>* Required fields. We answer during clinic hours (9 AM – 6 PM, Saturday–Thursday; 2–6 PM Friday)</small>
    </div>

    <button type="submit" class="btn btn-primary">Send Inquiry</button>

    <div id="form-message" class="form-message" role="status" aria-live="polite" aria-atomic="true"></div>
  </form>
</section>

<script>
  // Contact form submission handler
  (function () {
    const form = document.getElementById("contact-form");
    const messageEl = document.getElementById("form-message");
    if (!form) return;

    form.addEventListener("submit", async function (e) {
      e.preventDefault();

      const submitBtn = form.querySelector("button[type='submit']");
      const originalText = submitBtn?.textContent || "Send Inquiry";

      try {
        submitBtn && (submitBtn.disabled = true);
        submitBtn && (submitBtn.textContent = "Sending...");
        messageEl && (messageEl.textContent = "");
        messageEl && messageEl.classList.remove("error", "success");

        const formData = new FormData(form);
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            name: formData.get("name"),
            phone: formData.get("phone"),
            email: formData.get("email") || undefined,
            service: formData.get("service") || undefined,
            message: formData.get("message") || undefined,
          }),
        });

        const data = await response.json();

        if (response.ok) {
          messageEl && messageEl.classList.add("success");
          messageEl && (messageEl.textContent = data.message || "Thank you! We'll be in touch soon.");
          form.reset();
        } else {
          messageEl && messageEl.classList.add("error");
          messageEl && (messageEl.textContent = data.error || "An error occurred. Please try calling us instead.");
        }
      } catch (err: any) {
        messageEl && messageEl.classList.add("error");
        messageEl && (messageEl.textContent = "Network error. Please try calling us: +964-780-1926-801");
      } finally {
        submitBtn && (submitBtn.disabled = false);
        submitBtn && (submitBtn.textContent = originalText);
      }
    });
  })();
</script>

<style>
  .contact-form-section {
    padding: 2rem 1.5rem;
    background: var(--surface-alt);
    border-radius: var(--radius-lg);
    margin: 2rem 0;
  }

  @media (min-width: 640px) {
    .contact-form-section {
      padding: 2.5rem;
    }
  }

  .form-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .form-header h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .form-header p {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .contact-form {
    max-width: 600px;
    margin: 0 auto;
  }

  .form-group {
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;

    @media (max-width: 480px) {
      grid-template-columns: 1fr;
    }
  }

  label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.95rem;
  }

  input,
  textarea,
  select {
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--surface);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  input:focus,
  textarea:focus,
  select:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-soft);
  }

  textarea {
    resize: vertical;
  }

  .form-notice {
    color: var(--ink-muted);
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .btn {
    padding: 0.75em 1.5em;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .btn-primary {
    background: var(--brand);
    color: white;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--brand);
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .form-message {
    margin-top: 1rem;
    padding: 0.75rem;
    border-radius: var(--radius);
    text-align: center;
    display: none;
  }

  .form-message.success {
    display: block;
    background: #e8f5e9;
    color: #2e7d32;
    border: 1px solid #4caf50;
  }

  .form-message.error {
    display: block;
    background: #ffebee;
    color: #c62828;
    border: 1px solid #f44336;
  }
</style>
