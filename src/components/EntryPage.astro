---
/**
 * Content-entry page body (breadcrumb + heading + article prose).
 * Renders the inner shell only — callers wrap in <BaseLayout> themselves.
 *
 * Previously wrapped via ContentLayout (which pulled in BaseLayout), which
 * meant AR fallback routes that already wrapped in BaseLayout ended up with
 * BaseLayout nested inside BaseLayout → duplicate <header>, <body>, etc.
 */
import { render } from "astro:content";
import SchemaScript from "./SchemaScript.astro";

interface Props {
  entry: any;
  backHref?: string;
  backLabel?: string;
}

const { entry, backHref, backLabel } = Astro.props;
const { Content } = await render(entry);
const category = entry.data.category;

// MedicalWebPage schema for treatment/service pages
const medicalSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: entry.data.title,
  description: entry.data.description || entry.data.title,
  datePublished: entry.data.published || new Date().toISOString(),
  dateModified: entry.data.updated?.toISOString() || new Date().toISOString(),
  mainContentOfPage: {
    "@type": "WebPageElement",
    name: entry.data.title,
  },
  author: {
    "@type": "MedicalOrganization",
    name: "Alimran Medical Center",
    url: "https://alimran.clinic",
  },
  reviewedBy: entry.data.reviewedBy ? {
    "@type": "Physician",
    name: entry.data.reviewedBy,
  } : undefined,
};

// FAQ schema if faqItems exist
const faqSchema = entry.data.faqItems?.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: entry.data.faqItems.map((item: any) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
} : null;

// Remove undefined values
Object.keys(medicalSchema).forEach(
  (key) => medicalSchema[key] === undefined && delete medicalSchema[key]
);
---

<div class="content-page">
  {(backHref || category) && (
    <div class="breadcrumb container">
      {backHref && backLabel && <a href={backHref} class="breadcrumb-link">← {backLabel}</a>}
      {category && !backHref && <span class="crumb-category">{category}</span>}
    </div>
  )}

  <header class="page-header container">
    <h1>{entry.data.title}</h1>
    {entry.data.description && <p class="lede">{entry.data.description}</p>}
  </header>

  <article class="container">
    <div class="prose">
      <Content />
    </div>
  </article>
</div>

<SchemaScript schema={medicalSchema} />
{faqSchema && <SchemaScript schema={faqSchema} />}

<style>
  .content-page { padding-block: 1.25rem 2.5rem; }
  @media (min-width: 640px) { .content-page { padding-block: 2rem 4rem; } }
  .breadcrumb { font-size: 0.85rem; color: var(--ink-muted); margin-bottom: 0.75rem; }
  .breadcrumb-link { color: var(--ink-soft); }
  .crumb-category { text-transform: uppercase; letter-spacing: 0.06em; }
  .page-header { margin-bottom: 1.25rem; text-align: center; }
  .page-header h1 { margin-bottom: 0.35em; }
  .lede { color: var(--ink-soft); font-size: clamp(0.95rem, 2.6vw, 1.1rem); max-width: 60ch; margin: 0 auto; }
  @media (min-width: 640px) { .page-header { margin-bottom: 2rem; } }
</style>
