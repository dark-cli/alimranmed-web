---
import { CONTACT } from "../consts";
import { currentLocale, dictFor } from "../lib/i18n";

const locale = currentLocale(Astro);
const dict = dictFor(locale);
const year = new Date().getFullYear();

const brandTitle = locale === "ar" ? "مركز العمران الطبي" : "Alimran Medical Center";
const brandDesc = locale === "ar"
  ? "أمراض الأعصاب والاضطرابات العضلية الهيكلية — البصرة، العراق."
  : "Neurology & Musculoskeletal Disorders — Basra, Iraq.";

const socialLinks = [
  { icon: "fa-facebook-f", label: "Facebook", url: CONTACT.social.facebook },
  { icon: "fa-instagram", label: "Instagram", url: CONTACT.social.instagram },
  { icon: "fa-youtube", label: "YouTube", url: CONTACT.social.youtube },
  { icon: "fa-telegram", label: "Telegram", url: CONTACT.social.telegram },
  { icon: "fa-tiktok", label: "TikTok", url: CONTACT.social.tiktok },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <h3>{brandTitle}</h3>
      <p>{brandDesc}</p>
    </div>

    <div>
      <h4>{dict["footer.contactUs"]}</h4>
      <ul class="footer-list">
        {CONTACT.phones.map((p) => (
          <li><a href={`tel:${p.replace(/\s/g, "")}`}>{p}</a></li>
        ))}
        <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
      </ul>
    </div>

    <div>
      <h4>{dict["footer.locations"]}</h4>
      <ul class="footer-list">
        {CONTACT.addresses.map((addr) => (
          <li>{addr}</li>
        ))}
      </ul>
    </div>

    <div>
      <h4>{dict["footer.followUs"]}</h4>
      <ul class="footer-list social">
        {socialLinks.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener" title={link.label} aria-label={link.label}>
              <i class={`fa-brands ${link.icon}`}></i>
              <span class="sr-only">{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="footer-bottom container">
    <span>&copy; {year} {dict["footer.copyright"]}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: 3rem 0 1rem;
    color: var(--ink-soft);
    margin-top: 4rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }
  .footer-brand h3 { color: var(--brand); margin-bottom: 0.3em; font-size: 1.15rem; }
  .footer-grid h4 {
    color: var(--ink);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }
  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9rem;
  }
  .footer-list a { color: var(--ink-soft); }
  .footer-list a:hover { color: var(--brand); }
  .footer-list.social {
    flex-direction: row;
    gap: 1rem;
  }
  .footer-list.social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--brand-soft);
    transition: all 0.3s ease;
    font-size: 1rem;
  }
  .footer-list.social a:hover {
    background: var(--brand);
    color: white;
    transform: translateY(-2px);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  .footer-bottom {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--ink-muted);
  }
</style>
