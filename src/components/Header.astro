---
/**
 * Header — Alimran Clinic (redesigned Sep 2026).
 *
 * Layout (HANDOFF §4):
 *   Masthead (Alimran Clinic + subheading, vertical accent rule)
 *   Nav (3 items only): Home · Consultant CV · Conditions & Procedures
 *   Language toggle (عربي / English)
 *   Call the secretary — primary button
 *
 * Mobile (< 860px): burger opens the same links as a drawer.
 * No dark-mode toggle. No mega-menu. No dropdowns.
 */
import { CONTACT } from "../consts";
import { currentLocale, dictFor, localizedHref, alternateHref, byLocale, LOCALES, LOCALE_LABELS } from "../lib/i18n";

const locale = currentLocale(Astro);
const t = dictFor(locale);
const currentPath = Astro.url.pathname;

// Localised href helper
const L = (href: string) => localizedHref(href, locale);

// Nav items. Library replaces Blog because it's the superset: blog posts,
// conditions, procedures and cases all live there under a single type filter.
// /blog/ still resolves for direct URLs and search-crawler continuity.
type NavItem = { label: string; labelAr: string; labelTr: string; href: string };
const NAV: NavItem[] = [
  { label: "Home",                    labelAr: "الرئيسية",     labelTr: "Ana Sayfa",       href: "/" },
  { label: "Consultant CV",           labelAr: "السيرة العلمية", labelTr: "Konsültan Özgeçmişi", href: "/doctors/hussein-imran-mousa/" },
  { label: "Conditions & Procedures", labelAr: "ما نعالج",      labelTr: "Hastalıklar ve Girişimler", href: "/conditions/" },
  { label: "Library",                 labelAr: "المكتبة",       labelTr: "Kütüphane",       href: "/library/" },
];

const navLabel = (item: NavItem) => byLocale(locale, { en: item.label, ar: item.labelAr, tr: item.labelTr });
const isActive = (href: string) => {
  const target = L(href);
  if (href === "/") return currentPath === target;
  return currentPath === target || currentPath.startsWith(target);
};

// Language toggle target (path swap only — content mirroring)
const otherLocales = LOCALES.filter((l) => l !== locale).map((l) => ({
  code: l,
  label: LOCALE_LABELS[l],
  href: alternateHref(currentPath, l),
}));

// Primary call number (dial the first configured number)
const callHref = `tel:${CONTACT.phones[0].replace(/\s/g, "")}`;

// Masthead copy — matches the design spec, not a page title.
const brand = byLocale(locale, { en: "Alimran Clinic", ar: "مركز العمران الطبي", tr: "Alimran Kliniği" });
const brandSub = byLocale(locale, {
  en: "Neurosurgery & Pain Medicine · Basra",
  ar: "جراحة الأعصاب وطب الألم — البصرة",
  tr: "Beyin Cerrahisi ve Ağrı Tıbbı · Basra",
});

// Call button label
const callLabel = byLocale(locale, { en: "Call the secretary", ar: "اتصل بالسكرتير", tr: "Sekreteri arayın" });
const menuLabel = byLocale(locale, { en: "Menu", ar: "القائمة", tr: "Menü" });
const closeMenuLabel = byLocale(locale, { en: "Close", ar: "إغلاق", tr: "Kapat" });
const searchLabel = byLocale(locale, { en: "Search", ar: "بحث", tr: "Ara" });
const langLabel = byLocale(locale, { en: "Language", ar: "اللغة", tr: "Dil" });
---

<header class="site-header">
  <div class="container header-row">
    <!-- Masthead: vertical accent rule + name + subheading -->
    <a class="masthead" href={L("/")} aria-label={brand}>
      <span class="masthead-rule" aria-hidden="true"></span>
      <span class="masthead-text">
        <span class="masthead-name">{brand}</span>
        <span class="masthead-sub">{brandSub}</span>
      </span>
    </a>

    <!-- Desktop nav (≥ 860px). Mobile uses the drawer below. -->
    <nav class="primary-nav" aria-label="Primary">
      {NAV.map((item) => (
        <a
          class:list={["nav-link", { active: isActive(item.href) }]}
          href={L(item.href)}
        >
          {navLabel(item)}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button
        id="search-toggle"
        class="search-btn"
        type="button"
        aria-label={searchLabel}
        title={searchLabel}
        aria-expanded="false"
        aria-controls="search-panel"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <path d="m20 20-3.5-3.5"/>
        </svg>
      </button>
      <button
        id="theme-toggle"
        class="theme-btn"
        type="button"
        aria-label={byLocale(locale, { en: "Toggle dark mode", ar: "تبديل الوضع الداكن", tr: "Karanlık modu değiştir" })}
        title={byLocale(locale, { en: "Dark mode", ar: "الوضع الداكن", tr: "Karanlık mod" })}
      >
        <!-- Moon icon (shown in light mode → click for dark) -->
        <svg class="theme-icon moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <!-- Sun icon (shown in dark mode → click for light) -->
        <svg class="theme-icon sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
      </button>
      <details class="lang-menu">
        <summary class="lang-switch" aria-label={langLabel} title={langLabel}>
          {LOCALE_LABELS[locale]}
          <svg viewBox="0 0 10 6" width="9" height="6" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M1 1l4 4 4-4"/></svg>
        </summary>
        <ul class="lang-list">
          {otherLocales.map((o) => (
            <li><a href={o.href} hreflang={o.code} lang={o.code}>{o.label}</a></li>
          ))}
        </ul>
      </details>
      <a class="btn btn-primary btn-sm call-btn" href={callHref}>
        {callLabel}
      </a>
      <button
        id="menu-toggle"
        class="menu-btn"
        aria-label={menuLabel}
        aria-expanded="false"
        aria-controls="mobile-nav"
        type="button"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Search overlay — opened by the header search button, fixed-positioned
     under the header. Fetches /search-index.json on first open and filters
     client-side. Grouped results (Conditions / Procedures / Articles / …). -->
<div id="search-panel" class="search-panel" role="dialog" aria-modal="false" aria-label={searchLabel} hidden>
  <div class="search-wrap">
    <div class="search-input-row">
      <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/>
        <path d="m20 20-3.5-3.5"/>
      </svg>
      <input
        id="search-input"
        type="search"
        class="search-input"
        autocomplete="off"
        spellcheck="false"
        placeholder={byLocale(locale, { en: "Search conditions, procedures, articles…", ar: "ابحث في الحالات، الإجراءات، المقالات…", tr: "Hastalık, girişim ve makale ara…" })}
        aria-label={byLocale(locale, { en: "Search query", ar: "استعلام البحث", tr: "Arama sorgusu" })}
        aria-controls="search-results"
      />
      <kbd class="search-kbd" aria-hidden="true">Esc</kbd>
    </div>
    <div id="search-results" class="search-results" role="listbox" aria-label={byLocale(locale, { en: "Search results", ar: "نتائج البحث", tr: "Arama sonuçları" })}>
      <p class="search-hint">{byLocale(locale, { en: "Start typing to search across every page on the site.", ar: "ابدأ الكتابة للبحث في جميع صفحات الموقع.", tr: "Sitedeki tüm sayfalarda arama yapmak için yazmaya başlayın." })}</p>
    </div>
  </div>
</div>
<div id="search-scrim" class="search-scrim" aria-hidden="true"></div>

<!-- Mobile drawer (< 860px). Same NAV links; kept outside .site-header so its
     fixed positioning is relative to the viewport, not the sticky header. -->
<aside id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" aria-hidden="true" inert>
  <div class="drawer-head">
    <span class="eyebrow">{menuLabel}</span>
    <button id="menu-close" class="close-btn" aria-label={closeMenuLabel} type="button">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="18" y1="6" x2="6" y2="18" />
      </svg>
    </button>
  </div>
  <ul class="drawer-list">
    {NAV.map((item) => (
      <li>
        <a class="drawer-link" href={L(item.href)}>
          {navLabel(item)}
        </a>
      </li>
    ))}
    <li class="drawer-sep" aria-hidden="true"></li>
    {otherLocales.map((o) => (
      <li>
        <a class="drawer-link drawer-lang" href={o.href} hreflang={o.code} lang={o.code}>{o.label}</a>
      </li>
    ))}
  </ul>
  <a class="btn btn-primary drawer-call" href={callHref}>{callLabel}</a>
</aside>
<div id="menu-scrim" class="menu-scrim" aria-hidden="true"></div>

<script is:inline>
  /**
   * Mobile drawer wiring — View-Transitions aware.
   * Element listeners rebind after every astro:page-load swap.
   * Document listeners (Escape, page-load close) attach once per session.
   */
  (function () {
    function bindElementListeners() {
      var toggle = document.getElementById("menu-toggle");
      var close  = document.getElementById("menu-close");
      var nav    = document.getElementById("mobile-nav");
      var scrim  = document.getElementById("menu-scrim");
      if (!toggle || !nav || !scrim) return;

      toggle.addEventListener("click", function () { setOpen(true); });
      close && close.addEventListener("click", function () { setOpen(false); });
      scrim.addEventListener("click", function () { setOpen(false); });
      nav.querySelectorAll("a").forEach(function (a) {
        a.addEventListener("click", function () { setOpen(false); });
      });
    }

    function setOpen(open) {
      var nav = document.getElementById("mobile-nav");
      var scrim = document.getElementById("menu-scrim");
      var toggle = document.getElementById("menu-toggle");
      if (!nav || !scrim) return;
      nav.classList.toggle("open", open);
      scrim.classList.toggle("visible", open);
      document.body.classList.toggle("nav-open", open);
      nav.setAttribute("aria-hidden", String(!open));
      // `inert` takes focusable descendants out of the tab order while the
      // drawer is off-screen — the accessibility fix Lighthouse flags when
      // aria-hidden alone is set on a container of buttons/links.
      if (open) nav.removeAttribute("inert"); else nav.setAttribute("inert", "");
      if (toggle) toggle.setAttribute("aria-expanded", String(open));
    }

    if (!window.__navGlobalsBound) {
      window.__navGlobalsBound = true;
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") setOpen(false);
      });
      document.addEventListener("astro:before-swap", function () { setOpen(false); });
    }

    bindElementListeners();
    document.addEventListener("astro:page-load", bindElementListeners);
  })();

  /**
   * Theme toggle — persists to localStorage, syncs across tabs,
   * survives Astro View Transitions. Initial theme is applied by
   * the anti-FOUC script in BaseHead before paint.
   */
  (function () {
    function bindThemeToggle() {
      var btn = document.getElementById("theme-toggle");
      if (!btn || btn.__bound) return;
      btn.__bound = true;
      btn.addEventListener("click", function () {
        var current = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
        var next = current === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        try { localStorage.setItem("theme", next); } catch (e) {}
      });
    }
    bindThemeToggle();
    document.addEventListener("astro:page-load", bindThemeToggle);
  })();

  /**
   * Site-wide search — top-bar overlay.
   * Fetches /search-index.json on first open, caches on window.
   * Client-side scoring: title starts-with > title contains > desc contains.
   * Groups results by type (Conditions / Procedures / Articles / …).
   * Filters to current locale (based on the path prefix).
   */
  (function () {
    var GROUP_LABELS_EN = {
      treatment: "Conditions",
      service:   "Procedures & therapies",
      blog:      "Articles",
      case:      "Case studies",
      doctor:    "Doctors",
      static:    "Pages",
    };
    var GROUP_LABELS_AR = {
      treatment: "الحالات",
      service:   "الإجراءات والعلاجات",
      blog:      "المقالات",
      case:      "دراسات الحالة",
      doctor:    "الأطباء",
      static:    "الصفحات",
    };
    var GROUP_LABELS_TR = {
      treatment: "Hastalıklar",
      service:   "Girişimler ve tedaviler",
      blog:      "Makaleler",
      case:      "Vaka çalışmaları",
      doctor:    "Doktorlar",
      static:    "Sayfalar",
    };
    // Per-hit badge — the shorter singular label shown next to each result title.
    var BADGE_EN = {
      treatment: "Condition",
      service:   "Procedure",
      blog:      "Article",
      case:      "Case study",
      doctor:    "Doctor",
      static:    "Page",
    };
    var BADGE_AR = {
      treatment: "حالة",
      service:   "إجراء",
      blog:      "مقال",
      case:      "دراسة",
      doctor:    "طبيب",
      static:    "صفحة",
    };
    var BADGE_TR = {
      treatment: "Hastalık",
      service:   "Girişim",
      blog:      "Makale",
      case:      "Vaka",
      doctor:    "Doktor",
      static:    "Sayfa",
    };
    var LABELS = { en: GROUP_LABELS_EN, ar: GROUP_LABELS_AR, tr: GROUP_LABELS_TR };
    var BADGES = { en: BADGE_EN, ar: BADGE_AR, tr: BADGE_TR };
    var EMPTY = { en: "No results.", ar: "لا توجد نتائج.", tr: "Sonuç bulunamadı." };
    var GROUP_ORDER = ["treatment", "service", "blog", "case", "doctor", "static"];
    var PER_GROUP = 5;

    function currentLocale() {
      var l = document.documentElement.getAttribute("lang");
      return l === "ar" || l === "tr" ? l : "en";
    }

    function loadIndex() {
      if (window.__searchIndex) return Promise.resolve(window.__searchIndex);
      if (window.__searchIndexPromise) return window.__searchIndexPromise;
      window.__searchIndexPromise = fetch("/search-index.json")
        .then(function (r) { return r.json(); })
        .then(function (d) { window.__searchIndex = d.entries || []; return window.__searchIndex; })
        .catch(function () { return []; });
      return window.__searchIndexPromise;
    }

    function score(entry, q) {
      var t = (entry.title || "").toLowerCase();
      var d = (entry.description || "").toLowerCase();
      if (!t && !d) return 0;
      if (t === q) return 100;
      if (t.indexOf(q) === 0) return 80;
      if (t.indexOf(" " + q) !== -1) return 60;
      if (t.indexOf(q) !== -1) return 40;
      if (d.indexOf(q) !== -1) return 20;
      return 0;
    }

    function esc(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c];
      });
    }

    function render(results, container, labels, badges, emptyText) {
      if (!results.length) {
        container.innerHTML = '<p class="search-empty">' + esc(emptyText) + "</p>";
        return;
      }
      var byType = {};
      for (var i = 0; i < results.length; i++) {
        var r = results[i];
        (byType[r.type] = byType[r.type] || []).push(r);
      }
      var html = "";
      for (var j = 0; j < GROUP_ORDER.length; j++) {
        var key = GROUP_ORDER[j];
        var items = byType[key];
        if (!items || !items.length) continue;
        html += '<section class="search-group"><p class="search-group-label">' + esc(labels[key] || key) + "</p>";
        var shown = items.slice(0, PER_GROUP);
        for (var k = 0; k < shown.length; k++) {
          var it = shown[k];
          html += '<a class="search-hit" href="' + esc(it.href) + '" role="option">'
                + '<div class="search-hit-head">'
                +   '<h4 class="search-hit-title">' + esc(it.title) + "</h4>"
                +   '<span class="search-hit-badge search-hit-badge-' + esc(it.type) + '">' + esc(badges[key] || key) + "</span>"
                + "</div>"
                + (it.description ? '<p class="search-hit-desc">' + esc(it.description) + "</p>" : "")
                + '<p class="search-hit-path">' + esc(it.href.replace(/^\//, "").replace(/\/$/, "").split("/").join(" › ")) + "</p>"
                + "</a>";
        }
        html += "</section>";
      }
      container.innerHTML = html;
    }

    function filterIndex(index, q, locale) {
      q = q.trim().toLowerCase();
      if (!q) return [];
      var out = [];
      for (var i = 0; i < index.length; i++) {
        var e = index[i];
        if (e.locale !== locale) continue;
        var s = score(e, q);
        if (s > 0) out.push({ e: e, s: s });
      }
      out.sort(function (a, b) { return b.s - a.s; });
      // Bring redesigned/curated ordering: return raw entries
      return out.slice(0, 50).map(function (x) { return x.e; });
    }

    var searchOpen = false;
    var activeIndex = -1;

    function setSearchOpen(open) {
      var panel = document.getElementById("search-panel");
      var scrim = document.getElementById("search-scrim");
      var toggle = document.getElementById("search-toggle");
      var input = document.getElementById("search-input");
      if (!panel || !scrim || !input) return;
      searchOpen = open;
      if (open) {
        panel.hidden = false;
        scrim.classList.add("visible");
        if (toggle) toggle.setAttribute("aria-expanded", "true");
        document.body.classList.add("search-open");
        loadIndex(); // prime the cache
        setTimeout(function () { input.focus(); input.select(); }, 20);
      } else {
        panel.hidden = true;
        scrim.classList.remove("visible");
        if (toggle) toggle.setAttribute("aria-expanded", "false");
        document.body.classList.remove("search-open");
        activeIndex = -1;
      }
    }

    function bindSearchListeners() {
      var toggle = document.getElementById("search-toggle");
      var input  = document.getElementById("search-input");
      var results = document.getElementById("search-results");
      var scrim = document.getElementById("search-scrim");
      if (!toggle || !input || !results || !scrim) return;

      if (!toggle.__bound) {
        toggle.__bound = true;
        toggle.addEventListener("click", function () { setSearchOpen(!searchOpen); });
      }
      if (!scrim.__searchBound) {
        scrim.__searchBound = true;
        scrim.addEventListener("click", function () { setSearchOpen(false); });
      }
      if (!input.__bound) {
        input.__bound = true;
        var locale = currentLocale();
        var hintHtml = results.innerHTML; // preserve the initial hint

        input.addEventListener("input", function () {
          var q = input.value;
          if (!q.trim()) { results.innerHTML = hintHtml; activeIndex = -1; return; }
          loadIndex().then(function (index) {
            var loc = currentLocale();
            var hits = filterIndex(index, q, loc);
            render(hits, results, LABELS[loc], BADGES[loc], EMPTY[loc]);
            activeIndex = -1;
          });
        });

        input.addEventListener("keydown", function (e) {
          if (e.key === "Escape") { setSearchOpen(false); return; }
          var hits = results.querySelectorAll(".search-hit");
          if (!hits.length) return;
          if (e.key === "ArrowDown") {
            e.preventDefault();
            activeIndex = Math.min(hits.length - 1, activeIndex + 1);
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            activeIndex = Math.max(0, activeIndex - 1);
          } else if (e.key === "Enter" && activeIndex >= 0) {
            e.preventDefault();
            var href = hits[activeIndex].getAttribute("href");
            if (href) window.location.href = href;
            return;
          } else if (e.key === "Enter" && hits.length) {
            e.preventDefault();
            var href2 = hits[0].getAttribute("href");
            if (href2) window.location.href = href2;
            return;
          } else {
            return;
          }
          for (var i = 0; i < hits.length; i++) hits[i].classList.remove("active");
          hits[activeIndex].classList.add("active");
          hits[activeIndex].scrollIntoView({ block: "nearest" });
        });
      }
    }

    if (!window.__searchGlobalsBound) {
      window.__searchGlobalsBound = true;
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && searchOpen) setSearchOpen(false);
        // Cmd/Ctrl-K opens search from any page
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          setSearchOpen(true);
        }
      });
      document.addEventListener("astro:before-swap", function () { setSearchOpen(false); });
    }

    bindSearchListeners();
    document.addEventListener("astro:page-load", bindSearchListeners);
  })();
</script>

<style>
  /* ─── Header shell ────────────────────────────────────────── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    /* Slight translucency + blur only when backdrop-filter is supported.
       Falls back to the flat token so dark mode still reads correctly. */
    background: color-mix(in srgb, var(--white) 96%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: var(--header-h);
    padding-block: 12px;
  }

  /* ─── Masthead ────────────────────────────────────────────── */
  .masthead {
    display: inline-flex;
    align-items: stretch;
    gap: 12px;
    color: var(--ink);
    text-decoration: none;
    /* Allow the masthead to shrink if the header row runs tight — the
       actions on the right (عربي, call, burger) are the priority items. */
    min-width: 0;
    padding-block: 4px;
  }
  .masthead:hover { text-decoration: none; color: var(--ink); }
  .masthead-rule {
    width: 3px;
    background: var(--accent);
    flex-shrink: 0;
  }
  .masthead-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-width: 0;
  }
  .masthead-name {
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1.1;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
.masthead-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.3;
  }
  /* On very narrow phones the long EN subheading overflows the header row.
     Drop it below 460px — the brand name alone still identifies the clinic
     and matches what iOS-style headers do at phone widths. */
  @media (max-width: 459px) {
    .masthead-sub { display: none; }
  }
/* ─── Desktop nav (≥ 860px) ───────────────────────────────── */
  .primary-nav {
    display: none;
    align-items: center;
    gap: 4px;
    margin-inline-start: auto;
  }
  .nav-link {
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--body);
    text-decoration: none;
    border-radius: 2px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
.nav-link:hover { color: var(--accent); text-decoration: none; background: var(--surface); }
  .nav-link.active { color: var(--accent); }

  /* ─── Header actions (right side) ─────────────────────────── */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-inline-start: auto;
  }
  @media (min-width: 860px) {
    .header-actions { margin-inline-start: 0; }
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    font-size: 13px;
    color: var(--body);
    text-decoration: none;
    /* Always-visible hairline box — matches the prototype (Alimran
       Neurosurgery.dc.html line 39). Older impl had it on :hover only. */
    border: 1px solid var(--line);
    border-radius: 2px;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .lang-switch:hover { color: var(--accent); text-decoration: none; border-color: var(--accent); }
  /* Mobile: comfortable 48px tap target */
  @media (max-width: 859px) {
    .lang-switch { min-height: 48px; padding: 0 14px; }
  }
  /* Language dropdown (<details>) — native, no JS. */
  .lang-menu { position: relative; }
  .lang-menu > summary { list-style: none; cursor: pointer; gap: 6px; }
  .lang-menu > summary::-webkit-details-marker { display: none; }
  .lang-menu[open] > summary { color: var(--accent); border-color: var(--accent); }
  .lang-list {
    position: absolute;
    inset-block-start: calc(100% + 4px);
    inset-inline-end: 0;
    min-width: 100%;
    margin: 0;
    padding: 4px 0;
    list-style: none;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 2px;
    z-index: 60;
  }
  .lang-list a {
    display: block;
    padding: 8px 14px;
    font-size: 13px;
    color: var(--body);
    text-decoration: none;
    white-space: nowrap;
  }
  .lang-list a:hover { color: var(--accent); text-decoration: none; }
  /* Mobile: the drawer lists the languages instead. */
  @media (max-width: 859px) {
    .lang-menu { display: none; }
  }

  /* ─── Search button (opens overlay) ───────────────────────── */
  .search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--body);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .search-btn:hover { color: var(--accent); border-color: var(--accent); }
  .search-btn[aria-expanded="true"] { color: var(--accent); border-color: var(--accent); }

  /* ─── Theme toggle (dark mode) ────────────────────────────── */
  .theme-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    color: var(--body);
    border: 1px solid var(--line);
    border-radius: 2px;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .theme-btn:hover { color: var(--accent); border-color: var(--accent); }
  @media (max-width: 859px) {
    .theme-btn { width: 44px; height: 44px; }
  }
  /* Icon-swap between .moon and .sun lives in global.css because Astro
     strips the `html[data-theme="…"]` prefix from scoped styles (same
     issue as html[dir="rtl"]). */

  /* Hide the "Call the secretary" pill on tight screens; the drawer has one. */
  .call-btn { display: none; }
  @media (min-width: 640px) {
    .call-btn { display: inline-flex; }
  }

  /* ─── Burger button ───────────────────────────────────────── */
  .menu-btn {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 12px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 2px;
    cursor: pointer;
  }
  .menu-btn span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--ink);
  }
  .menu-btn:hover { border-color: var(--accent); }

  @media (min-width: 860px) {
    .primary-nav { display: inline-flex; }
    .menu-btn { display: none; }
  }

  /* ─── Mobile drawer ───────────────────────────────────────── */
  .mobile-nav {
    position: fixed;
    top: 0; bottom: 0;
    inset-inline-end: 0;
    width: min(320px, 82vw);
    background: var(--white);
    border-inline-start: 1px solid var(--line);
    z-index: 90;
    display: flex;
    flex-direction: column;
    padding: 20px;
    gap: 8px;
    transform: translateX(100%);
    transition: transform 0.25s ease-out;
  }
.mobile-nav.open { transform: translateX(0); }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 8px;
  }
  .close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--ink);
  }
  .close-btn:hover { border-color: var(--accent); color: var(--accent); }

  .drawer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }
  .drawer-link {
    display: block;
    padding: 16px 4px;
    min-height: 56px;
    font-size: 17px;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line-soft);
  }
  .drawer-link:hover { color: var(--accent); text-decoration: none; }
  .drawer-lang { color: var(--body); font-size: 15px; }
  .drawer-sep { flex: 1 1 auto; min-height: 12px; }
  .drawer-call {
    width: 100%;
    margin-top: 8px;
  }

  .menu-scrim {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--footer-bg) 40%, transparent);
    z-index: 80;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  .menu-scrim.visible { opacity: 1; visibility: visible; }
  :global(body.nav-open) { overflow: hidden; }

  /* ─── Search overlay ──────────────────────────────────────── */
  .search-panel {
    position: fixed;
    top: var(--header-h);
    left: 0;
    right: 0;
    z-index: 60;
    background: var(--white);
    border-bottom: 1px solid var(--line);
    max-height: calc(100vh - var(--header-h));
    overflow-y: auto;
  }
  .search-panel[hidden] { display: none; }
  .search-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(16px, 2.5vw, 24px);
  }
  .search-input-row {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 10px;
    margin-bottom: 16px;
  }
  .search-icon { color: var(--muted); flex-shrink: 0; }
  .search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    outline: none;
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--ink);
    padding: 4px 0;
  }
  .search-input::placeholder { color: var(--muted); }
  .search-input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }
  .search-kbd {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    padding: 3px 7px;
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--muted);
    background: var(--surface);
  }
  @media (max-width: 460px) { .search-kbd { display: none; } }

  .search-results { min-height: 60px; }
  .search-hint {
    font-size: 14px;
    color: var(--muted);
    margin: 8px 0 0;
    text-align: center;
    padding: 24px 0;
  }
  .search-scrim {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: 55;
    background: rgba(16, 28, 34, 0.35);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, visibility 0.15s ease;
  }
  .search-scrim.visible { opacity: 1; visibility: visible; }
</style>

<!--
  Search result markup is injected at runtime via innerHTML, which means
  Astro's scoped [data-astro-cid-…] attributes are never applied to it and
  scoped styles silently fail. These rules live in a global block so they
  actually hit the dynamic nodes.
-->
<style is:global>
  .search-group {
    margin-bottom: 32px;
  }
  .search-group:last-child { margin-bottom: 0; }
  .search-group-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 10px;
    padding: 0 0 8px;
    border-bottom: 1px solid var(--ink);
  }
  html[dir="rtl"] .search-group-label {
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 12px;
  }

  /* Each result is its own bordered card with real breathing room between
     cards so titles never blur into the next result. */
  .search-hit {
    display: block;
    padding: 16px 16px 14px;
    text-decoration: none;
    border: 1px solid var(--line);
    background: var(--white);
    margin: 0 0 18px;
  }
  .search-hit:last-child { margin-bottom: 0; }
  .search-hit:hover,
  .search-hit.active {
    background: var(--surface);
    border-color: var(--accent);
    text-decoration: none;
  }
  .search-hit.active { box-shadow: inset 0 0 0 1px var(--accent); }

  .search-hit-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line-soft);
  }
  .search-hit-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: 1.2;
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
  }
  .search-hit:hover .search-hit-title,
  .search-hit.active .search-hit-title { color: var(--accent); }
  html[dir="rtl"] .search-hit-title { font-weight: 700; font-size: 18px; letter-spacing: 0; }

  .search-hit-badge {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 3px 7px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--white);
    white-space: nowrap;
  }
  html[dir="rtl"] .search-hit-badge {
    font-family: var(--font-body); letter-spacing: 0; text-transform: none; font-size: 11px;
  }
  .search-hit-badge-treatment { color: var(--accent); border-color: var(--accent); }
  .search-hit-badge-service   { color: #5a3d8a; border-color: #d7cae8; }
  .search-hit-badge-blog      { color: #7a5a1a; border-color: #ecd9a8; }
  .search-hit-badge-case      { color: #2f6d47; border-color: #bbdec5; }
  .search-hit-badge-doctor    { color: var(--ink); border-color: var(--line-strong); }
  .search-hit-badge-static    { color: var(--muted); border-color: var(--line); }

  .search-hit-desc {
    font-size: 13.5px;
    color: var(--muted);
    margin: 0 0 6px;
    line-height: 1.55;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .search-hit-path {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--muted);
    margin: 0;
    opacity: 0.75;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  html[dir="rtl"] .search-hit-path { font-family: var(--font-body); font-size: 12px; }

  .search-empty {
    font-size: 14px;
    color: var(--muted);
    margin: 0;
    text-align: center;
    padding: 24px 0;
  }
</style>
