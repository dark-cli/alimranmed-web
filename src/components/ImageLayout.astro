---
// Component to handle image layout in prose
---

<script>
  function setupImageLayout() {
    const prose = document.querySelector('.prose');
    if (!prose) return;

    // Get all paragraphs with images
    const imageParagraphs = Array.from(prose.querySelectorAll('p')).filter(p => p.querySelector('img'));

    if (imageParagraphs.length === 0) return;

    // Group consecutive image paragraphs
    const groups: HTMLParagraphElement[][] = [];
    let currentGroup: HTMLParagraphElement[] = [];

    imageParagraphs.forEach((p, index) => {
      currentGroup.push(p);

      // Check if next element is also an image paragraph
      const nextElement = p.nextElementSibling;
      const nextIsImagePara = nextElement &&
                              nextElement.tagName === 'P' &&
                              nextElement.querySelector('img') &&
                              imageParagraphs.includes(nextElement as HTMLParagraphElement);

      if (!nextIsImagePara) {
        if (currentGroup.length > 0) {
          groups.push([...currentGroup]);
        }
        currentGroup = [];
      }
    });

    // Apply layout to each group
    groups.forEach(group => {
      if (group.length === 1) {
        // Single image: center it
        const p = group[0];
        p.style.textAlign = 'center';
        p.style.margin = '1.5rem 0';
        const img = p.querySelector('img') as HTMLImageElement;
        if (img) {
          img.style.maxWidth = '85%';
          img.style.height = 'auto';
          img.style.margin = '0 auto';
          img.style.display = 'inline-block';
        }
      } else if (group.length === 2) {
        // Two images: side by side on desktop
        group.forEach((p, idx) => {
          p.style.textAlign = 'center';
          p.style.display = 'inline-block';
          p.style.width = 'calc(50% - 0.75rem)';
          p.style.margin = '1rem 0.5rem 1rem 0';
          p.style.verticalAlign = 'top';

          if (idx === 1) {
            p.style.margin = '1rem 0 1rem 0.5rem';
          }

          const img = p.querySelector('img') as HTMLImageElement;
          if (img) {
            img.style.maxWidth = '100%';
            img.style.height = 'auto';
            img.style.margin = '0 auto';
            img.style.display = 'inline-block';
          }
        });
      } else {
        // More than 2: pairs on desktop, singles centered
        group.forEach((p, idx) => {
          p.style.textAlign = 'center';

          if (idx % 2 === 1) {
            // Even index (1, 3, 5...) - second of pair
            p.style.display = 'inline-block';
            p.style.width = 'calc(50% - 0.75rem)';
            p.style.margin = '1rem 0 1rem 0.5rem';
            p.style.verticalAlign = 'top';
          } else if (idx < group.length - 1 && group[idx + 1]) {
            // Odd index (0, 2, 4...) - first of pair, but not last
            p.style.display = 'inline-block';
            p.style.width = 'calc(50% - 0.75rem)';
            p.style.margin = '1rem 0.5rem 1rem 0';
            p.style.verticalAlign = 'top';
          } else {
            // Last image if odd number
            p.style.display = 'block';
            p.style.width = '100%';
            p.style.margin = '1.5rem 0';
          }

          const img = p.querySelector('img') as HTMLImageElement;
          if (img) {
            img.style.maxWidth = (idx % 2 === 0 && idx < group.length - 1) ? '100%' : '85%';
            img.style.height = 'auto';
            img.style.margin = '0 auto';
            img.style.display = 'inline-block';
          }
        });
      }
    });
  }

  // Run on page load
  setupImageLayout();

  // Re-run after view transitions
  document.addEventListener('astro:page-load', setupImageLayout);
</script>
