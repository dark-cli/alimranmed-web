---
// Image preview/lightbox functionality
---

<style>
  .image-preview-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.95);
    z-index: 9999;
    overflow: auto;
  }

  .image-preview-modal.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-preview-content {
    position: relative;
    max-width: 90%;
    max-height: 90vh;
  }

  .image-preview-content img {
    max-width: 100%;
    max-height: 90vh;
    display: block;
  }

  .image-preview-close {
    position: absolute;
    top: 20px;
    right: 30px;
    font-size: 40px;
    font-weight: bold;
    color: #fff;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    z-index: 10000;
  }

  .image-preview-close:hover {
    color: #ccc;
  }


  .prose img {
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .prose img:hover {
    opacity: 0.8;
  }
</style>

<div class="image-preview-modal" id="imagePreviewModal">
  <button class="image-preview-close" id="imagePreviewClose">&times;</button>
  <div class="image-preview-content">
    <img id="imagePreviewImg" src="" alt="" />
  </div>
</div>

<script>
  function setupImagePreview() {
    const modal = document.getElementById('imagePreviewModal');
    const modalImg = document.getElementById('imagePreviewImg');
    const closeBtn = document.getElementById('imagePreviewClose');

    // Get all images in prose
    function getProseImages() {
      const prose = document.querySelector('.prose');
      if (!prose) return [];
      return Array.from(prose.querySelectorAll('img')).filter(img => {
        // Exclude very small images (like icons)
        return img.naturalWidth > 100 || img.width > 100;
      });
    }

    function openPreview(img: HTMLImageElement) {
      modalImg.src = img.src;
      modalImg.alt = img.alt;
      modal?.classList.add('active');
    }

    function closePreview() {
      modal?.classList.remove('active');
    }

    // Add click listeners to images
    function attachImageListeners() {
      const proseImages = getProseImages();
      proseImages.forEach((img) => {
        img.style.cursor = 'pointer';
        img.addEventListener('click', (e) => {
          e.stopPropagation();
          openPreview(img);
        });
      });
    }

    // Event listeners
    closeBtn?.addEventListener('click', closePreview);

    // Close on background click
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closePreview();
      }
    });

    // Close with Escape key
    document.addEventListener('keydown', (e) => {
      if (!modal?.classList.contains('active')) return;
      if (e.key === 'Escape') closePreview();
    });

    // Initial setup
    attachImageListeners();

    // Re-attach listeners after view transitions
    document.addEventListener('astro:page-load', () => {
      attachImageListeners();
    });
  }

  // Run on page load
  setupImagePreview();
  document.addEventListener('astro:page-load', setupImagePreview);
</script>
