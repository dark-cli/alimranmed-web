---
import { Image } from "astro:assets";

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}

const {
  src,
  alt,
  width = 1200,
  height = 675,
  sizes = "(max-width: 768px) 100vw, 50vw",
  loading = "lazy",
  fetchpriority = "auto",
  class: className,
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  sizes={sizes}
  loading={loading}
  fetchpriority={fetchpriority}
  class={className}
  style="width: 100%; height: auto; display: block;"
/>
