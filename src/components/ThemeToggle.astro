---
// Small sun/moon theme toggle. Theme is initialized in BaseHead to avoid FOUC.
---

<button class="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
  <i class="icon sun fa-solid fa-sun" aria-hidden="true"></i>
  <i class="icon moon fa-solid fa-moon" aria-hidden="true"></i>
</button>

<script is:inline>
  // Bind on initial load AND after each View Transitions navigation, so a
  // freshly-swapped .theme-toggle button in the header gets its click handler.
  (function () {
    function bindThemeToggles() {
      document.querySelectorAll(".theme-toggle").forEach(function (btn) {
        if (btn.dataset.bound) return;
        btn.dataset.bound = "1";
        btn.addEventListener("click", function () {
          var current = document.documentElement.getAttribute("data-theme");
          var next = current === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
        });
      });
    }
    bindThemeToggles();
    document.addEventListener("astro:page-load", bindThemeToggles);
  })();
</script>

<style>
  .theme-toggle {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    height: 48px;
    width: 48px;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-soft);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .theme-toggle:hover { border-color: var(--brand); }
  .icon { font-size: 1.1rem; line-height: 1; }
  .icon.sun { display: none; color: #f59e0b; }        /* amber-500 — warm sun */
  .icon.moon { display: inline-block; color: var(--brand); } /* teal-blue — matches logo */
  :global(html[data-theme="dark"]) .icon.sun { display: inline-block; }
  :global(html[data-theme="dark"]) .icon.moon { display: none; }
  /* Slight brightness lift on hover instead of tinting brand color */
  .theme-toggle:hover .icon { filter: brightness(1.15); }
</style>
