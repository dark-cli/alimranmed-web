---
/**
 * Shown at the top of a content page when the requested locale doesn't
 * have its own translation and we're falling back to the other language.
 * Keeps the AR site fully navigable while translations are being written.
 */
interface Props {
  fromLocale: "en" | "ar";
  toLocale: "en" | "ar";
}

const { fromLocale, toLocale } = Astro.props;
const message = toLocale === "ar"
  ? "الترجمة العربية لهذه الصفحة قيد الإعداد. المحتوى المعروض بالإنجليزية مؤقتاً."
  : "The Arabic translation of this page is in progress. Showing the English version for now.";
---

<div class="translation-banner" role="status">
  <span class="icon" aria-hidden="true">
    <i class="fa-solid fa-language"></i>
  </span>
  <span class="text">{message}</span>
</div>

<style>
  .translation-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--brand-soft);
    border: 1px solid var(--brand);
    border-radius: var(--radius);
    color: var(--brand-dark);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    max-width: 72ch;
    margin-inline: auto;
  }
  .icon {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--surface);
    color: var(--brand);
    flex-shrink: 0;
  }
  .icon i { font-size: 0.9rem; }
</style>
