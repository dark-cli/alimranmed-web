---
/**
 * Comparison pair — two side-by-side hairline cards (Active vs Latent
 * trigger point, for example). Each card carries a mono accent label, a
 * serif h3 title, and a hairline bullet list.
 */
import SectionHead from "./SectionHead.astro";

interface Side { label: string; title: string; items: string[]; }
interface Props {
  num?: string;
  heading?: string;
  id?: string;
  intro?: string;
  a: Side;
  b: Side;
}
const { num, heading, id, intro, a, b } = Astro.props;
---

<section class="cmp">
  {heading && num && id && <SectionHead num={num} heading={heading} id={id} />}
  {intro && <p class="cmp-intro">{intro}</p>}
  <div class="cmp-grid">
    {[a, b].map((side) => (
      <div class="cmp-cell">
        <p class="cmp-label">{side.label}</p>
        <h3 class="cmp-title">{side.title}</h3>
        <ul class="cmp-list">
          {side.items.map((it) => <li>{it}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .cmp { margin-bottom: clamp(44px, 5.5vw, 64px); }
  .cmp-intro {
    font-size: 17px; line-height: 1.72; color: var(--body);
    margin: 0 0 28px; text-wrap: pretty;
  }
  :global(html[dir="rtl"]) .cmp-intro { line-height: 1.95; }
  .cmp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(255px, 100%), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .cmp-cell { background: var(--white); padding: 26px 24px; }
  .cmp-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 10px;
  }
  :global(html[dir="rtl"]) .cmp-label {
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 12px;
  }
  .cmp-title {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 400;
    margin: 0 0 14px;
    color: var(--ink);
  }
  :global(html[dir="rtl"]) .cmp-title { font-weight: 700; }
  .cmp-list {
    margin: 0; padding: 0; list-style: none;
    display: flex; flex-direction: column; gap: 10px;
  }
  .cmp-list li {
    font-size: 15px;
    line-height: 1.55;
    color: var(--body);
    border-top: 1px solid var(--line-soft);
    padding-top: 10px;
  }
  :global(html[dir="rtl"]) .cmp-list li { line-height: 1.85; }
</style>
