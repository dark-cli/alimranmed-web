---
/**
 * Related — 2–4 clickable "next reading" cards at the bottom of the article.
 * Cards linking to non-redesigned treatments render as greyed non-links.
 */
interface Item {
  slug: string;
  title: string;
  category: string;   // localised label (Pain / Brain / Spine)
  href: string;       // full localised href for redesigned; empty when not
  redesigned: boolean;
}
interface Props {
  items: Item[];
  relatedLabel: string;   // "Related reading" / "قراءة ذات صلة"
  soonLabel: string;      // "Not yet available in the new design"
}
const { items, relatedLabel, soonLabel } = Astro.props;
---

<section class="rel">
  <p class="rel-title">{relatedLabel}</p>
  <div class="rel-grid">
    {items.map((it) => (
      it.redesigned
        ? (
          <a class="rel-card" href={it.href}>
            <p class="rel-cat">{it.category}</p>
            <p class="rel-name">{it.title}</p>
          </a>
        )
        : (
          <span class="rel-card rel-card--soon" title={soonLabel}>
            <p class="rel-cat rel-cat--soon">{it.category}</p>
            <p class="rel-name rel-name--soon">{it.title}</p>
          </span>
        )
    ))}
  </div>
</section>

<style>
  .rel { margin-bottom: clamp(44px, 5.5vw, 64px); }
  .rel-title {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 18px;
  }
  :global(html[dir="rtl"]) .rel-title {
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 12px;
  }
  .rel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .rel-card {
    background: var(--white);
    padding: 20px 22px;
    display: block;
    text-decoration: none;
  }
  .rel-card:hover { background: var(--surface); text-decoration: none; }
  .rel-cat {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 8px;
  }
  :global(html[dir="rtl"]) .rel-cat {
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 12px;
  }
  .rel-name {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 400;
    color: var(--ink);
    margin: 0;
  }
  :global(html[dir="rtl"]) .rel-name { font-weight: 700; }

  /* Greyed-out (not yet redesigned) */
  .rel-card--soon {
    cursor: not-allowed;
    opacity: 0.55;
    filter: grayscale(0.4);
  }
  .rel-card--soon:hover { background: var(--white); }
  .rel-cat--soon { color: var(--muted); }
  .rel-name--soon { color: var(--muted); }
</style>
