---
/**
 * Numbered section head — mono numeral + serif heading + ink border-bottom.
 * Shared by prose/comparison-pair/stats-facts/treatment-groups blocks that
 * carry a `heading`. `num` is the running section index (01, 02… in EN,
 * ٠١, ٠٢… in AR).
 */
interface Props {
  num: string;
  heading: string;
  id: string;
}
const { num, heading, id } = Astro.props;
---

<div class="head" id={id}>
  <span class="head-num">{num}</span>
  <h2 class="head-h">{heading}</h2>
</div>

<style>
  .head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 12px;
    margin-bottom: 28px;
    scroll-margin-top: 96px;
  }
  .head-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  :global(html[dir="rtl"]) .head-num {
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    font-size: 13px;
  }
  .head-h {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.9vw, 29px);
    font-weight: 400;
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--ink);
    line-height: 1.1;
  }
  :global(html[dir="rtl"]) .head-h {
    font-weight: 700;
    letter-spacing: 0;
    font-size: clamp(23px, 3.1vw, 30px);
    line-height: 1.22;
  }
</style>
