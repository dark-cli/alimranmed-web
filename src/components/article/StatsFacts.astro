---
/**
 * Stats + facts — a 3–4 cell stat band (big Newsreader numbers on surface
 * tint) plus a numbered facts register below.
 */
import SectionHead from "./SectionHead.astro";

interface Props {
  num?: string;
  heading?: string;
  id?: string;
  intro?: string;
  stats: { value: string; label: string }[];
  facts?: string[];
  factsTitle: string;    // localised label, e.g. "Key facts" / "حقائق أساسية"
  factNumbers: string[]; // pre-formatted numerals for facts (01… or ٠١…)
}
const { num, heading, id, intro, stats, facts = [], factsTitle, factNumbers } = Astro.props;
---

<section class="sf">
  {heading && num && id && <SectionHead num={num} heading={heading} id={id} />}
  {intro && <p class="sf-intro">{intro}</p>}

  <div class="sf-stats">
    {stats.map((s) => (
      <div class="sf-stat">
        <p class="sf-fig">{s.value}</p>
        <p class="sf-lbl">{s.label}</p>
      </div>
    ))}
  </div>

  {facts.length > 0 && (
    <>
      <p class="sf-facts-title">{factsTitle}</p>
      <div class="sf-facts">
        {facts.map((f, i) => (
          <div class="sf-fact">
            <span class="sf-fact-num">{factNumbers[i] || String(i + 1).padStart(2, "0")}</span>
            <span class="sf-fact-text">{f}</span>
          </div>
        ))}
      </div>
    </>
  )}
</section>

<style>
  .sf { margin-bottom: clamp(44px, 5.5vw, 64px); }
  .sf-intro {
    font-size: 17px; line-height: 1.72; color: var(--body);
    margin: 0 0 28px; text-wrap: pretty;
  }
  :global(html[dir="rtl"]) .sf-intro { line-height: 1.95; }

  .sf-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-bottom: 32px;
  }
  .sf-stat { background: var(--surface); padding: 24px 22px; }
  .sf-fig {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.2vw, 38px);
    line-height: 1.1;
    margin: 0 0 8px;
    color: var(--accent);
    font-weight: 400;
  }
  :global(html[dir="rtl"]) .sf-fig { font-weight: 700; }
  .sf-lbl {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--body);
  }
  :global(html[dir="rtl"]) .sf-lbl { line-height: 1.85; }

  .sf-facts-title {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 14px;
  }
  :global(html[dir="rtl"]) .sf-facts-title {
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 12px;
  }
  .sf-facts { border-top: 1px solid var(--ink); }
  .sf-fact {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .sf-fact-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }
  :global(html[dir="rtl"]) .sf-fact-num { font-family: var(--font-body); font-size: 13px; }
  .sf-fact-text { font-size: 15.5px; line-height: 1.6; color: var(--ink); }
  :global(html[dir="rtl"]) .sf-fact-text { line-height: 1.9; }
</style>
