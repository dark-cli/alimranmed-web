---
/**
 * pathway — auto-fit responsive columns of link-chip groups. Each group has
 * an eyebrow number/label, a title, and a list of chip-button links. Used
 * for the home page "Conditions we treat" pattern where each pathway
 * (Brain / Spine / Pain) is a labelled column of clickable treatment links.
 *
 * Fields: heading?, intro?, groups[] of { eyebrow?, title, items[] }
 *   where items[] = { name, href }
 */
import { localizedHref } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

interface ChipItem { name: string; href: string; }
interface Group { eyebrow?: string; title: string; items: ChipItem[]; }
interface Props {
  heading?: string;
  intro?: string;
  groups: Group[];
  locale?: Locale;
}
const { heading, intro, groups, locale = "en" } = Astro.props;

function link(href: string): string {
  return href.startsWith("/") ? localizedHref(href, locale) : href;
}
---

<section class="pw-block">
  {heading && <h2 class="pw-heading">{heading}</h2>}
  {intro && <p class="pw-intro">{intro}</p>}
  <div class="pw-grid">
    {groups.map((g) => (
      <div class="pw-group">
        <div class="pw-head">
          {g.eyebrow && <span class="pw-eyebrow">{g.eyebrow}</span>}
          <h3 class="pw-title">{g.title}</h3>
        </div>
        <div class="pw-chips">
          {g.items.map((c) => (
            <a class="pw-chip" href={link(c.href)}>{c.name}</a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .pw-block { margin: clamp(28px, 3.5vw, 44px) 0; }
  .pw-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(22px, 2.8vw, 30px);
    color: var(--ink);
    margin: 0 0 12px;
    line-height: 1.2;
  }
  :global(html[dir="rtl"]) .pw-heading { font-weight: 700; letter-spacing: 0; }
  .pw-intro {
    font-size: 17px; line-height: 1.72; color: var(--body);
    margin: 0 0 24px; text-wrap: pretty; max-width: 62ch;
  }
  :global(html[dir="rtl"]) .pw-intro { line-height: 1.95; }

  .pw-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(255px, 100%), 1fr));
    gap: 40px;
  }

  .pw-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 16px; }
  .pw-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  :global(html[dir="rtl"]) .pw-eyebrow {
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 12px;
  }
  .pw-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
    margin: 0;
    color: var(--ink);
    line-height: 1.15;
  }
  :global(html[dir="rtl"]) .pw-title { font-weight: 700; letter-spacing: 0; }

  .pw-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .pw-chip {
    font-size: 14px;
    color: var(--ink);
    border: 1px solid var(--line);
    background: var(--white);
    padding: 7px 12px;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }
  .pw-chip:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--surface);
    text-decoration: none;
  }
</style>
