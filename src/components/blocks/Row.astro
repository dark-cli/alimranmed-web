---
/**
 * row — generic horizontal layout. Holds any mix of child blocks side by
 * side (prose, media, buttons, cards, doctor-credit, nested rows/columns
 * …). Collapses to a single stacked column on narrow viewports.
 *
 * For a photo-only gallery, use `image-row` instead — it bundles aspect
 * ratios, alt text and caption styling.
 *
 * Fields:
 *   heading?  — optional label above the row
 *   columns   — "auto" | "2" | "3" | "4" (default "auto")
 *   gap       — "tight" | "normal" | "wide" (default "normal")
 *   align     — "start" | "center" | "stretch" (default "stretch")
 *   items[]   — any blocks (recursive — rendered by Sections)
 */
import Sections from "./Sections.astro";
import type { Locale } from "../../lib/i18n";

interface Props {
  heading?: string;
  columns?: "auto" | "2" | "3" | "4";
  gap?: "tight" | "normal" | "wide";
  align?: "start" | "center" | "stretch";
  items: any[];
  locale?: Locale;
  id?: string;
}
const {
  heading,
  columns = "auto",
  gap = "normal",
  align = "stretch",
  items,
  locale = "en",
  id,
} = Astro.props;

const gridStyle = columns === "auto"
  ? "grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));"
  : `grid-template-columns: repeat(${columns}, minmax(0, 1fr));`;
---

<section class="row-block" id={id} data-cols={columns} data-gap={gap} data-align={align}>
  {heading && <p class="row-heading">{heading}</p>}
  <div class="row-grid" style={gridStyle}>
    {items.map((child) => (
      <div class="row-cell">
        <Sections sections={[child]} locale={locale} />
      </div>
    ))}
  </div>
</section>

<style>
  .row-block { margin: clamp(28px, 3.5vw, 44px) 0; }
  .row-heading {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 14px;
  }
  :global(html[dir="rtl"]) .row-heading {
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 12px;
  }

  .row-grid { display: grid; }
  .row-block[data-gap="tight"]  .row-grid { gap: 12px; }
  .row-block[data-gap="normal"] .row-grid { gap: clamp(24px, 3vw, 40px); }
  .row-block[data-gap="wide"]   .row-grid { gap: clamp(40px, 5vw, 72px); }

  .row-block[data-align="start"]   .row-grid { align-items: start; }
  .row-block[data-align="center"]  .row-grid { align-items: center; }
  .row-block[data-align="stretch"] .row-grid { align-items: stretch; }

  /* Children inside a row-cell: trim the top/bottom margins their own
     block classes add, so the row's gap controls spacing. */
  .row-cell > :global(section),
  .row-cell > :global(div) { margin-top: 0; margin-bottom: 0; }

  @media (max-width: 640px) {
    .row-block[data-cols="2"] .row-grid,
    .row-block[data-cols="3"] .row-grid,
    .row-block[data-cols="4"] .row-grid { grid-template-columns: 1fr !important; }
  }
  @media (min-width: 641px) and (max-width: 900px) {
    .row-block[data-cols="4"] .row-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
  }
</style>
