---
/**
 * DoctorSections — renders the doctor CV.
 *
 * The hero is standalone (every doctor has exactly one) and renders first
 * from the doctor's top-level heroEyebrow / heroHeadline / heroLede fields.
 * Everything else — stats, timelines (appointments, education, conferences),
 * memberships, publications — is a block in the sections list, dispatched
 * by type below.
 */
import CvHero         from "./CvHero.astro";
import CvStats        from "./CvStats.astro";
import CvTimeline     from "./CvTimeline.astro";
import CvMemberships  from "./CvMemberships.astro";
import CvPublications from "./CvPublications.astro";

interface Props {
  sections: any[];
  fullName: string;
  photo?: string;
  photoAlt?: string;
  titles: string[];
  heroEyebrow: string;
  heroHeadline?: string;
  heroLede: string;
}
const { sections, fullName, photo, photoAlt, titles, heroEyebrow, heroHeadline, heroLede } = Astro.props;

// Last register-style block (timeline / memberships / publications) gets
// isLast so its bottom padding matches the end of the page.
const lastRegisterIdx = sections
  .map((s, i) => ({ i, t: s.type }))
  .filter(({ t }) => t === "cv_timeline" || t === "cv_memberships" || t === "cv_publications")
  .map(({ i }) => i)
  .pop();
---

<CvHero
  eyebrow={heroEyebrow}
  headline={heroHeadline ?? fullName}
  lede={heroLede}
  chips={titles}
  portrait={photo}
  portraitAlt={photoAlt ?? fullName}
/>

{sections.map((s: any, i: number) => {
  const isLast = i === lastRegisterIdx;

  if (s.type === "cv_stats")
    return <CvStats items={s.items} />;

  if (s.type === "cv_timeline")
    return <CvTimeline heading={s.heading} rows={s.rows} isLast={isLast} />;

  if (s.type === "cv_memberships")
    return <CvMemberships heading={s.heading} items={s.items} isLast={isLast} />;

  if (s.type === "cv_publications")
    return <CvPublications heading={s.heading} items={s.items} isLast={isLast} />;

  return null;
})}
