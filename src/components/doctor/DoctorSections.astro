---
/**
 * DoctorSections — dispatches doctor CV sections to the correct block
 * component. Mirrors the pattern in components/article/ArticleSections.astro
 * but for the doctor-only block types (cv_hero, cv_stats, cv_timeline,
 * cv_publications).
 *
 * Memberships live at the top level of the doctor frontmatter (not in the
 * sections list) so the listing card and detail page use the same source.
 * They render after the sections loop; the parent page decides where.
 */
import CvHero         from "./CvHero.astro";
import CvStats        from "./CvStats.astro";
import CvTimeline     from "./CvTimeline.astro";
import CvMemberships  from "./CvMemberships.astro";
import CvPublications from "./CvPublications.astro";

interface Props {
  sections: any[];
  fullName: string;
  photo?: string;
  photoAlt?: string;
  titles: string[];
  memberships: { name: string; year: string }[];
  membershipsHeading: string;
}
const { sections, fullName, photo, photoAlt, titles, memberships, membershipsHeading } = Astro.props;

// The membership list slots into the section flow after the last cv_timeline
// coming from the frontmatter (typically Education). Everything after it —
// publications and remaining timelines — renders below. This keeps the
// existing on-page order without needing an explicit block for memberships.
const membershipInsertAfter = (() => {
  const educationIdx = sections.findIndex(
    (s: any) => s.type === "cv_timeline" && (s.heading === "Education" || s.heading === "التعليم")
  );
  return educationIdx >= 0 ? educationIdx : sections.length - 1;
})();

// Last "register-style" element (timeline / memberships / publications) gets
// extra bottom padding via isLast. We include the injected memberships block
// in that calculation.
type Item = { kind: "section"; s: any; i: number } | { kind: "memberships" };
const flow: Item[] = [];
sections.forEach((s: any, i: number) => {
  flow.push({ kind: "section", s, i });
  if (i === membershipInsertAfter && memberships.length > 0) {
    flow.push({ kind: "memberships" });
  }
});

const lastRegisterIdx = flow
  .map((item, i) => ({ i, item }))
  .filter(({ item }) => {
    if (item.kind === "memberships") return true;
    const t = item.s.type;
    return t === "cv_timeline" || t === "cv_publications";
  })
  .map(({ i }) => i)
  .pop();
---

{flow.map((item, i) => {
  const isLast = i === lastRegisterIdx;

  if (item.kind === "memberships")
    return <CvMemberships heading={membershipsHeading} items={memberships} isLast={isLast} />;

  const s = item.s;

  if (s.type === "cv_hero")
    return <CvHero
      eyebrow={s.eyebrow}
      headline={s.headline ?? fullName}
      lede={s.lede}
      chips={titles}
      portrait={photo}
      portraitAlt={photoAlt ?? fullName}
    />;

  if (s.type === "cv_stats")
    return <CvStats items={s.items} />;

  if (s.type === "cv_timeline")
    return <CvTimeline heading={s.heading} rows={s.rows} isLast={isLast} />;

  if (s.type === "cv_publications")
    return <CvPublications heading={s.heading} items={s.items} isLast={isLast} />;

  return null;
})}
