---
/**
 * list / variant=columns — fixed 2 columns, always.
 * Each cell is a full label + body entry (same shape as `rows`), just
 * placed in two side-by-side columns to save vertical space when the page
 * is wide. Collapses to a single column on narrow viewports.
 *
 * Different from `wrap`: wrap fits as many columns as the space allows
 * (could be 1, 2, or 3); columns is always exactly 2 (or 1 on mobile).
 * Use this for medium-length entries where linear stacking wastes space
 * but density-packing would look cramped.
 */
interface Props {
  heading: string;
  items: { label: string; body: string; subtitle?: string }[];
  isLast?: boolean;
}
const { heading, items, isLast = false } = Astro.props;
---

<section class:list={["reg-section", isLast && "reg-section-last"]}>
  <div class="reg-wrap">
    <h2 class="reg-label">{heading}</h2>
    <div class="reg-body reg-columns">
      {items.map((it) => (
        <div class="col-row">
          <span class="reg-period">{it.label}</span>
          <div class="reg-text">
            <span>{it.body}</span>
            {it.subtitle && <span class="reg-subtitle">{it.subtitle}</span>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .reg-section { max-width: var(--page-max); margin: 0 auto; padding: clamp(40px, 5vw, 64px) 24px 0; }
  .reg-section-last { padding-bottom: clamp(56px, 7vw, 96px); }
  .reg-wrap { display: flex; flex-wrap: wrap; gap: 18px clamp(32px, 4vw, 64px); align-items: flex-start; }
  .reg-label {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent);
    margin: 0; position: sticky; top: 96px;
    flex: 0 0 min(190px, 100%);
    font-weight: 500;
  }
  .reg-body { border-top: 1px solid var(--ink); flex: 1 1 380px; min-width: 0; margin: 0; padding: 0; list-style: none; }

  .reg-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 48px;
  }
  .col-row {
    display: grid;
    grid-template-columns: minmax(60px, 100px) minmax(0, 1fr);
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .reg-period { font-family: var(--font-mono); font-size: 12.5px; color: var(--muted); }
  .reg-text {
    font-size: 15px; line-height: 1.55; color: var(--ink);
    display: flex; flex-direction: column; gap: 4px;
  }
  .reg-subtitle { font-size: 13px; color: var(--muted); line-height: 1.5; }

  @media (max-width: 720px) {
    .reg-columns { grid-template-columns: 1fr; }
    .col-row { grid-template-columns: 1fr; gap: 4px; }
    .reg-label { position: static; }
  }

  :global(html[dir="rtl"]) .reg-label {
    font-family: var(--font-body); font-size: 12px; letter-spacing: 0.04em; text-transform: none; font-weight: 700;
  }
  :global(html[dir="rtl"]) .reg-period { font-family: var(--font-body); font-size: 13px; }
  :global(html[dir="rtl"]) .reg-text { line-height: 1.7; }
  :global(html[dir="rtl"]) .reg-subtitle { line-height: 1.7; }
</style>
