---
/**
 * list / variant=memberships — heading + wrapping 2-column grid.
 * Body on the left (society name, main text); label on the right
 * (year joined, mono small). Wraps into 2 pairs per row when wide.
 */
interface Props {
  heading: string;
  items: { label: string; body: string; subtitle?: string }[];
  isLast?: boolean;
}
const { heading, items, isLast = false } = Astro.props;
---

<section class:list={["reg-section", isLast && "reg-section-last"]}>
  <div class="reg-wrap">
    <h2 class="reg-label">{heading}</h2>
    <ul class="reg-body reg-members">
      {items.map((it) => (
        <li>
          {it.body}
          <span class="member-year">{it.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .reg-section { max-width: var(--page-max); margin: 0 auto; padding: clamp(40px, 5vw, 64px) 24px 0; }
  .reg-section-last { padding-bottom: clamp(56px, 7vw, 96px); }
  .reg-wrap { display: flex; flex-wrap: wrap; gap: 18px clamp(32px, 4vw, 64px); align-items: flex-start; }
  .reg-label {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent);
    margin: 0; position: sticky; top: 96px;
    flex: 0 0 min(190px, 100%);
    font-weight: 500;
  }
  .reg-body { border-top: 1px solid var(--ink); flex: 1 1 380px; min-width: 0; margin: 0; padding: 0; list-style: none; }
  .reg-members {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(245px, 100%), 1fr));
    gap: 0 48px;
  }
  .reg-members li {
    font-size: 15px; color: var(--ink);
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
  }
  .member-year { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }

  @media (max-width: 640px) { .reg-label { position: static; } }

  :global(html[dir="rtl"]) .reg-label {
    font-family: var(--font-body); font-size: 12px; letter-spacing: 0.04em; text-transform: none; font-weight: 700;
  }
  :global(html[dir="rtl"]) .member-year { font-family: var(--font-body); font-size: 13px; }
</style>
