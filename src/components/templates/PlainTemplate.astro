---
/**
 * PlainTemplate — the shared chrome for sections-only pages (home,
 * about, future contact / follow / legal / careers / marketing landings).
 * No breadcrumbs, no sidebar TOC, no CTA band — just the article
 * container width, hero top padding, and the sections dispatcher.
 *
 * Routes using this template:
 *   src/pages/[locale]/index.astro       → home
 *   src/pages/[locale]/about.astro       → about
 *
 * The hero image preload hint is optional — pass it when the page has a
 * large above-the-fold image so the browser kicks off the fetch during
 * HTML parse (LCP optimisation).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sections from "../blocks/Sections.astro";
import type { Locale } from "../../lib/i18n";

export interface HeroPreload {
  srcset: string;
  sizes: string;
  type: string;
}

interface Props {
  title: string;
  description?: string;
  sections: any[];
  locale: Locale;
  heroPreload?: HeroPreload;
}
const { title, description = "", sections, locale, heroPreload } = Astro.props;
---

<BaseLayout title={title} description={description} heroPreload={heroPreload}>
  <div class="plain-wrap">
    <Sections sections={sections} locale={locale} />
  </div>
  <div class="tail-space" aria-hidden="true"></div>
</BaseLayout>

<style>
  .plain-wrap {
    max-width: var(--page-max);
    margin: 0 auto;
    /* Top padding matches the old hero-band's padding-block so the hero
       breathes under the header. Block widgets add their own top margin
       below the first section — zero only that first one to avoid a
       double gap under the hero. */
    padding: clamp(44px, 5.5vw, 88px) 24px 0;
  }
  .plain-wrap > :global(section:first-child),
  .plain-wrap > :global(section.row-block:first-child) { margin-top: 0; }

  .tail-space { height: clamp(56px, 7vw, 96px); }
</style>
