---
/**
 * About page — thin loader. Reads src/content/about/{en,ar}.md and
 * renders through the shared PlainTemplate.
 */
import { getEntry } from "astro:content";
import { currentLocale } from "../../lib/i18n";
import PlainTemplate from "../../components/templates/PlainTemplate.astro";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);

const entry =
  (await getEntry("about", locale)) ??
  (await getEntry("about", "en"));

const data = (entry?.data ?? {}) as {
  title?: string;
  description?: string;
  sections?: any[];
};
---

<PlainTemplate
  title={data.title ?? "About"}
  description={data.description ?? ""}
  sections={data.sections ?? []}
  locale={locale}
/>
