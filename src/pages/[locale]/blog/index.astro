---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { topicOf, isLocale, localizedHref, currentLocale } from "../../../lib/i18n";
import { readingMinutes, readingTimeAr } from "../../../lib/word-count";
import { BLOG_PATHWAY, PATHWAY_LABELS } from "../../../lib/pathways";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);
const isAr = locale === "ar";

const PATHWAY_LABEL = isAr ? PATHWAY_LABELS.ar : PATHWAY_LABELS.en;
const dateLocale = isAr ? "ar-IQ" : "en-US";
const wpm = isAr ? 140 : undefined;

const blogsRaw = (await getCollection("blog"))
  .filter((e) => isLocale(e.id, locale))
  .sort((a, b) => {
    const ad = a.data.publishedAt?.getTime() ?? 0;
    const bd = b.data.publishedAt?.getTime() ?? 0;
    return bd - ad;
  });

const blogs = blogsRaw.map((entry) => {
  const topic = topicOf(entry.id);
  const pathway = BLOG_PATHWAY[topic] || "other";
  const mins = readingMinutes(entry, wpm);
  return {
    entry,
    topic,
    href: L(`/blog/${topic}/`),
    pathway,
    pathwayLabel: PATHWAY_LABEL[pathway],
    readingLabel: isAr ? readingTimeAr(mins) : `${mins} min`,
    publishedLabel: entry.data.publishedAt
      ? entry.data.publishedAt.toLocaleDateString(dateLocale, { year: "numeric", month: "short", day: "numeric" })
      : "",
  };
});

const counts = { all: blogs.length, brain: 0, spine: 0, pain: 0, other: 0 };
blogs.forEach((b) => { (counts as any)[b.pathway] += 1; });

const [featured, ...rest] = blogs;

const T = isAr ? {
  title:       "المدونة — مركز العمران الطبي",
  description: "مقالات طبية حول الحالات التي نعالجها والإجراءات التي نقدمها — مكتوبة ليصل المريض إلى الموعد الأول وهو يفهم المصطلحات.",
  eyebrow:     "المقالات",
  h1:          "مقالات طبية من العيادة.",
  lede:        "مقالات بلغة مبسّطة حول الحالات التي نعالجها والإجراءات التي نقدمها — مكتوبة ليصل المريض إلى الموعد الأول وهو يعرف معنى المصطلحات.",
  filterLabel: "تصفية حسب المسار",
  ariaFilter:  "تصفية المسار",
  all:         "الكل",
  brain:       "الدماغ",
  spine:       "العمود الفقري",
  pain:        "الألم",
  other:       "أخرى",
  latest:      "أحدث مقال",
  arrow:       "←",
  emptyFilter: "لا توجد مقالات تطابق هذه التصفية.",
  emptyAll:    "ستظهر المقالات هنا بعد اكتمال ترحيل المدونة.",
} : {
  title:       "Blog — Alimran Medical Center",
  description: "Medical articles on neurology, spine and pain medicine — written to help patients understand a condition or a procedure before their first appointment.",
  eyebrow:     "Articles",
  h1:          "Medical articles from the clinic.",
  lede:        "Plain-language pieces on conditions we treat and procedures we offer — written so patients arrive at a first appointment already knowing what the terms mean.",
  filterLabel: "Filter by pathway",
  ariaFilter:  "Pathway filter",
  all:         "All",
  brain:       "Brain",
  spine:       "Spine",
  pain:        "Pain",
  other:       "Other",
  latest:      "Latest article",
  arrow:       "→",
  emptyFilter: "No articles match this filter yet.",
  emptyAll:    "Posts will appear here after the blog migration runs.",
};
---

<BaseLayout title={T.title} description={T.description}>
  <section class="intro">
    <div class="intro-inner">
      <p class="intro-eyebrow">{T.eyebrow}</p>
      <h1 class="intro-h1">{T.h1}</h1>
      <p class="intro-lede">{T.lede}</p>
    </div>
  </section>

  <section class="filter-band">
    <div class="filter-inner">
      <p class="filter-label">{T.filterLabel}</p>
      <div class="filter-pills" role="tablist" aria-label={T.ariaFilter}>
        <button type="button" class="pill active" data-filter="all"   role="tab" aria-selected="true">{T.all} <span class="pill-n">{counts.all}</span></button>
        <button type="button" class="pill"        data-filter="brain" role="tab" aria-selected="false">{T.brain} <span class="pill-n">{counts.brain}</span></button>
        <button type="button" class="pill"        data-filter="spine" role="tab" aria-selected="false">{T.spine} <span class="pill-n">{counts.spine}</span></button>
        <button type="button" class="pill"        data-filter="pain"  role="tab" aria-selected="false">{T.pain} <span class="pill-n">{counts.pain}</span></button>
        {counts.other > 0 && (
          <button type="button" class="pill"      data-filter="other" role="tab" aria-selected="false">{T.other} <span class="pill-n">{counts.other}</span></button>
        )}
      </div>
    </div>
  </section>

  {featured && (
    <section class="featured-band" data-pathway={featured.pathway}>
      <a class="featured" href={featured.href}>
        <div class="featured-meta">
          <span class="featured-eyebrow">{T.latest}</span>
          <span class="featured-badge">{featured.pathwayLabel}</span>
        </div>
        <h2 class="featured-title">{featured.entry.data.title}</h2>
        {featured.entry.data.description && (
          <p class="featured-desc">{featured.entry.data.description}</p>
        )}
        <p class="featured-foot">
          <span>{featured.readingLabel}</span>
          {featured.publishedLabel && <span>· {featured.publishedLabel}</span>}
          <span class="featured-arrow" aria-hidden="true">{T.arrow}</span>
        </p>
      </a>
    </section>
  )}

  <section class="blog-grid-band">
    <div class="blog-grid" id="blog-grid">
      {rest.map((b) => (
        <a class="blog-card" href={b.href} data-pathway={b.pathway}>
          <div class="blog-card-meta">
            <span class="blog-card-badge" data-p={b.pathway}>{b.pathwayLabel}</span>
            <span class="blog-card-min">{b.readingLabel}</span>
          </div>
          <h3 class="blog-card-title">{b.entry.data.title}</h3>
          {b.entry.data.description && (
            <p class="blog-card-desc">{b.entry.data.description}</p>
          )}
          {b.publishedLabel && <p class="blog-card-date">{b.publishedLabel}</p>}
        </a>
      ))}
    </div>

    <p class="empty-state" id="blog-empty" hidden>{T.emptyFilter}</p>

    {blogs.length === 0 && (
      <p class="empty-state">{T.emptyAll}</p>
    )}
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    function bind() {
      var pills = document.querySelectorAll(".pill[data-filter]");
      if (!pills.length) return;
      pills.forEach(function (pill) {
        if (pill.__bound) return;
        pill.__bound = true;
        pill.addEventListener("click", function () {
          var filter = pill.getAttribute("data-filter");
          pills.forEach(function (p) {
            var active = p === pill;
            p.classList.toggle("active", active);
            p.setAttribute("aria-selected", String(active));
          });
          var cards = document.querySelectorAll(".blog-card");
          var featured = document.querySelector(".featured-band");
          var visible = 0;
          cards.forEach(function (c) {
            var match = filter === "all" || c.getAttribute("data-pathway") === filter;
            c.hidden = !match;
            if (match) visible++;
          });
          if (featured) {
            var fp = featured.getAttribute("data-pathway");
            featured.hidden = !(filter === "all" || fp === filter);
            if (!featured.hidden) visible++;
          }
          var empty = document.getElementById("blog-empty");
          if (empty) empty.hidden = visible !== 0;
        });
      });
    }
    bind();
    document.addEventListener("astro:page-load", bind);
  })();
</script>

<style>
  .intro { border-bottom: 1px solid var(--line); background: var(--surface); }
  .intro-inner {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(44px, 5.5vw, 72px) 24px clamp(40px, 5vw, 64px);
  }
  .intro-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 20px;
  }
  .intro-h1 {
    font-family: var(--font-display);
    font-size: clamp(30px, 5vw, 52px);
    line-height: 1.08;
    font-weight: 400;
    letter-spacing: -0.025em;
    margin: 0 0 18px;
    color: var(--ink);
    max-width: 20ch;
  }
  .intro-lede { font-size: 17px; line-height: 1.65; color: var(--body); margin: 0; max-width: 62ch; }

  .filter-band { border-bottom: 1px solid var(--line); }
  .filter-inner {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(20px, 2.5vw, 28px) 24px;
    display: flex; align-items: center; flex-wrap: wrap; gap: 20px;
  }
  .filter-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
    flex-shrink: 0;
  }
  .filter-pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill {
    font-family: var(--font-body);
    font-size: 13.5px;
    color: var(--body);
    background: var(--white);
    border: 1px solid var(--line);
    padding: 8px 14px;
    cursor: pointer;
    display: inline-flex; align-items: baseline; gap: 6px;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }
  .pill:hover { color: var(--accent); border-color: var(--accent); }
  .pill.active { color: var(--white); background: var(--accent); border-color: var(--accent); }
  .pill.active .pill-n { color: var(--white); opacity: 0.85; }
  .pill-n { font-family: var(--font-mono); font-size: 11px; color: var(--muted); }

  .featured-band {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(40px, 5vw, 64px) 24px 0;
  }
  .featured {
    display: block; text-decoration: none; color: inherit;
    border: 1px solid var(--line); background: var(--surface);
    padding: clamp(28px, 4vw, 44px);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .featured:hover { border-color: var(--accent); text-decoration: none; background: var(--white); }
  .featured-meta { display: flex; align-items: baseline; gap: 12px; margin-bottom: clamp(18px, 2vw, 24px); }
  .featured-eyebrow {
    font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);
  }
  .featured-badge {
    font-family: var(--font-mono);
    font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--muted); padding: 3px 7px; border: 1px solid var(--line); border-radius: 2px;
  }
  .featured-title {
    font-family: var(--font-display);
    font-size: clamp(26px, 4vw, 40px); font-weight: 400; letter-spacing: -0.02em;
    line-height: 1.15; margin: 0 0 16px; color: var(--ink);
  }
  .featured:hover .featured-title { color: var(--accent); }
  .featured-desc { font-size: 16.5px; line-height: 1.65; color: var(--body); margin: 0 0 20px; max-width: 64ch; }
  .featured-foot {
    display: flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: 12px; color: var(--muted); margin: 0;
  }
  .featured-arrow {
    margin-inline-start: auto; color: var(--accent); font-size: 18px; transition: transform 0.15s ease;
  }
  .featured:hover .featured-arrow { transform: translateX(4px); }
  :global(html[dir="rtl"]) .featured:hover .featured-arrow { transform: translateX(-4px); }

  .blog-grid-band {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(32px, 4vw, 56px) 24px clamp(56px, 7vw, 96px);
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: 1px; background: var(--line); border: 1px solid var(--line);
  }
  .blog-card {
    display: flex; flex-direction: column;
    padding: 24px 22px; text-decoration: none; color: inherit;
    background: var(--white); transition: background-color 0.15s ease;
  }
  .blog-card:hover { background: var(--surface); text-decoration: none; }
  .blog-card-meta { display: flex; align-items: baseline; gap: 10px; margin-bottom: 14px; }
  .blog-card-badge {
    font-family: var(--font-mono);
    font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 3px 7px; border: 1px solid var(--line); border-radius: 2px; background: var(--white);
  }
  .blog-card-badge[data-p="brain"] { color: #5a3d8a; border-color: #d7cae8; }
  .blog-card-badge[data-p="spine"] { color: #2f6d47; border-color: #bbdec5; }
  .blog-card-badge[data-p="pain"]  { color: #7a5a1a; border-color: #ecd9a8; }
  .blog-card-badge[data-p="other"] { color: var(--muted); border-color: var(--line); }
  .blog-card-min { font-family: var(--font-mono); font-size: 11px; color: var(--muted); margin-inline-start: auto; }
  .blog-card-title {
    font-family: var(--font-display);
    font-size: 20px; font-weight: 400; letter-spacing: -0.01em;
    line-height: 1.2; margin: 0 0 10px; color: var(--ink);
  }
  .blog-card:hover .blog-card-title { color: var(--accent); }
  .blog-card-desc {
    font-size: 14px; line-height: 1.55; color: var(--body);
    margin: 0 0 16px;
    overflow: hidden; display: -webkit-box;
    -webkit-line-clamp: 3; -webkit-box-orient: vertical; flex: 1 1 auto;
  }
  .blog-card-date { font-family: var(--font-mono); font-size: 11px; color: var(--muted); margin: 0; }

  .empty-state { text-align: center; color: var(--muted); font-size: 14px; margin: 40px 0; }
  :global(.blog-card[hidden]), :global(.featured-band[hidden]) { display: none !important; }

  /* AR typography overrides */
  :global(html[dir="rtl"]) .intro-eyebrow,
  :global(html[dir="rtl"]) .filter-label,
  :global(html[dir="rtl"]) .featured-eyebrow,
  :global(html[dir="rtl"]) .featured-badge,
  :global(html[dir="rtl"]) .blog-card-badge,
  :global(html[dir="rtl"]) .blog-card-min,
  :global(html[dir="rtl"]) .featured-foot,
  :global(html[dir="rtl"]) .blog-card-date,
  :global(html[dir="rtl"]) .pill-n {
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    text-transform: none;
  }
  :global(html[dir="rtl"]) .intro-eyebrow { font-size: 12px; }
  :global(html[dir="rtl"]) .filter-label { font-size: 13px; }
  :global(html[dir="rtl"]) .intro-h1 { font-weight: 700; letter-spacing: 0; line-height: 1.18; max-width: 24ch; }
  :global(html[dir="rtl"]) .intro-lede { line-height: 1.85; }
  :global(html[dir="rtl"]) .featured-title { font-weight: 700; letter-spacing: 0; line-height: 1.22; }
  :global(html[dir="rtl"]) .featured-desc { line-height: 1.85; }
  :global(html[dir="rtl"]) .blog-card-title { font-weight: 700; letter-spacing: 0; line-height: 1.3; }
  :global(html[dir="rtl"]) .blog-card-desc { line-height: 1.85; }
</style>
