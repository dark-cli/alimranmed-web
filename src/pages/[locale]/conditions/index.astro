---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SoonLink from "../../../components/article/SoonLink.astro";
import { CONTACT } from "../../../consts";
import { localizedHref, currentLocale, topicOf, isLocale } from "../../../lib/i18n";
import { BLOG_PATHWAY } from "../../../lib/pathways";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);
const isAr = locale === "ar";
const dateLocale = isAr ? "ar-IQ" : "en-US";
const callHref = `tel:${CONTACT.phones[0].replace(/\s/g, "")}`;
const secondCallHref = `tel:${CONTACT.phones[1].replace(/\s/g, "")}`;

const allTreatments = await getCollection("treatments");
const bySlug: Record<string, boolean> = {};
allTreatments.filter((e) => isLocale(e.id, "en")).forEach((e) => {
  bySlug[topicOf(e.id)] = e.data.redesigned === true;
});

const allBlogs = (await getCollection("blog"))
  .filter((e) => isLocale(e.id, locale) && e.data.clinicallyRelevant === true)
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));

const blogsByPathway: Record<"brain" | "spine" | "pain", typeof allBlogs> = {
  brain: [], spine: [], pain: [],
};
for (const b of allBlogs) {
  const p = BLOG_PATHWAY[topicOf(b.id)];
  if (p) blogsByPathway[p].push(b);
}

const procedureCategories = isAr ? [
  { num: "الفئة ٠١", title: "العلاج الطبيعي", basePath: "physiotherapy",
    items: [
      { name: "العلاج الطبيعي",              slug: "physical-therapy" },
      { name: "التحفيز الكهربائي",            slug: "electrical-stimulation" },
      { name: "العلاج بالليزر",              slug: "laser-therapy" },
      { name: "العلاج بالموجات فوق الصوتية",  slug: "ultrasound-therapy" },
      { name: "روبوت LUNA EMG",              slug: "luna-emg-robot" },
    ] },
  { num: "الفئة ٠٢", title: "تقويم العمود الفقري", basePath: "chiropractic",
    items: [
      { name: "تقويم العمود الفقري", slug: "chiropractic" },
      { name: "سيغما",               slug: "sigma" },
      { name: "SpineMED",            slug: "spinmed" },
    ] },
  { num: "الفئة ٠٣", title: "تحفيز الدماغ", basePath: "brain-stimulation",
    items: [
      { name: "TMS",               slug: "tms" },
      { name: "tDCS",              slug: "tdcs" },
      { name: "TMS للألم",          slug: "tms-pain" },
      { name: "TMS للطنين",         slug: "tms-tinnitus" },
      { name: "TMS للصداع النصفي",  slug: "tms-migraine" },
    ] },
  { num: "الفئة ٠٤", title: "الترددات الراديوية", basePath: "radiofrequency",
    items: [
      { name: "الترددات الراديوية",              slug: "radiofrequency" },
      { name: "رأب النواة",                     slug: "nucleoplasty" },
      { name: "ترددات راديوية للعمود الفقري",    slug: "spine" },
      { name: "ترددات راديوية للركبة",          slug: "knee" },
      { name: "ترددات راديوية للعصب الثلاثي التوائم", slug: "trigeminal-neuralgia" },
    ] },
  { num: "الفئة ٠٥", title: "الجراحة", basePath: "surgery",
    items: [
      { name: "جراحة العمود الفقري بالمنظار",  slug: "endoscopic-spine" },
      { name: "التحفيز العميق للدماغ",         slug: "dbs" },
      { name: "استئصال القرص القطني",          slug: "lumbar-microdiscectomy" },
      { name: "رأب الفقرة",                   slug: "vertebroplasty" },
      { name: "جراحة قاعدة الجمجمة عبر الأنف", slug: "transnasal-transsphenoidal" },
    ] },
  { num: "الفئة ٠٦", title: "الطب التجديدي", basePath: "regenerative-medicine",
    items: [
      { name: "برولوثيرابي",    slug: "prolotherapy" },
      { name: "الطب التجديدي",  slug: "regenerative-medicine" },
    ] },
] : [
  { num: "Category 01", title: "Physiotherapy", basePath: "physiotherapy",
    items: [
      { name: "Physical therapy",       slug: "physical-therapy" },
      { name: "Electrical stimulation", slug: "electrical-stimulation" },
      { name: "Laser therapy",          slug: "laser-therapy" },
      { name: "Ultrasound therapy",     slug: "ultrasound-therapy" },
      { name: "LUNA EMG robot",         slug: "luna-emg-robot" },
    ] },
  { num: "Category 02", title: "Chiropractic", basePath: "chiropractic",
    items: [
      { name: "Chiropractic",  slug: "chiropractic" },
      { name: "Sigma",         slug: "sigma" },
      { name: "SpineMED",      slug: "spinmed" },
    ] },
  { num: "Category 03", title: "Brain stimulation", basePath: "brain-stimulation",
    items: [
      { name: "TMS",              slug: "tms" },
      { name: "tDCS",             slug: "tdcs" },
      { name: "TMS for pain",     slug: "tms-pain" },
      { name: "TMS for tinnitus", slug: "tms-tinnitus" },
      { name: "TMS for migraine", slug: "tms-migraine" },
    ] },
  { num: "Category 04", title: "Radiofrequency", basePath: "radiofrequency",
    items: [
      { name: "Radiofrequency",           slug: "radiofrequency" },
      { name: "Nucleoplasty",             slug: "nucleoplasty" },
      { name: "Spine radiofrequency",     slug: "spine" },
      { name: "Knee radiofrequency",      slug: "knee" },
      { name: "Trigeminal neuralgia RF",  slug: "trigeminal-neuralgia" },
    ] },
  { num: "Category 05", title: "Surgery", basePath: "surgery",
    items: [
      { name: "Endoscopic spine surgery",     slug: "endoscopic-spine" },
      { name: "Deep brain stimulation",       slug: "dbs" },
      { name: "Lumbar microdiscectomy",       slug: "lumbar-microdiscectomy" },
      { name: "Vertebroplasty",               slug: "vertebroplasty" },
      { name: "Transnasal skull-base surgery", slug: "transnasal-transsphenoidal" },
    ] },
  { num: "Category 06", title: "Regenerative", basePath: "regenerative-medicine",
    items: [
      { name: "Prolotherapy",          slug: "prolotherapy" },
      { name: "Regenerative medicine", slug: "regenerative-medicine" },
    ] },
];

const pathways = isAr ? [
  { num: "المسار ٠١", title: "الدماغ", key: "brain" as const,
    items: [
      { name: "أورام الدماغ",        slug: "brain-tumor" },
      { name: "الجلطة الدماغية",      slug: "stroke" },
      { name: "الصرع والاختلاجات",    slug: "epilepsy-seizures" },
      { name: "إصابات الرأس",         slug: "head-injury" },
      { name: "داء باركنسون",         slug: "parkinsons-disease" },
      { name: "اضطرابات الحركة",      slug: "motor-disorders" },
      { name: "شلل الوجه النصفي",     slug: "bells-palsy" },
    ] },
  { num: "المسار ٠٢", title: "العمود الفقري", key: "spine" as const,
    items: [
      { name: "القرص المنزلق",        slug: "herniated-disc" },
      { name: "عرق النسا",            slug: "sciatica" },
      { name: "إصابات الحبل الشوكي",  slug: "spinal-cord-injury" },
      { name: "الجَنَف",               slug: "scoliosis" },
      { name: "الحَنَف الظهري",        slug: "kyphosis" },
      { name: "إصابة السوط",          slug: "whiplash" },
      { name: "المثانة العصبية",      slug: "neurogenic-bladder" },
    ] },
  { num: "المسار ٠٣", title: "الألم", key: "pain" as const,
    items: [
      { name: "الصداع المزمن واليومي", slug: "headaches" },
      { name: "آلام الرقبة",           slug: "neck-pain" },
      { name: "آلام الظهر",            slug: "back-pain" },
      { name: "الكتف المتجمد",         slug: "frozen-shoulder" },
      { name: "آلام الركبة",           slug: "knee-pain" },
      { name: "الألم العضلي الليفي",   slug: "fibromyalgia" },
      { name: "آلام الأورام المستعصية", slug: "cancer-pain" },
    ] },
] : [
  { num: "Pathway 01", title: "Brain", key: "brain" as const,
    items: [
      { name: "Brain tumour",          slug: "brain-tumor" },
      { name: "Stroke",                slug: "stroke" },
      { name: "Epilepsy and seizures", slug: "epilepsy-seizures" },
      { name: "Head injury",           slug: "head-injury" },
      { name: "Parkinson's disease",   slug: "parkinsons-disease" },
      { name: "Motor disorders",       slug: "motor-disorders" },
      { name: "Bell's palsy",          slug: "bells-palsy" },
    ] },
  { num: "Pathway 02", title: "Spine", key: "spine" as const,
    items: [
      { name: "Herniated disc",      slug: "herniated-disc" },
      { name: "Sciatica",            slug: "sciatica" },
      { name: "Spinal cord injury",  slug: "spinal-cord-injury" },
      { name: "Scoliosis",           slug: "scoliosis" },
      { name: "Kyphosis",            slug: "kyphosis" },
      { name: "Whiplash",            slug: "whiplash" },
      { name: "Neurogenic bladder",  slug: "neurogenic-bladder" },
    ] },
  { num: "Pathway 03", title: "Pain", key: "pain" as const,
    items: [
      { name: "Chronic and daily headache",      slug: "headaches" },
      { name: "Neck pain",                       slug: "neck-pain" },
      { name: "Back pain",                       slug: "back-pain" },
      { name: "Frozen shoulder",                 slug: "frozen-shoulder" },
      { name: "Knee pain",                       slug: "knee-pain" },
      { name: "Fibromyalgia",                    slug: "fibromyalgia" },
      { name: "Cancer-related intractable pain", slug: "cancer-pain" },
    ] },
];

const photoStrip = isAr ? [
  { caption: "جراحة العمود الفقري بالمنظار",
    src: "https://images.unsplash.com/photo-1550831107-1553da8c8464?w=1200&q=80&auto=format&fit=crop",
    alt: "استشاري جراحة الأعصاب أثناء عملية" },
  { caption: "التحفيز العصبي",
    src: "/images/home/tms-treatment-768.jpg",
    alt: "جلسة تحفيز مغناطيسي عبر الجمجمة" },
  { caption: "الكيّ بالترددات الراديوية",
    src: "https://images.unsplash.com/photo-1754941622138-b3c3671f2fa8?w=1200&q=80&auto=format&fit=crop",
    alt: "جهاز علاجي مُطبَّق على مريض خلال جلسة" },
] : [
  { caption: "Endoscopic spine surgery",
    src: "https://images.unsplash.com/photo-1550831107-1553da8c8464?w=1200&q=80&auto=format&fit=crop",
    alt: "Consultant surgeon operating in theatre" },
  { caption: "Neuromodulation",
    src: "/images/home/tms-treatment-768.jpg",
    alt: "Neuromodulation delivered by trained operator" },
  { caption: "Radiofrequency ablation",
    src: "https://images.unsplash.com/photo-1754941622138-b3c3671f2fa8?w=1200&q=80&auto=format&fit=crop",
    alt: "Clinical device applied to a patient in a treatment session" },
];

const T = isAr ? {
  title:         "الحالات والإجراءات — مركز العمران الطبي",
  description:   "يصنّف المركز الحالات المحوَّلة في ثلاثة مسارات: الدماغ، العمود الفقري، والألم. جراحات وتدخلات وإعادة تأهيل بفريق واحد.",
  introEyebrow:  "ما نعالج والإجراءات",
  introH1:       "ما الذي نقيّمه، وكيف نعالجه.",
  introLede:     "يصنّف المركز الحالات المحوَّلة في ثلاثة مسارات. يشمل الموعد الأول فحصًا عصبيًا كاملًا ومراجعة للصور الشعاعية المتوفرة، وتُسلَّم خطة مكتوبة للمريض وللطبيب المحوِّل.",
  condEyebrow:   "الحالات",
  condH2:        "ما نعالج",
  seeAllTreat:   "← عرض جميع الحالات",
  soonLabel:     "هذا المقال لم يُنجَز بعد في التصميم الجديد — قريبًا.",
  procEyebrow:   "الإجراءات",
  procH2:        "الإجراءات والعلاجات التي نقدمها",
  seeAllSvc:     "← عرض جميع الإجراءات",
  relatedRead:   "قراءة ذات صلة",
  apptH2:        "حجز موعد",
  apptBody:      "تُحجز المواعيد هاتفيًا عبر سكرتارية المركز. يُرجى تحضير الصور الشعاعية السابقة وتقارير العمليات وقائمة الأدوية الحالية قبل الاتصال.",
  blogEyebrow:   "المقالات",
  blogH2:        "جديد المدونة",
  seeAllBlog:    "← عرض جميع المقالات",
} : {
  title:         "Conditions & Procedures — Alimran Clinic",
  description:   "The clinic groups referrals into three pathways: brain, spine and pain. Surgical, interventional and rehabilitative procedures under one team.",
  introEyebrow:  "Conditions & procedures",
  introH1:       "What we assess, and how we treat it.",
  introLede:     "The clinic groups referrals into three pathways. Each first appointment includes a full neurological examination and a review of existing imaging; a written plan is issued to the patient and the referring clinician.",
  condEyebrow:   "Conditions",
  condH2:        "What we treat",
  seeAllTreat:   "Browse all conditions →",
  soonLabel:     undefined,
  procEyebrow:   "Procedures",
  procH2:        "Procedures & therapies we offer",
  seeAllSvc:     "Browse all procedures →",
  relatedRead:   "Related reading",
  apptH2:        "Arranging an appointment",
  apptBody:      "Appointments are booked by telephone through the clinic secretary. Please have prior imaging, operative notes and a current medication list available at the time of the call.",
  blogEyebrow:   "Articles",
  blogH2:        "Recent from the blog",
  seeAllBlog:    "Browse all articles →",
};
---

<BaseLayout title={T.title} description={T.description}>
  <section class="intro">
    <div class="intro-inner">
      <p class="intro-eyebrow">{T.introEyebrow}</p>
      <h1 class="intro-h1">{T.introH1}</h1>
      <p class="intro-lede">{T.introLede}</p>
    </div>
  </section>

  <section class="pathways-section">
    <header class="section-head">
      <span class="section-eyebrow">{T.condEyebrow}</span>
      <h2 class="section-h2">{T.condH2}</h2>
    </header>
    <div class="pathway-grid">
      {pathways.map((p) => (
        <div class="pathway-cell">
          <p class="pathway-num">{p.num}</p>
          <h3 class="pathway-name">{p.title}</h3>
          <ul>
            {p.items.map((c) => (
              <li>
                <SoonLink
                  href={L(`/treatments/${c.slug}/`)}
                  redesigned={bySlug[c.slug] === true}
                  soonLabel={T.soonLabel}
                >{c.name}</SoonLink>
              </li>
            ))}
          </ul>
          {blogsByPathway[p.key].length > 0 && (
            <div class="pathway-reading">
              <p class="pathway-reading-label">{T.relatedRead}</p>
              <ul class="pathway-reading-list">
                {blogsByPathway[p.key].slice(0, 4).map((b) => (
                  <li>
                    <a href={L(`/blog/${topicOf(b.id)}/`)}>{b.data.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </div>
    <p class="section-see-all">
      <a class="see-all-link" href={L("/treatments/")}>{T.seeAllTreat}</a>
    </p>
  </section>

  <section class="pathways-section">
    <header class="section-head">
      <span class="section-eyebrow">{T.procEyebrow}</span>
      <h2 class="section-h2">{T.procH2}</h2>
    </header>
    <div class="pathway-grid">
      {procedureCategories.map((cat) => (
        <div class="pathway-cell">
          <p class="pathway-num">{cat.num}</p>
          <h3 class="pathway-name">{cat.title}</h3>
          <ul>
            {cat.items.map((it) => (
              <li>
                <a href={L(`/services/${cat.basePath}/${it.slug}/`)}>{it.name}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="section-see-all">
      <a class="see-all-link" href={L("/services/")}>{T.seeAllSvc}</a>
    </p>
  </section>

  <section class="photo-strip">
    <div class="photo-strip-grid">
      {photoStrip.map((p) => (
        <figure class="photo-cell">
          <img src={p.src} alt={p.alt} width="1200" height="900" loading="lazy" />
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="appt-section">
    <div class="appt-card">
      <div>
        <h2 class="appt-h2">{T.apptH2}</h2>
        <p class="appt-body">{T.apptBody}</p>
      </div>
      <div class="appt-buttons">
        <a class="btn btn-primary appt-btn" href={callHref}><span dir="ltr">{CONTACT.phones[0]}</span></a>
        <a class="btn btn-secondary appt-btn" href={secondCallHref}><span dir="ltr">{CONTACT.phones[1]}</span></a>
      </div>
    </div>
  </section>

  {allBlogs.length > 0 && (
    <section class="related-section">
      <header class="section-head">
        <span class="section-eyebrow">{T.blogEyebrow}</span>
        <h2 class="section-h2">{T.blogH2}</h2>
      </header>
      <div class="related-grid">
        {allBlogs.slice(0, 6).map((blog) => (
          <a class="related-card card" href={L(`/blog/${topicOf(blog.id)}/`)}>
            <h3>{blog.data.title}</h3>
            {blog.data.description && <p>{blog.data.description}</p>}
            {blog.data.publishedAt && (
              <span class="date">{blog.data.publishedAt.toLocaleDateString(dateLocale, { year: "numeric", month: "short", day: "numeric" })}</span>
            )}
          </a>
        ))}
      </div>
      <p class="section-see-all">
        <a class="see-all-link" href={L("/blog/")}>{T.seeAllBlog}</a>
      </p>
    </section>
  )}
</BaseLayout>

<style>
  .intro { border-bottom: 1px solid var(--line); background: var(--surface); }
  .intro-inner {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(44px, 5.5vw, 72px) 24px clamp(40px, 5vw, 64px);
  }
  .intro-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 20px;
  }
  .intro-h1 {
    font-family: var(--font-display);
    font-size: clamp(30px, 5vw, 52px); line-height: 1.08;
    font-weight: 400; letter-spacing: -0.025em;
    margin: 0 0 18px; color: var(--ink); max-width: 20ch;
  }
  .intro-lede { font-size: 17px; line-height: 1.65; color: var(--body); margin: 0; max-width: 62ch; }

  .section-head {
    display: flex; gap: 14px; align-items: baseline;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 14px; margin-bottom: clamp(28px, 3.5vw, 44px);
  }
  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }
  .section-h2 {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.4vw, 34px);
    font-weight: 400; letter-spacing: -0.02em; margin: 0; color: var(--ink); line-height: 1.1;
  }
  .section-see-all { margin: clamp(20px, 2vw, 28px) 0 0; text-align: end; }
  .see-all-link {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--accent); text-decoration: none;
  }
  .see-all-link:hover { color: var(--accent-hover); text-decoration: none; }

  .pathways-section {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(44px, 5.5vw, 72px) 24px 0;
  }
  .pathway-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 1px; background: var(--line); border: 1px solid var(--line);
  }
  .pathway-cell { background: var(--white); padding: 34px 30px; }
  .pathway-num {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 6px;
  }
  .pathway-name {
    font-family: var(--font-display);
    font-size: clamp(21px, 2.6vw, 26px); font-weight: 400;
    margin: 0 0 22px; color: var(--ink);
  }
  .pathway-cell ul { list-style: none; margin: 0; padding: 0; }
  .pathway-cell li { padding: 11px 0; border-top: 1px solid var(--line-soft); font-size: 15px; }
  .pathway-cell li :global(a) {
    color: var(--accent); text-decoration: none;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }
  .pathway-cell li :global(a):hover {
    color: var(--accent-hover); text-decoration: underline; text-underline-offset: 3px;
  }

  @media (max-width: 639px) { .pathway-cell li:nth-child(n+5) { display: none; } }

  .pathway-reading { margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--line); }
  .pathway-reading-label {
    font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
