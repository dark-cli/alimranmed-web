---
/**
 * Contact page — thin loader. Reads src/content/contact/{en,ar}.md and
 * renders through the shared PlainTemplate. Hero + contact-strip +
 * social-row + map all live in those two Markdown files.
 *
 * fontAwesome=true is passed through to BaseLayout because social-row
 * uses FontAwesome brand icons.
 */
import { getEntry } from "astro:content";
import { currentLocale, LOCALES } from "../../lib/i18n";
import PlainTemplate from "../../components/templates/PlainTemplate.astro";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = currentLocale(Astro);

const entry =
  (await getEntry("contact", locale)) ??
  (await getEntry("contact", "en"));

const data = (entry?.data ?? {}) as {
  title?: string;
  description?: string;
  sections?: any[];
};
---

<PlainTemplate
  title={data.title ?? "Contact"}
  description={data.description ?? ""}
  sections={data.sections ?? []}
  locale={locale}
  fontAwesome
/>
