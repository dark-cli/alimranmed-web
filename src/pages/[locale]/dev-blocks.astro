    </section>

    {/* ─── panels ──────────────────────────────────────────────── */}
    <section class="showcase">
      <div class="meta">
        <p class="meta-code">{num(7)}</p>
        <div>
          <h2>panels</h2>
          <p class="meta-desc">{W.panels.desc}</p>
          <p class="meta-fields">{W.panels.fields}</p>
        </div>
      </div>
      <div class="preview">
        <p class="preview-tag">{T.structure} — {num(2)}</p>
        <Panels
          heading={P.heading}
          intro={P.intro}
          panels={[1, 2].map((n) => ({
            eyebrow: P.eyebrow,
            title: P.panelTitle(String(n)),
            items: [1, 2, 3].map((k) => P.panelItem(String(k))),
          }))}
          locale={locale}
        />
        <p class="preview-tag mt">{T.structure} — {num(4)}</p>
        <Panels
          heading={P.heading}
          intro={P.intro}
          note={P.note}
          panels={[1, 2, 3, 4].map((n) => ({
            title: P.panelTitle(String(n)),
            subtitle: P.subtitleWith,
            items: [1, 2].map((k) => P.panelItem(String(k))),
          }))}
          locale={locale}
        />
        <p class="preview-tag mt">{T.inUse} — {num(2)}</p>
        <Panels heading={R.panelsHeading2} intro={R.panelsIntro2} panels={R.panelsPair} locale={locale} />
        <p class="preview-tag mt">{T.inUse} — {num(4)}</p>
        <Panels heading={R.panelsHeading4} intro={R.panelsIntro4} note={R.panelsNote4} panels={R.panelsFour} locale={locale} />
      </div>
    </section>

    {/* ─── media ───────────────────────────────────────────────── */}
    <section class="showcase">
      <div class="meta">
        <p class="meta-code">{num(8)}</p>
        <div>
          <h2>media</h2>
          <p class="meta-desc">{W.media.desc}</p>
          <p class="meta-fields">{W.media.fields}</p>
        </div>
      </div>
      <div class="preview">
        <p class="preview-tag">{T.structure}</p>
        <Media kind="image" src={PLACEHOLDER_IMG} alt={placeholderLabel} caption={P.captionMain} aspect="16/9" />
        <p class="preview-tag mt">{T.inUse}</p>
        <Media kind="image" src={heroImgSrc} alt={R.mediaAlt} caption={R.mediaCaption} aspect="16/9" />
      </div>
    </section>

    {/* ─── pathway ─────────────────────────────────────────────── */}
    <section class="showcase">
      <div class="meta">
