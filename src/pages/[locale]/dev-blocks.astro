      </div>
      <div class="preview">
        <p class="preview-tag">{T.structure}</p>
        <Pathway
          heading={P.heading}
          groups={[1, 2, 3].map((n) => ({
            eyebrow: P.groupEyebrow(String(n)),
            title: P.group(String(n)),
            items: [1, 2, 3].map((k) => ({ name: P.chip(String(k)), href: "/#" })),
          }))}
          locale={locale}
        />
        <p class="preview-tag mt">{T.inUse}</p>
        <Pathway heading={R.pathwayHeading} groups={R.pathwayGroups} locale={locale} />
      </div>
    </section>

    {/* ─── row ─────────────────────────────────────────────────── */}
