<BaseLayout title={T.title + " (dev only)"} description="Temp preview page">
  <div class="wrap">
    <header class="hd">
      <p class="hd-eyebrow">{T.eyebrow}</p>
      <h1>{T.title}</h1>
      <p class="lede">{T.lede}</p>
    </header>

    {/* ─── prose ───────────────────────────────────────────────── */}
    <section class="showcase">
      <div class="meta">
        <p class="meta-code">{num(1)}</p>
        <div>
          <h2>prose</h2>
          <p class="meta-desc">{W.prose.desc}</p>
          <p class="meta-fields">{W.prose.fields}</p>
        </div>
      </div>
      <div class="preview">
        <p class="preview-tag">{T.structure}</p>
        <Prose heading={P.proseHeading} body={P.proseBody} locale={locale} />
        <p class="preview-tag mt">{T.inUse}</p>
        <Prose heading={R.proseHeading} body={R.proseBody} locale={locale} />
      </div>
    </section>

    {/* ─── highlights ──────────────────────────────────────────── */}
    <section class="showcase">
      <div class="meta">
        <p class="meta-code">{num(2)}</p>
        <div>
          <h2>highlights</h2>
          <p class="meta-desc">{W.highlights.desc}</p>
          <p class="meta-fields">{W.highlights.fields}</p>
        </div>
      </div>
      <div class="preview">
        <p class="preview-tag">{T.structure}</p>
        <Highlights items={[1, 2, 3].map((n) => ({ label: P.label(n), value: P.value(n) }))} locale={locale} />
        <p class="preview-tag mt">{T.inUse}</p>
        <Highlights items={R.highlights} locale={locale} />
      </div>
    </section>

    {/* ─── stats ───────────────────────────────────────────────── */}
    <section class="showcase">
      <div class="meta">
        <p class="meta-code">{num(3)}</p>
        <div>
          <h2>stats</h2>
          <p class="meta-desc">{W.stats.desc}</p>
          <p class="meta-fields">{W.stats.fields}</p>
        </div>
      </div>
      <div class="preview">
        <p class="preview-tag">{T.structure}</p>
        <Stats
          heading={P.heading}
          items={[1, 2, 3, 4].map((n) => ({ value: isAr ? `٠${n}` : String(n).padStart(2, "0"), label: P.label(n) }))}
        />
        <p class="preview-tag mt">{T.inUse}</p>
        <Stats heading={R.statsHeading} items={R.stats} />
      </div>
    </section>

    {/* ─── facts ───────────────────────────────────────────────── */}
