      <div class="meta">
        <p class="meta-code">{num(4)}</p>
        <div>
          <h2>facts</h2>
          <p class="meta-desc">{W.facts.desc}</p>
          <p class="meta-fields">{W.facts.fields}</p>
        </div>
      </div>
      <div class="preview">
        <p class="preview-tag">{T.structure}</p>
        <Facts
          heading={P.heading}
          items={[isAr ? "١" : "one", isAr ? "٢" : "two", isAr ? "٣" : "three"].map(P.factItem)}
