    <rect fill='#f4f7f8' width='400' height='300'/>
    <text x='200' y='150' fill='#77858c' font-family='monospace' font-size='16' letter-spacing='2' text-anchor='middle' dominant-baseline='middle'>${placeholderLabel}</text>
