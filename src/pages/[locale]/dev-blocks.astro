<style>
  .wrap {
    max-width: 1240px;
    margin: 40px auto 120px;
    padding: 0 24px;
    font-family: var(--font-body);
  }
  .hd { margin-bottom: 56px; }
  .hd-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 12px;
  }
  :global(html[dir="rtl"]) .hd-eyebrow {
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 13px;
  }
  .hd h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(32px, 4vw, 44px);
    margin: 0 0 16px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  :global(html[dir="rtl"]) .hd h1 { font-weight: 700; letter-spacing: 0; }
  .hd .lede { font-size: 17px; line-height: 1.65; color: var(--body); margin: 0; max-width: 62ch; }
  :global(html[dir="rtl"]) .hd .lede { line-height: 1.95; }

  .showcase {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 32px;
    padding: 40px 0;
    border-top: 1px dashed var(--line-strong);
    align-items: start;
  }
  .meta { position: sticky; top: 88px; display: flex; gap: 12px; align-items: flex-start; }
  .meta-code {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    margin: 4px 0 0;
    letter-spacing: 0.06em;
  }
  .meta h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 22px;
    margin: 0;
    color: var(--ink);
  }
  :global(html[dir="rtl"]) .meta h2 { font-weight: 700; letter-spacing: 0; }
  .meta h2 em { font-style: normal; color: var(--muted); font-size: 15px; font-family: var(--font-mono); margin-left: 6px; }
  .meta-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--body);
    margin: 8px 0 6px;
  }
  :global(html[dir="rtl"]) .meta-desc { line-height: 1.85; }
  .meta-fields {
    font-size: 12.5px;
    color: var(--muted);
    margin: 0;
    line-height: 1.6;
  }
  :global(html[dir="rtl"]) .meta-fields { line-height: 1.85; }
  .preview { min-width: 0; }

  .preview-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 14px;
    padding-bottom: 4px;
    border-bottom: 1px dashed var(--line-strong);
  }
  :global(html[dir="rtl"]) .preview-tag {
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 12px;
  }
  .mt { margin-top: 40px; }

  @media (max-width: 640px) {
    .showcase { grid-template-columns: 1fr; gap: 20px; }
    .meta { position: static; }
  }
</style>
