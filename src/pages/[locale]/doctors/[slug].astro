---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CvHero from "../../../components/doctor/CvHero.astro";
import Sections from "../../../components/blocks/Sections.astro";
import { topicOf, isLocale, pickForLocale, currentLocale } from "../../../lib/i18n";
import { physician } from "../../../lib/schema";

export async function getStaticPaths() {
  const items = await getCollection("doctors");
  const topics = Array.from(new Set(items.map((e) => topicOf(e.id))));

  const enPaths = items
    .filter((e) => isLocale(e.id, "en"))
    .map((entry) => ({
      params: { locale: "en", slug: topicOf(entry.id) },
      props: { entry },
    }));

  const arPaths = topics.flatMap((topic) => {
    const pick = pickForLocale(items, topic, "ar");
    return pick ? [{ params: { locale: "ar", slug: topic }, props: { entry: pick.entry } }] : [];
  });

  return [...enPaths, ...arPaths];
}

const { entry } = Astro.props;
const locale = currentLocale(Astro);
const isAr = locale === "ar";

// Every doctor page is a `sections`-driven CV. See src/components/doctor/
// for the block components and src/content.config.ts for the schema.
const sections = entry.data.sections ?? [];

// Page title falls back on the doctor's `fullName`; the hero block (cv_hero)
// may override the on-page h1 via its `headline` field for localized display.
const titleSuffix = isAr ? "مركز العمران الطبي" : "Alimran Clinic";

// LCP preload: same srcset derivation the CvHero component uses so the
// browser starts fetching the portrait before parsing the body.
const webpBase = (entry.data.photo as string | undefined)?.replace(/\.(jpg|jpeg|png)$/i, "");
const heroPreload = webpBase ? {
  srcset: `${webpBase}-480.webp 480w, ${webpBase}-800.webp 800w, ${webpBase}-1200.webp 1200w`,
  sizes: "(min-width: 720px) 40vw, 100vw",
  type: "image/webp",
} : undefined;
---

<BaseLayout
  title={`${entry.data.fullName} — ${titleSuffix}`}
  description={entry.data.description}
  heroPreload={heroPreload}
>
  <script type="application/ld+json" set:html={JSON.stringify(physician({
    url: new URL(Astro.url.pathname, Astro.site),
    name: entry.data.fullName,
    description: entry.data.description,
    specialty: entry.data.specialty,
    image: entry.data.photo,
    locale,
  }))} />
  <CvHero
    eyebrow={entry.data.heroEyebrow}
    headline={entry.data.heroHeadline ?? entry.data.fullName}
    lede={entry.data.heroLede}
    chips={entry.data.titles}
    portrait={entry.data.photo}
    portraitAlt={entry.data.photoAlt ?? entry.data.fullName}
  />
  <div class="cv-sections">
    <Sections sections={sections} locale={locale} />
  </div>
</BaseLayout>

<style>
  /* Stats block has no self-constraining padding — it relies on an article
     container that doesn't exist on doctor pages. Pin it to match CvHero
     and the list blocks (.reg-section uses the same values). */
  .cv-sections :global(.stats-block) {
    max-width: var(--page-max);
    margin-left: auto;
    margin-right: auto;
    padding-left: 24px;
    padding-right: 24px;
  }
</style>
