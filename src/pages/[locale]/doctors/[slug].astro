---
/**
 * Doctor detail page — thin loader. The hero, CV sections, memberships
 * and publications all live in src/content/doctors/<slug>/{en,ar}.md as
 * block sections, rendered through PlainTemplate (same template as home
 * + about). The only doctor-specific thing this route still does is
 * emit the Physician JSON-LD and preload the portrait image for LCP.
 */
import { getCollection } from "astro:content";
import { topicOf, isLocale, pickForLocale, currentLocale } from "../../../lib/i18n";
import { physician } from "../../../lib/schema";
import { imageVariants } from "../../../lib/image";
import PlainTemplate from "../../../components/templates/PlainTemplate.astro";

export async function getStaticPaths() {
  const items = await getCollection("doctors");
  const topics = Array.from(new Set(items.map((e) => topicOf(e.id))));

  const enPaths = items
    .filter((e) => isLocale(e.id, "en"))
    .map((entry) => ({
      params: { locale: "en", slug: topicOf(entry.id) },
      props: { entry },
    }));

  const arPaths = topics.flatMap((topic) => {
    const pick = pickForLocale(items, topic, "ar");
    return pick ? [{ params: { locale: "ar", slug: topic }, props: { entry: pick.entry } }] : [];
  });

  return [...enPaths, ...arPaths];
}

const { entry } = Astro.props;
const locale = currentLocale(Astro);
const isAr = locale === "ar";

const sections = entry.data.sections ?? [];
const titleSuffix = isAr ? "مركز العمران الطبي" : "Alimran Clinic";

// Preload the portrait (sits at the start of the hero row's media block)
// so the LCP fetch starts during HTML parse.
const heroImg = imageVariants(entry.data.photo as string | undefined);
const heroPreload = heroImg?.srcset ? {
  srcset: heroImg.srcset,
  sizes: "(min-width: 720px) 40vw, 100vw",
  type: "image/webp",
} : undefined;

const jsonLd = physician({
  url: new URL(Astro.url.pathname, Astro.site),
  name: entry.data.fullName,
  description: entry.data.description,
  specialty: entry.data.specialty,
  image: entry.data.photo,
  locale,
});
---

<PlainTemplate
  title={`${entry.data.fullName} — ${titleSuffix}`}
  description={entry.data.description}
  sections={sections}
  locale={locale}
  heroPreload={heroPreload}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</PlainTemplate>
