---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { currentLocale } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);

const T = locale === "ar" ? {
  title:       "تابع مجمع العمران على Google — مركز العمران الطبي",
  description: "أضف مركز العمران الطبي إلى مصادرك المفضلة على Google وابقَ على اطلاع دائم بأحدث مقالاتنا الصحية.",
  h1:          "تابع مجمع العمران على Google",
  body:        "أضِف مجمعنا الطبي إلى مصادرك المفضلة على Google — ستظهر مقالاتنا الصحية ومستجداتنا في مقدمة نتائج بحثك.",
  btnLabel:    "إضافة إلى مصادري المفضلة",
  homeLabel:   "العودة إلى الموقع",
  homeHref:    "/ar/",
  psLang:      "ar",
} : {
  title:       "Follow Al-Imran on Google — Alimran Medical Center",
  description: "Add Alimran Medical Center to your Google Preferred Sources and stay up to date with our health articles.",
  h1:          "Follow Al-Imran on Google",
  body:        "Add us to your Google Preferred Sources — our health articles and clinic updates will appear first when you search Google.",
  btnLabel:    "Add to my preferred sources",
  homeLabel:   "Return to the site",
  homeHref:    "/en/",
  psLang:      "en",
};
---

<BaseLayout title={T.title} description={T.description} noindex>
  <Fragment slot="head">
    <script async preferred-sources-control="manual" src="https://news.google.com/swg/js/v1/publisher.js" is:inline></script>
  </Fragment>

  <div class="container page">
    <div class="follow-card">
      <div class="google-label" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Google
      </div>

      <h1>{T.h1}</h1>
      <p>{T.body}</p>

      <button id="follow-btn" class="follow-btn" type="button">
        {T.btnLabel}
      </button>

      <a class="home-link" href={T.homeHref}>{T.homeLabel}</a>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ psLang: T.psLang }}>
(function () {
  var FALLBACK = 'https://www.google.com/preferences/source?q=alimran.clinic';
  var psReady = false;

  var timer = setTimeout(function () {
    if (psReady) return;
    var btn = document.getElementById('follow-btn');
    if (!btn) return;
    var a = document.createElement('a');
    a.href = FALLBACK;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.className = btn.className;
    a.textContent = btn.textContent;
    a.id = 'follow-btn';
    btn.parentNode.replaceChild(a, btn);
  }, 4000);

  (self.PREFERRED_SOURCE = self.PREFERRED_SOURCE || []).push(function (ps) {
    psReady = true;
    clearTimeout(timer);
    ps.init({ theme: 'light', lang: psLang });
    var btn = document.getElementById('follow-btn');
    if (btn) {
      btn.addEventListener('click', function () {
        ps.addPreferredSource();
      });
    }
  });
})();
</script>

<style>
  .page {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: clamp(48px, 8vw, 96px);
    min-height: 60vh;
  }

  .follow-card {
    max-width: 520px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    padding: clamp(32px, 5vw, 56px) clamp(24px, 5vw, 48px);
    border: 1px solid var(--line);
  }

  .google-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  html[dir="rtl"] .google-label {
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 12px;
  }

  .follow-card h1 {
    font-size: clamp(24px, 4.5vw, 38px);
    margin: 0;
  }

  .follow-card p {
    color: var(--body);
    font-size: clamp(15px, 2.2vw, 17px);
    max-width: 42ch;
    margin: 0;
  }

  .follow-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2rem;
    min-height: 56px;
    width: 100%;
    max-width: 360px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .follow-btn:hover,
  .follow-btn:focus-visible {
    background: var(--accent-hover);
    color: #fff;
    text-decoration: none;
  }

  .follow-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .home-link {
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }

  .home-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
