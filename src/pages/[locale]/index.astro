---
/**
 * Home page — now a thin loader that renders src/content/pages/home/{en,ar}.md
 * through the shared Sections dispatcher. All editable content (hero copy,
 * stats, departments, pathways, facility labels, consultant bio, referral
 * strip) lives in those two Markdown files and is editable through the CMS.
 *
 * Preloads the hero portrait so Largest Contentful Paint stays fast.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { currentLocale } from "../../lib/i18n";
import { imageVariants } from "../../lib/image";
import Sections from "../../components/blocks/Sections.astro";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);

// Load the home page content for this locale. If the Arabic file ever goes
// missing, Astro returns undefined — we silently fall back to the English
// version so the site keeps rendering.
const entry =
  (await getEntry("pages", `home/${locale}`)) ??
  (await getEntry("pages", "home/en"));

const sections = (entry?.data as { sections?: any[] } | undefined)?.sections ?? [];

// Hero image is the first image we can find in a `media` block anywhere in
// the first section tree — used for the LCP preload hint. Shallow scan is
// enough since the hero is always the first row.
function findFirstImageSrc(nodes: any[] | undefined): string | undefined {
  if (!nodes) return undefined;
  for (const n of nodes) {
    if (!n || typeof n !== "object") continue;
    if (n.type === "media" && Array.isArray(n.items)) {
      const img = n.items.find((it: any) => it?.kind === "image" && typeof it.src === "string");
      if (img) return img.src as string;
    }
    if (Array.isArray(n.items)) {
      const found = findFirstImageSrc(n.items);
      if (found) return found;
    }
  }
  return undefined;
}

const heroSource = findFirstImageSrc(sections);
const heroImg = heroSource ? imageVariants(heroSource) : null;

const title = (entry?.data as { title?: string } | undefined)?.title ?? "Alimran Clinic";
const description = (entry?.data as { description?: string } | undefined)?.description ?? "";
---

<BaseLayout
  title={title}
  description={description}
  heroPreload={heroImg?.srcset ? {
    srcset: heroImg.srcset,
    sizes: "(min-width: 980px) 50vw, 100vw",
    type: "image/webp",
  } : undefined}
>
  <div class="home-wrap">
    <Sections sections={sections} locale={locale} />
  </div>

  <div class="tail-space" aria-hidden="true"></div>
</BaseLayout>

<style>
  .home-wrap {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Collapse the leading top margin that block widgets add by default —
     the hero should start at the top of the page without a double gap. */
  .home-wrap > :global(section:first-child),
  .home-wrap > :global(section.row-block:first-child) { margin-top: 0; }

  .tail-space { height: clamp(56px, 7vw, 96px); }
</style>
