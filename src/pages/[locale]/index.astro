---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACT } from "../../consts";
import { localizedHref, currentLocale } from "../../lib/i18n";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);
const callHref = `tel:${CONTACT.phones[0].replace(/\s/g, "")}`;
const secondCallHref = `tel:${CONTACT.phones[1].replace(/\s/g, "")}`;
const cvHref = L("/doctors/hussein-imran-mousa/");
const conditionsHref = L("/conditions/");

const stats = isAr ? [
  { fig: "+٥٠٠٠", desc: "عملية أجراها الاستشاري بشكل مستقل" },
  { fig: "٢٥",    desc: "عامًا من الخبرة في جراحة الجهاز العصبي" },
  { fig: "٤",     desc: "أقسام — الجراحة، إدارة الألم، العلاج الطبيعي، إعادة التأهيل" },
  { fig: "٦",     desc: "أيام عمل أسبوعيًا، مع مناوبة للحالات الطارئة" },
] : [
  { fig: "5,000+", desc: "Operations performed by the lead consultant" },
  { fig: "25",     desc: "Years of neurosurgical practice behind the clinic" },
  { fig: "4",      desc: "Departments — surgery, pain medicine, physiotherapy, rehabilitation" },
  { fig: "6",      desc: "Clinic days a week, including an out-of-hours on-call roster" },
];

const services = isAr ? [
  { title: "الجراحة",
    desc: "جراحة مفتوحة ومنظارية للدماغ والعمود الفقري، وتشمل الرضوح والأورام.",
    items: ["تثقيب الجمجمة", "مايكرودسك", "تثبيت الفقرات واستئصال القرص المنزلق", "استبدال القرص الاصطناعي", "العمليات المنظارية"],
    reading: [
      { slug: "what-is-an-intrathecal-pump", title: "المضخة داخل القراب" },
      { slug: "spin-med",                    title: "SpineMED لتخفيف ضغط العمود الفقري" },
    ] },
  { title: "إدارة الألم",
    desc: "حقن وكيّ موجَّه بالتصوير للألم الذي لم يستجب للأدوية.",
    items: ["الترددات الراديوية", "حقن فوق الجافية والمفاصل الفقرية", "تخدير العُقد الودّية", "حقن الستيرويد", "البوتوكس لعلاج الصداع"],
    reading: [
      { slug: "tension-headaches",  title: "صداع التوتر — الأسباب والعلاج" },
      { slug: "tms-pain", href: "/services/brain-stimulation/tms-pain/", title: "TMS للألم المزمن" },
      { slug: "arthritis",          title: "التهاب المفاصل — خيارات العلاج" },
    ] },
  { title: "تحفيز الدماغ والأعصاب",
    desc: "إجراءات تجسيمية ووظيفية لاضطرابات الحركة والألم المستعصي.",
    items: ["التحفيز العميق للدماغ", "قسطرة وتحفيز الحبل الشوكي", "المضخة داخل القراب", "قطع الجذور الظهرية الانتقائي", "التحفيز المغناطيسي عبر الجمجمة"],
    reading: [
      { slug: "transcranial-magnetic-stimulation",            title: "التحفيز المغناطيسي عبر الجمجمة (TMS)" },
      { slug: "transcranial-direct-current-stimulation-tdcs", title: "التحفيز الكهربائي عبر الجمجمة (tDCS)" },
      { slug: "tms-for-neuropsychiatric-disorders",           title: "TMS للاضطرابات النفسية العصبية" },
    ] },
  { title: "إعادة التأهيل والعلاج الطبيعي",
    desc: "تأهيل يبدأ في الردهة ويستمر في المركز بعد الخروج.",
    items: ["العلاج الطبيعي", "التأهيل بعد الجراحة", "الطب التجديدي", "العلاج بالأوزون", "تمارين ولياقة تحت الإشراف"],
    reading: [
      { slug: "physiotherapy",                     title: "العلاج الطبيعي — ماذا يعالج" },
      { slug: "vasotrain-or-air-pressure-massage", title: "Vasotrain — تدليك بالضغط" },
      { slug: "achilles-tendinitis",               title: "التهاب وتر أخيل — التعافي" },
    ] },
] : [
  { title: "Neurosurgery",
    desc: "Open and endoscopic surgery of the brain and spine, including trauma and tumour work.",
    items: ["Burr holes & craniotomy", "Microdiscectomy", "Cervical discectomy & fusion", "Artificial disc replacement", "Spinal decompression"],
    reading: [
      { slug: "what-is-an-intrathecal-pump", title: "What is an intrathecal pump?" },
      { slug: "spin-med",                    title: "SpineMED spinal decompression" },
    ] },
  { title: "Interventional pain",
    desc: "Image-guided injections and ablation for pain that has not responded to medication.",
    items: ["Radiofrequency ablation", "Epidural & facet injections", "Sympathetic nerve blocks", "Steroid injections", "Botulinum toxin for headache"],
    reading: [
      { slug: "tension-headaches",  title: "Tension headaches — causes and management" },
      { slug: "tms-pain", href: "/services/brain-stimulation/tms-pain/", title: "TMS for chronic pain" },
      { slug: "arthritis",          title: "Arthritis — treatment options" },
    ] },
  { title: "Neuromodulation",
    desc: "Stereotactic and functional procedures for movement disorders and refractory pain.",
    items: ["Deep brain stimulation", "Spinal cord stimulation", "Intrathecal pump & catheter", "Selective dorsal rhizotomy", "Brain lesioning"],
    reading: [
      { slug: "transcranial-magnetic-stimulation",            title: "Transcranial magnetic stimulation (TMS)" },
      { slug: "transcranial-direct-current-stimulation-tdcs", title: "Transcranial direct current stimulation (tDCS)" },
      { slug: "tms-for-neuropsychiatric-disorders",           title: "TMS for neuropsychiatric disorders" },
    ] },
  { title: "Recovery & therapy",
    desc: "Rehabilitation that begins on the ward and continues in the clinic after discharge.",
    items: ["Physiotherapy", "Post-operative rehabilitation", "Regenerative medicine", "Ozone therapy", "Supervised exercise & fitness"],
    reading: [
      { slug: "physiotherapy",                     title: "Physiotherapy — what it treats" },
      { slug: "vasotrain-or-air-pressure-massage", title: "Vasotrain pressure massage" },
      { slug: "achilles-tendinitis",               title: "Achilles tendinitis recovery" },
    ] },
];

const pathways = isAr ? [
  { num: "المسار ٠١", title: "الدماغ", items: [
    { name: "أورام الدماغ",      slug: "brain-tumor" },
    { name: "الجلطة الدماغية",    slug: "stroke" },
    { name: "الصرع",              slug: "epilepsy-seizures" },
    { name: "إصابات الرأس",       slug: "head-injury" },
    { name: "داء باركنسون",       slug: "parkinsons-disease" },
    { name: "اضطرابات الحركة",    slug: "motor-disorders" },
  ] },
  { num: "المسار ٠٢", title: "العمود الفقري", items: [
    { name: "الديسك",               slug: "herniated-disc" },
    { name: "عرق النسا",            slug: "sciatica" },
    { name: "إصابات الحبل الشوكي",  slug: "spinal-cord-injury" },
    { name: "الجنف",                slug: "scoliosis" },
    { name: "الحدب",                slug: "kyphosis" },
    { name: "إصابة العنق",          slug: "whiplash" },
  ] },
  { num: "المسار ٠٣", title: "الألم", items: [
    { name: "الصداع المزمن",     slug: "headaches" },
    { name: "آلام الرقبة",        slug: "neck-pain" },
    { name: "آلام الظهر",         slug: "back-pain" },
    { name: "الكتف المتجمد",      slug: "frozen-shoulder" },
    { name: "آلام الركبة",        slug: "knee-pain" },
    { name: "آلام الأورام",       slug: "cancer-pain" },
  ] },
] : [
  { num: "PATHWAY 01", title: "Brain", items: [
    { name: "Brain tumour",         slug: "brain-tumor" },
    { name: "Stroke",               slug: "stroke" },
    { name: "Epilepsy",             slug: "epilepsy-seizures" },
    { name: "Head injury",          slug: "head-injury" },
    { name: "Parkinson's disease",  slug: "parkinsons-disease" },
    { name: "Motor disorders",      slug: "motor-disorders" },
  ] },
  { num: "PATHWAY 02", title: "Spine", items: [
    { name: "Herniated disc",       slug: "herniated-disc" },
    { name: "Sciatica",             slug: "sciatica" },
    { name: "Spinal cord injury",   slug: "spinal-cord-injury" },
    { name: "Scoliosis",            slug: "scoliosis" },
    { name: "Kyphosis",             slug: "kyphosis" },
    { name: "Whiplash",             slug: "whiplash" },
  ] },
  { num: "PATHWAY 03", title: "Pain", items: [
    { name: "Chronic headache",     slug: "headaches" },
    { name: "Neck pain",            slug: "neck-pain" },
    { name: "Back pain",            slug: "back-pain" },
    { name: "Frozen shoulder",      slug: "frozen-shoulder" },
    { name: "Knee pain",            slug: "knee-pain" },
    { name: "Cancer pain",          slug: "cancer-pain" },
  ] },
];

const facilities = isAr ? [
  { label: "الاستقبال",       sub: "صالة الانتظار" },
  { label: "غرفة الاستشارة",  sub: "الفحص ومراجعة الصور" },
  { label: "غرفة الإجراءات",  sub: "تخفيف الضغط عن العمود الفقري وتدخلات الألم",
    src: "/images/home/DSC_0054-1-1024x684.jpg",
    alt: "طاولة SpineMED لتخفيف الضغط عن العمود الفقري في مركز العمران" },
  { label: "قاعة التأهيل",    sub: "العلاج الطبيعي والتمارين" },
] : [
  { label: "RECEPTION",       sub: "waiting area" },
  { label: "CONSULTING ROOM", sub: "examination & imaging review" },
  { label: "PROCEDURE ROOM",  sub: "spinal decompression & interventional pain",
    src: "/images/home/DSC_0054-1-1024x684.jpg",
    alt: "SpineMED decompression table in the Alimran Clinic procedure room" },
  { label: "THERAPY GYM",     sub: "physiotherapy & rehabilitation" },
];

const insideFacts = isAr ? [
  { label: "العنوان",       value: "مجمّع النقبة الطبي، بريهة، البصرة، العراق" },
  { label: "أوقات العمل",   value: "السبت–الخميس ٩:٠٠–١٨:٠٠ · الجمعة ١٤:٠٠–١٨:٠٠" },
  { label: "العمليات",      value: "مستشفى الصدر التعليمي، البصرة" },
  { label: "حالات الأورام", value: "تُراجع في مركز البصرة التخصصي للأورام" },
] : [
  { label: "Address",        value: "Alnkba Medical Collection, Breaha, Basra, Iraq" },
  { label: "Clinic hours",   value: "Sat–Thu 09:00–18:00 · Fri 14:00–18:00" },
  { label: "Surgery",        value: "Alsadr Teaching Hospital, Basra" },
  { label: "Oncology cases", value: "Seen at the Basra Specialised Oncology Centre" },
];

const consultantFacts = isAr ? [
  { label: "الزمالات", value: "مستشفى جامعة سيؤول الوطنية؛ عيادة موبي للألم، مومباي" },
  { label: "العضويات", value: "AANS وNASS وAOSpine وIASP وخمس جمعيات أخرى" },
  { label: "التدريس",  value: "مشرف على أطباء البورد العربي في جراحة الأعصاب منذ ٢٠١٦" },
  { label: "البحوث",   value: "خمسة بحوث محكّمة، ومشاركات في يوكوهاما ودبي وتامبا" },
] : [
  { label: "Fellowships", value: "Seoul National University Hospital; Mobi Pain Clinic, Mumbai" },
  { label: "Societies",   value: "AANS, NASS, AOSpine, IASP and five others" },
  { label: "Teaching",    value: "Supervisor of Arabian Board neurosurgery trainees since 2016" },
  { label: "Research",    value: "Five peer-reviewed papers; presentations in Yokohama, Dubai and Tampa" },
];

const T = isAr ? {
  title:              "مركز العمران الطبي — جراحة الأعصاب وطب الألم، البصرة",
  description:        "يعالج مركز العمران الطبي أمراض الدماغ والعمود الفقري والألم المزمن، بأربعة أقسام تعمل انطلاقًا من تقييم واحد.",
  heroEyebrow:        "مركز العمران الطبي — البصرة، العراق",
  heroH1:             "مركز واحد يجمع التشخيص والجراحة وإعادة التأهيل.",
  heroP1:             "يعالج مركز العمران الطبي أمراض الدماغ والعمود الفقري والألم المزمن، بأربعة أقسام تعمل انطلاقًا من تقييم واحد، فلا يُحال المريض بين خدمات غير مترابطة.",
  heroP2:             "جراحة الأعصاب · إدارة الألم · تحفيز الدماغ والأعصاب · العلاج الطبيعي وإعادة التأهيل.",
  conditionsLabel:    "ما نعالج",
  callLabel:          "اتصل بالسكرتارية",
  heroImgAlt:         "الدكتور حسين عمران موسى، استشاري جراحة الأعصاب",
  doctorImgAlt:       "حسين عمران موسى",
  creditLedBy:        "بإشراف",
  creditName:         "الدكتور حسين عمران موسى",
  creditSep:          "، ",
  creditTitle:        "استشاري جراحة الجهاز العصبي",
  creditCV:           "بورد عربي وعراقي في جراحة الأعصاب — السيرة الكاملة ←",
  s01Num:             "٠١",
  s01Head:            "الرعاية تحت سقف واحد",
  s01Lede:            "التشخيص والجراحة والتدخل لعلاج الألم وإعادة التأهيل يقدّمها فريق واحد، فلا ينتقل المريض بين خدمات متفرقة بين صورة الرنين والعودة إلى عمله.",
  readingLabel:       "قراءة ذات صلة",
  s02Num:             "٠٢",
  s02Head:            "ما نعالج",
  conditionsAllLink:  "كل الحالات والإجراء المستخدم لها ←",
  s03Num:             "٠٣",
  s03Head:            "داخل المركز",
  insideBody:         "يقع المركز في مجمّع النقبة الطبي في بريهة بالبصرة، على مقربة من مستشفى الصدر التعليمي حيث تُجرى العمليات. الاستشارة الخارجية وإجراءات الألم اليومية والعلاج بعد الجراحة كلها في موقع المركز.",
  directionsLabel:    "الموقع على الخريطة",
  reviewsLink:        "اقرأ آراء مرضانا على Google ←",
  s04Num:             "٠٤",
  s04Head:            "الاستشاري المسؤول",
  consultantName:     "الدكتور حسين عمران موسى",
  consultantQuals:    "بكالوريوس طب وجراحة · زمالة البورد العراقي في جراحة الجهاز العصبي",
  consultantBody:     "استشاري جراحة الجهاز العصبي في مستشفى الصدر التعليمي، ومدير العراق في جمعية الشرق الأوسط للجراحة التجسيمية والوظيفية، مع زمالات في طب الألم التداخلي في سيؤول ومومباي.",
  cvFullLink:         "السيرة العلمية والبحوث والتدريب ←",
  referralEyebrow:    "للأطباء المحوِّلين",
  referralBody:       "يُرجى إرسال الصور الشعاعية وملخص الحالة إلى المركز قبل الموعد. تُصنَّف الحالات العاجلة من قبل السكرتارية في اليوم نفسه، ويُرسل تقرير الخطة إلى الطبيب المحوِّل بعد الاستشارة.",
  secretaryLabel:     "السكرتارية",
  emailLabel:         "التحويل بالبريد الإلكتروني",
} : {
  title:              "Alimran Clinic — Neurosurgery & Pain Medicine, Basra",
  description:        "Alimran Clinic in Basra — specialist care for brain, spine and chronic pain disorders under one consultant-led team.",
  heroEyebrow:        "Alimran Clinic — Basra, Iraq",
  heroH1:             "A clinic where the scan, the operation and the recovery happen in one place.",
  heroP1:             "Alimran Clinic treats disorders of the brain, the spine and chronic pain — four departments working from one assessment, so patients are not sent between unconnected services.",
  heroP2:             "Neurosurgery · Interventional pain · Neuromodulation · Physiotherapy and rehabilitation.",
  conditionsLabel:    "What we treat",
  callLabel:          "Call the secretary",
  heroImgAlt:         "Dr Hussein Imran Mousa, consultant neurosurgeon",
  doctorImgAlt:       "Hussein Imran Mousa",
  creditLedBy:        "Led by",
  creditName:         "Hussein Imran Mousa",
  creditSep:          ", ",
  creditTitle:        "consultant neurosurgeon",
  creditCV:           "MBChB · FIBMS (Neurosurgery) — full CV →",
  s01Num:             "01",
  s01Head:            "Care under one roof",
  s01Lede:            "Diagnosis, surgery, pain intervention and recovery are delivered by one team, so a patient is not passed between unconnected services between the scan and the return to work.",
  readingLabel:       "Related reading",
  s02Num:             "02",
  s02Head:            "Conditions we treat",
  conditionsAllLink:  "Every condition, and the procedure used for it →",
  s03Num:             "03",
  s03Head:            "Inside the clinic",
  insideBody:         "The clinic sits within the Alnkba medical collection in Breaha, Basra, minutes from Alsadr Teaching Hospital, where the surgical lists are held. Outpatient assessment, day-case pain procedures and post-operative therapy all take place on site.",
  directionsLabel:    "Directions on the map",
  reviewsLink:        "Read our Google reviews →",
  s04Num:             "04",
  s04Head:            "The lead consultant",
  consultantName:     "Hussein Imran Mousa",
  consultantQuals:    "MBChB · FIBMS (Neurosurgery) · FIAANS",
  consultantBody:     "Consultant neurosurgeon at Alsadr Teaching Hospital and Iraq Director for Middle East Stereotactic and Functional Neurosurgery, with fellowship training in interventional pain medicine in Seoul and Mumbai.",
  cvFullLink:         "Full CV, publications and training →",
  referralEyebrow:    "For referring clinicians",
  referralBody:       "Send imaging and a clinical summary to the clinic ahead of the appointment. Urgent cases are triaged by the secretary the same working day, and a written plan goes back to the referrer after the consultation.",
  secretaryLabel:     "Secretary",
  emailLabel:         "Referrals by email",
