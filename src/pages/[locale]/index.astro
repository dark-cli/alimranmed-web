---

<BaseLayout title={T.title} description={T.description}>
  <!-- ─── HERO ───────────────────────────────────────────────── -->
  <section class="hero-band">
    <div class="container hero">
    <div class="hero-text">
      <div class="hero-text-inner">
        <p class="hero-eyebrow">{T.heroEyebrow}</p>
        <h1 class="hero-h1">{T.heroH1}</h1>
        <p class="hero-p">{T.heroP1}</p>
        <p class="hero-p">{T.heroP2}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={conditionsHref}>{T.conditionsLabel}</a>
          <a class="btn btn-secondary" href={callHref}>{T.callLabel}</a>
        </div>

        <div class="hero-credit">
          <img
            class="hero-avatar"
            src="/images/doctors/hussein-imran-mousa-avatar.webp"
            alt={T.doctorImgAlt}
            width="52" height="52"
          />
          <div class="hero-credit-body">
            <p>{T.creditLedBy} <strong>{T.creditName}</strong>{T.creditSep}{T.creditTitle}</p>
            <a class="hero-credit-link" href={cvHref}>{T.creditCV}</a>
          </div>
        </div>
      </div>
    </div>
    <img
      class="hero-photo hero-photo-img"
      src="/images/doctors/hussein-imran-mousa-portrait.jpg"
      alt={T.heroImgAlt}
      width="831" height="866"
      loading="eager"
      fetchpriority="high"
    />
    </div>
  </section>

  <!-- ─── STAT BAND ──────────────────────────────────────────── -->
  <section class="stats">
    <div class="stats-grid">
      {stats.map((s) => (
        <div class="stat-cell">
          <p class="stat-fig">{s.fig}</p>
          <p class="stat-desc">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── 01 CARE UNDER ONE ROOF ─────────────────────────────── -->
  <section class="pg-section">
    <header class="pg-head">
      <span class="pg-num">{T.s01Num}</span>
      <h2 class="pg-h2">{T.s01Head}</h2>
    </header>
    <p class="pg-lede">{T.s01Lede}</p>
    <div class="care-grid">
      {services.map((s) => (
        <article class="care-cell">
          <p class="care-title">{s.title}</p>
          <p class="care-desc">{s.desc}</p>
          <ul class="care-list">
            {s.items.map((i) => <li>{i}</li>)}
          </ul>
          {s.reading && s.reading.length > 0 && (
            <div class="care-reading">
              <p class="care-reading-label">{T.readingLabel}</p>
              <ul class="care-reading-list">
                {s.reading.map((r) => (
                  <li><a href={L((r as { href?: string }).href ?? `/blog/${r.slug}/`)}>{r.title}</a></li>
                ))}
              </ul>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- ─── 02 CONDITIONS WE TREAT ─────────────────────────────── -->
  <section class="pg-section">
    <header class="pg-head">
      <span class="pg-num">{T.s02Num}</span>
      <h2 class="pg-h2">{T.s02Head}</h2>
    </header>
    <div class="pathways">
      {pathways.map((p) => (
        <div class="pathway">
          <div class="pathway-head">
            <span class="pathway-num">{p.num}</span>
            <h3 class="pathway-name">{p.title}</h3>
          </div>
          <div class="chips">
            {p.items.map((c) => (
              <a class="chip" href={L(`/treatments/${c.slug}/`)}>{c.name}</a>
            ))}
          </div>
        </div>
      ))}
    </div>
