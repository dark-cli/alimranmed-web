---
/**
 * Home page — thin loader. Reads src/content/{en,ar}.md and renders
 * through the shared PlainTemplate. All editable content lives in those
 * two Markdown files (the `home` collection); layout is in
 * src/components/templates/PlainTemplate.astro.
 */
import { getEntry } from "astro:content";
import { currentLocale } from "../../lib/i18n";
import { heroPreloadFromSections } from "../../lib/pages";
import PlainTemplate from "../../components/templates/PlainTemplate.astro";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);

// Load the home page for this locale, with an English fallback so the
// site keeps rendering if the Arabic file is ever missing.
const entry =
  (await getEntry("home", locale)) ??
  (await getEntry("home", "en"));

const data = (entry?.data ?? {}) as {
  title?: string;
  description?: string;
  sections?: any[];
};
const sections = data.sections ?? [];
---

<PlainTemplate
  title={data.title ?? "Alimran Clinic"}
  description={data.description ?? ""}
  sections={sections}
  locale={locale}
  heroPreload={heroPreloadFromSections(sections)}
/>
