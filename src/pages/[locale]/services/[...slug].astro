---
import { getCollection, render } from "astro:content";
import { topicOf, isLocale, pickForLocale, localizedHref, currentLocale } from "../../../lib/i18n";
import { wordsIn, articleReadingLabel } from "../../../lib/word-count";
import { buildToc } from "../../../lib/toc";
import { excerpt } from "../../../lib/excerpt";
import { procedurePage, faqPage } from "../../../lib/schema";
import { SERVICE_LABELS, NAV_LABELS } from "../../../lib/labels";
import ArticleLayout from "../../../components/article/ArticleLayout.astro";
import ArticleBody from "../../../components/article/ArticleBody.astro";
import TranslationBanner from "../../../components/TranslationBanner.astro";

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);
const nav = NAV_LABELS[locale];
const labels = SERVICE_LABELS[locale];

export async function getStaticPaths() {
  const items = await getCollection("services");
  const paths: Array<{ params: { locale: string; slug: string }; props: any }> = [];

  for (const entry of items.filter((e) => isLocale(e.id, "en"))) {
    paths.push({
      params: { locale: "en", slug: topicOf(entry.id) },
      props: { entry, fallback: false },
    });
  }

  const topics = [...new Set(items.map((e) => topicOf(e.id)))];
  for (const topic of topics) {
    const pick = pickForLocale(items, topic, "ar");
    if (pick) paths.push({ params: { locale: "ar", slug: topic }, props: pick });
  }

  return paths;
}

const { entry, fallback } = Astro.props as { entry: any; fallback?: boolean };
const isRedesigned = entry.data.redesigned === true;
const showBanner = fallback && locale === "ar";
const { Content, headings } = await render(entry);

const wordCount =
  wordsIn((entry.data as { sections?: unknown }).sections) +
  wordsIn(entry.body);
const readingLabel = articleReadingLabel(wordCount, locale);

const publishedAt: unknown = (entry.data as { publishedAt?: unknown }).publishedAt
  || (entry.data as { updated?: unknown }).updated;
const dateLocale = locale === "ar" ? "ar-IQ" : "en-US";
const lastReviewed = publishedAt
  ? new Date(publishedAt as string).toLocaleDateString(dateLocale, { month: "long", year: "numeric" })
  : "—";

const toc = buildToc(
  isRedesigned ? (entry.data as { sections?: Array<{ heading?: string }> }).sections : null,
  headings,
  locale,
);

const standfirst = entry.data.description || "";
const metaDescription = standfirst || excerpt(entry.body);
const serviceCategory = entry.data.category || (locale === "ar" ? "خدمة" : "Service");
---

<ArticleLayout
  pageTitle={`${entry.data.title} — ${nav.siteName}`}
  description={metaDescription}
  schema={[
    procedurePage({
      url: new URL(Astro.url.pathname, Astro.site),
      name: entry.data.title,
      description: metaDescription,
      locale,
      datePublished: (entry.data as { publishedAt?: Date }).publishedAt,
      reviewedBy: (entry.data as { reviewedBy?: string }).reviewedBy,
      reviewedAt: (entry.data as { reviewedAt?: Date }).reviewedAt,
    }),
    faqPage((entry.data as { faqItems?: Array<{ question: string; answer: string }> }).faqItems),
  ]}
  locale={locale}
  breadcrumbs={[
    { label: nav.home, href: L("/") },
    { label: nav.services, href: L("/services/") },
    { label: serviceCategory },
  ]}
  h1={entry.data.title}
  meta={[
    { label: labels.pathwayLabel,      value: serviceCategory },
    { label: labels.reviewedByLabel,   value: labels.reviewer },
    { label: labels.readingTimeLabel,  value: readingLabel },
    ...(lastReviewed !== "—" ? [{ label: labels.lastReviewedLabel, value: lastReviewed }] : []),
  ]}
  toc={toc}
  tocLabel={labels.tocLabel}
  callLabel={labels.callLabel}
  callBody={labels.callBody}
  ctaHeading={labels.ctaHeading}
  ctaBody={labels.ctaBody}
  disclaimer={labels.disclaimer}
>
  {showBanner && <TranslationBanner fromLocale="en" toLocale="ar" />}
  <ArticleBody
    sections={isRedesigned ? (entry.data as any).sections : undefined}
    locale={locale}
  >
    <Content />
  </ArticleBody>
</ArticleLayout>
