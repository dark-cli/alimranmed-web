---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { topicOf, isLocale, pickForLocale, localizedHref, currentLocale } from "../../../../lib/i18n";
import { NAV_LABELS } from "../../../../lib/labels";

export async function getStaticPaths() {
  const all = await getCollection("services");

  // EN paths
  const enEntries = all.filter((e) => isLocale(e.id, "en"));
  const enByCategory = new Map<string, typeof enEntries>();
  for (const entry of enEntries) {
    const topic = topicOf(entry.id);
    if (!topic.includes("/")) continue;
    const [category] = topic.split("/");
    if (!enByCategory.has(category)) enByCategory.set(category, []);
    enByCategory.get(category)!.push(entry);
  }

  // AR paths
  const topics = Array.from(new Set(all.map((e) => topicOf(e.id))));
  const arPickups = topics
    .map((topic) => pickForLocale(all, topic, "ar"))
    .filter((x): x is NonNullable<typeof x> => !!x);
  const arEntries = arPickups.map(({ entry }) => entry);
  const arByCategory = new Map<string, typeof arEntries>();
  for (const entry of arEntries) {
    const topic = topicOf(entry.id);
    if (!topic.includes("/")) continue;
    const [category] = topic.split("/");
    if (!arByCategory.has(category)) arByCategory.set(category, []);
    arByCategory.get(category)!.push(entry);
  }

  const paths: Array<{ params: { locale: string; category: string }; props: any }> = [];

  for (const [category, entries] of enByCategory.entries()) {
    paths.push({ params: { locale: "en", category }, props: { category, entries } });
  }
  for (const [category, entries] of arByCategory.entries()) {
    const categoryPickup = arPickups.find((p) => topicOf(p.entry.id) === category);
    paths.push({ params: { locale: "ar", category }, props: { category, entries, categoryEntry: categoryPickup?.entry } });
  }

  return paths;
}

const { category, entries, categoryEntry } = Astro.props;
const locale = currentLocale(Astro);
const nav = NAV_LABELS[locale];

const sorted = [...entries].sort(
  (a: any, b: any) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

const prettyCategory = category
  .split("-")
  .map((w: string) => w.charAt(0).toUpperCase() + w.slice(1))
  .join(" ");
const categoryTitle = locale === "ar"
  ? (categoryEntry?.data.title || prettyCategory)
  : prettyCategory;

const BLURB: Record<string, string> = {
  "brain-stimulation":   "Non-invasive brain modulation using magnetic (TMS) and low-current (tDCS) techniques.",
  "chiropractic":        "Spinal alignment and decompression using SPINMED and Sigma systems.",
  "exercises":           "Therapeutic exercise programmes organised by body region.",
  "fitness":             "Body-contouring and non-surgical aesthetic procedures.",
  "ozone-therapy":       "Oxygen–ozone applications for inflammation, discogenic pain, and osteoarthritis.",
  "pain-management":     "Interventional and multidisciplinary approaches to chronic pain.",
  "physiotherapy":       "Robot-assisted rehabilitation, laser, ultrasound, and electrotherapy.",
  "radiofrequency":      "Minimally-invasive neurotomy for chronic joint and spinal pain.",
  "regenerative-medicine":"PRP, prolotherapy, and stem-cell techniques for ligament and joint healing.",
  "rehabilitation":      "Multidisciplinary recovery care led by consultants in stroke, spinal cord injury, and more.",
  "steroid-injection":   "Image-guided steroid and anaesthetic blocks for joint and spinal pain.",
  "surgery":             "Neurosurgery and spine surgery — from minimally invasive to complex craniotomy.",
  "botox":               "Botulinum toxin applications for spasticity, headache, and chronic pain.",
  "acupuncture":         "Traditional Chinese needle therapy for chronic pain and inflammatory conditions.",
};
const BLURB_AR: Record<string, string> = {
  "brain-stimulation":   "تحفيز الدماغ غير الجراحي بالتحفيز المغناطيسي (TMS) والتيار المباشر منخفض الشدة (tDCS) في مركز العمران الطبي بالبصرة.",
  "chiropractic":        "تقويم العمود الفقري وتخفيف الضغط عن الفقرات بأجهزة SPINMED وSigma في مركز العمران الطبي بالبصرة.",
  "exercises":           "برامج تمارين علاجية مصنّفة حسب منطقة الجسم للتأهيل المنزلي، من مركز العمران الطبي.",
  "fitness":             "إجراءات نحت الجسم والعلاجات التجميلية غير الجراحية في مركز العمران الطبي بالبصرة.",
  "ozone-therapy":       "العلاج بالأوزون للالتهابات وآلام الانزلاق الغضروفي وخشونة المفاصل في مركز العمران الطبي بالبصرة.",
  "pain-management":     "علاج الألم المزمن بالتداخلات الموضعية ونهج متعدد التخصصات في مركز العمران الطبي بالبصرة.",
  "physiotherapy":       "العلاج الطبيعي والتأهيل بالروبوت والليزر والموجات فوق الصوتية والتحفيز الكهربائي في مركز العمران الطبي.",
  "radiofrequency":      "كيّ الأعصاب بالترددات الراديوية لآلام المفاصل والعمود الفقري المزمنة، إجراء طفيف التوغل في مركز العمران الطبي.",
  "regenerative-medicine":"الطب التجديدي: البلازما الغنية بالصفائح والحقن التكاثري والخلايا الجذعية لشفاء الأربطة والمفاصل.",
  "rehabilitation":      "تأهيل متعدد التخصصات بعد الجلطة الدماغية وإصابات الحبل الشوكي وغيرها، بإشراف استشاريين في مركز العمران الطبي.",
  "steroid-injection":   "حقن الستيرويد والتخدير الموضعي الموجّه بالتصوير لآلام المفاصل والعمود الفقري في مركز العمران الطبي.",
  "surgery":             "جراحة الدماغ والأعصاب والعمود الفقري، من الإجراءات طفيفة التوغل إلى العمليات المعقدة، في مركز العمران الطبي.",
  "botox":               "حقن البوتوكس لعلاج التشنج العضلي والصداع والألم المزمن في مركز العمران الطبي بالبصرة.",
  "acupuncture":         "الوخز بالإبر الصينية لعلاج الألم المزمن والحالات الالتهابية في مركز العمران الطبي بالبصرة.",
};
const blurb = locale === "en"
  ? (BLURB[category] ? `${BLURB[category].replace(/\.$/, "")} at Alimran Medical Center in Basra.` : `${prettyCategory} services at Alimran Medical Center in Basra.`)
  : (BLURB_AR[category] ?? `خدمات ${categoryTitle} في مركز العمران الطبي بالبصرة.`);
const siteName = locale === "ar" ? "مركز العمران الطبي" : "Alimran Medical Center";
---

<BaseLayout title={`${categoryTitle} — ${siteName}`} description={blurb}>
  <div class="container page">
    <header class="page-head">
      <a class="back" href={localizedHref("/services/", locale)}>
        {locale === "ar" ? `← ${nav.services}` : "← All services"}
      </a>
      <h1>{categoryTitle}</h1>
      {blurb && <p class="lede">{blurb}</p>}
    </header>

    <div class="grid">
      {sorted.map((entry: any) => (
        <a class="card entry" href={localizedHref(`/services/${topicOf(entry.id)}/`, locale)}>
          <h3>{entry.data.title}</h3>
          {entry.data.description && <p>{entry.data.description}</p>}
          {locale === "en" && <span class="learn-more">Read more →</span>}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page { padding-block: 1.5rem 2.5rem; }
  @media (min-width: 640px) { .page { padding-block: 3rem 4rem; } }
  .page-head { text-align: center; max-width: 60ch; margin: 0 auto 1.5rem; }
  @media (min-width: 640px) { .page-head { margin-bottom: 3rem; } }
  .page-head h1 { text-transform: capitalize; }
  .page-head .lede { color: var(--ink-soft); font-size: 1.1rem; }
  .back { display: inline-block; margin-bottom: 1rem; font-size: 0.9rem; color: var(--ink-soft); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .entry {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .entry:hover { text-decoration: none; }
  .entry h3 { color: var(--brand); margin: 0; }
  .entry p { color: var(--ink-soft); margin: 0; font-size: 0.95rem; flex: 1; }
  .learn-more { color: var(--brand); font-weight: 600; font-size: 0.9rem; margin-top: 0.5rem; }
</style>
