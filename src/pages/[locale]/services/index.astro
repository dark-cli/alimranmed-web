---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { topicOf, isLocale, pickForLocale, localizedHref, currentLocale } from "../../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const all = await getCollection("services");

let entries: typeof all;
if (locale === "ar") {
  const topics = Array.from(new Set(all.map((e) => topicOf(e.id))));
  entries = topics
    .map((topic) => pickForLocale(all, topic, "ar"))
    .filter((x): x is NonNullable<typeof x> => !!x)
    .map(({ entry }) => entry);
} else {
  entries = all.filter((e) => isLocale(e.id, "en"));
}

type Entry = (typeof entries)[number];
const byCategory = new Map<string, Entry[]>();
const topLevel: Entry[] = [];
for (const entry of entries) {
  const topic = topicOf(entry.id);
  if (topic.includes("/")) {
    const [cat] = topic.split("/");
    if (!byCategory.has(cat)) byCategory.set(cat, []);
    byCategory.get(cat)!.push(entry);
  } else {
    topLevel.push(entry);
  }
}

// For AR: use Arabic titles for category landing pages
const categoryTitles = new Map<string, string>();
if (locale === "ar") {
  for (const entry of entries) {
    const topic = topicOf(entry.id);
    categoryTitles.set(topic, entry.data.title);
  }
}

const categories = [...byCategory.entries()]
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([slug, list]) => ({
    slug,
    pretty: locale === "ar"
      ? (categoryTitles.get(slug) || slug.split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join(" "))
      : slug.split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join(" "),
    count: list.length,
  }));
---

<BaseLayout
  title={locale === "ar" ? "الخدمات — مركز العمران الطبي" : "Services — Alimran Medical Center"}
  description={locale === "en" ? "Chiropractic, brain stimulation, physiotherapy, radiofrequency, surgery and more — all procedures offered at Alimran Medical Center in Basra." : undefined}
>
  <div class="container page">
    <header class="page-head">
      <h1>{locale === "ar" ? "الخدمات" : "Services"}</h1>
      {locale === "en" && <p class="lede">Every therapy and intervention we offer, grouped by discipline.</p>}
    </header>

    <div class="grid">
      {categories.map((c) => (
        <a class="card cat" href={localizedHref(`/services/${c.slug}/`, locale)}>
          <h3>{c.pretty}</h3>
          <span class="count">
            {locale === "en" ? `${c.count} ${c.count === 1 ? "item" : "items"}` : c.count}
          </span>
        </a>
      ))}
      {topLevel.map((e) => (
        <a class="card cat" href={localizedHref(`/services/${topicOf(e.id)}/`, locale)}>
          <h3>{e.data.title}</h3>
          {locale === "en" && e.data.description && <span class="count">{e.data.description}</span>}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page { padding-block: 1.5rem 2.5rem; }
  @media (min-width: 640px) { .page { padding-block: 3rem 4rem; } }
  .page-head { text-align: center; max-width: 60ch; margin: 0 auto 1.5rem; }
  @media (min-width: 640px) { .page-head { margin-bottom: 3rem; } }
  .page-head .lede { color: var(--ink-soft); font-size: 1.1rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .cat {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: start;
  }
  .cat:hover { text-decoration: none; }
  .cat h3 { color: var(--brand); margin: 0; }
  .count { color: var(--ink-muted); font-size: 0.85rem; }
</style>
