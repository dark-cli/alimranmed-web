---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { topicOf, isLocale, pickForLocale, localizedHref, currentLocale, byLocale, LOCALES, localePath, toArabicDigits } from "../../../lib/i18n";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale: localePath(locale) } }));
}

const locale = currentLocale(Astro);
const all = await getCollection("services");

let entries: typeof all;
if (locale !== "en") {
  const topics = Array.from(new Set(all.map((e) => topicOf(e.id))));
  entries = topics
    .map((topic) => pickForLocale(all, topic, locale))
    .filter((x): x is NonNullable<typeof x> => !!x)
    .map(({ entry }) => entry);
} else {
  entries = all.filter((e) => isLocale(e.id, "en"));
}

type Entry = (typeof entries)[number];
const byCategory = new Map<string, Entry[]>();
const topLevel: Entry[] = [];
for (const entry of entries) {
  const topic = topicOf(entry.id);
  if (topic.includes("/")) {
    const [cat] = topic.split("/");
    if (!byCategory.has(cat)) byCategory.set(cat, []);
    byCategory.get(cat)!.push(entry);
  } else {
    topLevel.push(entry);
  }
}

// For AR/TR: use translated titles for category landing pages
const categoryTitles = new Map<string, string>();
if (locale !== "en") {
  for (const entry of entries) {
    const topic = topicOf(entry.id);
    categoryTitles.set(topic, entry.data.title);
  }
}

const categories = [...byCategory.entries()]
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([slug, list]) => ({
    slug,
    pretty: locale !== "en"
      ? (categoryTitles.get(slug) || slug.split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join(" "))
      : slug.split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join(" "),
    count: list.length,
  }));
---

<BaseLayout
  title={byLocale(locale, { en: "Services — Alimran Medical Center", ar: "الخدمات — مركز العمران الطبي", tr: "Hizmetler — Alimran Tıp Merkezi", ckb: "خزمەتگوزارییەکان — سەنتەری پزیشکیی ئەلعیمران" })}
  description={byLocale(locale, { en: "Chiropractic, brain stimulation, physiotherapy, radiofrequency, surgery and more — all procedures offered at Alimran Medical Center in Basra.", ar: "تقويم العمود الفقري، تحفيز الدماغ، العلاج الطبيعي، الترددات الراديوية، الجراحة وغيرها — جميع الإجراءات المقدمة في مركز العمران الطبي بالبصرة.", tr: "Kayropraktik, beyin stimülasyonu, fizyoterapi, radyofrekans, cerrahi ve daha fazlası — Basra'daki Alimran Tıp Merkezi'nde sunulan tüm girişimler.", ckb: "چارەسەری کایرۆپراکتیک، ورووژاندنی مێشک، چارەسەری سروشتی، ڕادیۆفریکوێنسی، نەشتەرگەری و زیاتر — هەموو ئەو چارەسەرانەی لە سەنتەری پزیشکیی ئەلعیمران لە بەسرە پێشکەش دەکرێن." })}
>
  <div class="container page">
    <header class="page-head">
      <h1>{byLocale(locale, { en: "Services", ar: "الخدمات", tr: "Hizmetler", ckb: "خزمەتگوزارییەکان" })}</h1>
      {locale === "en" && <p class="lede">Every therapy and intervention we offer, grouped by discipline.</p>}
      {locale === "ckb" && <p class="lede">هەموو چارەسەر و دەستێوەردانەکانی کە پێشکەشیان دەکەین، بە پێی بەش ڕیزکراون.</p>}
      {locale === "tr" && <p class="lede">Sunduğumuz tüm tedaviler ve girişimler, disiplinlere göre gruplandırılmıştır.</p>}
    </header>

    <div class="grid">
      {categories.map((c) => (
        <a class="card cat" href={localizedHref(`/services/${c.slug}/`, locale)}>
          <h3>{c.pretty}</h3>
          <span class="count">
            {locale === "en" ? `${c.count} ${c.count === 1 ? "item" : "items"}` : locale === "tr" ? `${c.count} kayıt` : locale === "ckb" ? toArabicDigits(c.count) : c.count}
          </span>
        </a>
      ))}
      {topLevel.map((e) => (
        <a class="card cat" href={localizedHref(`/services/${topicOf(e.id)}/`, locale)}>
          <h3>{e.data.title}</h3>
          {locale !== "ar" && e.data.description && <span class="count">{e.data.description}</span>}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page { padding-block: 1.5rem 2.5rem; }
  @media (min-width: 640px) { .page { padding-block: 3rem 4rem; } }
  .page-head { text-align: center; max-width: 60ch; margin: 0 auto 1.5rem; }
  @media (min-width: 640px) { .page-head { margin-bottom: 3rem; } }
  .page-head .lede { color: var(--ink-soft); font-size: 1.1rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .cat {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: start;
  }
  .cat:hover { text-decoration: none; }
  .cat h3 { color: var(--brand); margin: 0; }
  .count { color: var(--ink-muted); font-size: 0.85rem; }
</style>
