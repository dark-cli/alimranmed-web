---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { topicOf, isLocale, pickForLocale, localizedHref, currentLocale, byLocale, LOCALES, localePath } from "../../../lib/i18n";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale: localePath(locale) } }));
}

const locale = currentLocale(Astro);
const all = await getCollection("treatments");

const entries = locale !== "en"
  ? Array.from(new Set(all.map((e) => topicOf(e.id))))
      .map((topic) => pickForLocale(all, topic, locale))
      .filter((x): x is NonNullable<typeof x> => !!x)
      .map(({ entry }) => entry)
      .sort((a, b) => (a.data.title || "").localeCompare(b.data.title || "", locale))
  : all
      .filter((e) => isLocale(e.id, "en"))
      .sort((a, b) => (a.data.title || "").localeCompare(b.data.title || ""));

const defaultCat = byLocale(locale, { en: "Other", ar: "أخرى", tr: "Diğer", ckb: "هی تر" });
// tr.md keeps English category slugs (brain, spine, pain, ...) — show Turkish names.
const TR_CATS: Record<string, string> = { brain: "Beyin", spine: "Omurga", pain: "Ağrı", pediatric: "Çocuk", motor: "Hareket", other: "Diğer" };
const CKB_CATS: Record<string, string> = { brain: "مێشک", spine: "بڕبڕەی پشت", pain: "ئازار", pediatric: "منداڵان", motor: "جوڵە", other: "هی تر" };
const grouped = new Map<string, typeof entries>();
for (const t of entries) {
  const cat = t.data.category ?? defaultCat;
  if (!grouped.has(cat)) grouped.set(cat, []);
  grouped.get(cat)!.push(t);
}
---

<BaseLayout
  title={byLocale(locale, { en: "What We Treat — Alimran Medical Center", ar: "ما نعالج — مركز العمران الطبي", tr: "Neleri Tedavi Ediyoruz — Alimran Tıp Merkezi", ckb: "چی چارەسەر دەکەین — سەنتەری پزیشکیی ئەلعیمران" })}
  description={byLocale(locale, { en: "Browse all conditions treated at Alimran Medical Center — neurology, spine, pain and musculoskeletal disorders across an A–Z index.", ar: "تصفّح جميع الحالات التي يعالجها مركز العمران الطبي — أمراض الأعصاب والعمود الفقري والألم والجهاز العضلي الهيكلي في فهرس أبجدي.", tr: "Alimran Tıp Merkezi'nde tedavi edilen tüm hastalıklara göz atın — nöroloji, omurga, ağrı ve kas-iskelet sistemi hastalıkları A–Z dizininde.", ckb: "هەموو ئەو نەخۆشییانە ببینە کە لە سەنتەری پزیشکیی ئەلعیمران چارەسەر دەکرێن — دەمار، بڕبڕەی پشت، ئازار و نەخۆشییەکانی ماسولکە و ئێسک، لە پێرستێکی A–Z دا." })}
>
  <div class="container page">
    <header class="page-head">
      <h1>{byLocale(locale, { en: "What We Treat", ar: "ما نعالج", tr: "Neleri Tedavi Ediyoruz", ckb: "چی چارەسەر دەکەین" })}</h1>
      {locale === "en" && (
        <p>A comprehensive catalogue of neurological, pain, and musculoskeletal conditions managed by our consultant-led team.</p>
      )}
      {locale === "ckb" && (
        <p>کاتالۆگێکی گشتگیر لە نەخۆشییەکانی دەمار، ئازار و ماسولکە و ئێسک کە تیپەکەمان بە سەرپەرشتیی پزیشکی ڕاوێژکار چارەسەریان دەکات.</p>
      )}
      {locale === "tr" && (
        <p>Danışman liderliğindeki ekibimizin yönettiği nörolojik, ağrı ve kas-iskelet sistemi hastalıklarının kapsamlı bir kataloğu.</p>
      )}
    </header>

    {[...grouped.entries()].map(([category, items]) => (
      <section class="category">
        <h2>{locale === "ar" ? category : locale === "ckb" ? (CKB_CATS[category] ?? category.charAt(0).toUpperCase() + category.slice(1)) : locale === "tr" ? (TR_CATS[category] ?? category.charAt(0).toUpperCase() + category.slice(1)) : category.charAt(0).toUpperCase() + category.slice(1)}</h2>
        <ul class="condition-list">
          {items.map((t) => (
            <li>
              <a href={localizedHref(`/treatments/${topicOf(t.id)}/`, locale)}>{t.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {grouped.size === 0 && locale === "en" && (
      <p class="empty">Treatments will appear here once the content migration runs.</p>
    )}
  </div>
</BaseLayout>

<style>
  .page { padding-block: 1.5rem 2.5rem; }
  @media (min-width: 640px) { .page { padding-block: 3rem 4rem; } }
  .page-head { text-align: center; max-width: 60ch; margin: 0 auto 1.5rem; }
  @media (min-width: 640px) { .page-head { margin-bottom: 3rem; } }
  .page-head p { color: var(--ink-soft); }
  .category { margin-bottom: 2.5rem; }
  .category h2 { color: var(--brand); border-bottom: 1px solid var(--border); padding-bottom: 0.4em; }
  .condition-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.5rem;
  }
  .condition-list a { display: block; padding: 0.5em 0; }
  .empty { text-align: center; color: var(--ink-muted); font-style: italic; }
</style>
