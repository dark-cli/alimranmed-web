---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { topicOf, isLocale, pickForLocale, localizedHref, currentLocale } from "../../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const all = await getCollection("treatments");

const entries = locale === "ar"
  ? Array.from(new Set(all.map((e) => topicOf(e.id))))
      .map((topic) => pickForLocale(all, topic, "ar"))
      .filter((x): x is NonNullable<typeof x> => !!x)
      .map(({ entry }) => entry)
      .sort((a, b) => (a.data.title || "").localeCompare(b.data.title || ""))
  : all
      .filter((e) => isLocale(e.id, "en"))
      .sort((a, b) => (a.data.title || "").localeCompare(b.data.title || ""));

const defaultCat = locale === "ar" ? "أخرى" : "Other";
const grouped = new Map<string, typeof entries>();
for (const t of entries) {
  const cat = t.data.category ?? defaultCat;
  if (!grouped.has(cat)) grouped.set(cat, []);
  grouped.get(cat)!.push(t);
}
---

<BaseLayout
  title={locale === "ar" ? "ما نعالج — مركز العمران الطبي" : "What We Treat — Alimran Medical Center"}
  description={locale === "en" ? "Browse all conditions treated at Alimran Medical Center — neurology, spine, pain and musculoskeletal disorders across an A–Z index." : "تصفّح جميع الحالات التي يعالجها مركز العمران الطبي — أمراض الأعصاب والعمود الفقري والألم والجهاز العضلي الهيكلي في فهرس أبجدي."}
>
  <div class="container page">
    <header class="page-head">
      <h1>{locale === "ar" ? "ما نعالج" : "What We Treat"}</h1>
      {locale === "en" && (
        <p>A comprehensive catalogue of neurological, pain, and musculoskeletal conditions managed by our consultant-led team.</p>
      )}
    </header>

    {[...grouped.entries()].map(([category, items]) => (
      <section class="category">
        <h2>{locale === "en" ? category.charAt(0).toUpperCase() + category.slice(1) : category}</h2>
        <ul class="condition-list">
          {items.map((t) => (
            <li>
              <a href={localizedHref(`/treatments/${topicOf(t.id)}/`, locale)}>{t.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {grouped.size === 0 && locale === "en" && (
      <p class="empty">Treatments will appear here once the content migration runs.</p>
    )}
  </div>
</BaseLayout>

<style>
  .page { padding-block: 1.5rem 2.5rem; }
  @media (min-width: 640px) { .page { padding-block: 3rem 4rem; } }
  .page-head { text-align: center; max-width: 60ch; margin: 0 auto 1.5rem; }
  @media (min-width: 640px) { .page-head { margin-bottom: 3rem; } }
  .page-head p { color: var(--ink-soft); }
  .category { margin-bottom: 2.5rem; }
  .category h2 { color: var(--brand); border-bottom: 1px solid var(--border); padding-bottom: 0.4em; }
  .condition-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.5rem;
  }
  .condition-list a { display: block; padding: 0.5em 0; }
  .empty { text-align: center; color: var(--ink-muted); font-style: italic; }
</style>
