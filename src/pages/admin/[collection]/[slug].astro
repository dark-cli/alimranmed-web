---
import { readFileSync } from 'fs';
import { join } from 'path';
import { parseFrontmatter } from '../../../lib/admin/yaml';

export const prerender = false;

const collection = Astro.params.collection;
const slug = Astro.params.slug;
const locale = Astro.url.searchParams.get('locale') || 'en';

if (!collection || !slug) {
  return Astro.redirect('/admin');
}

let frontmatter = {};
let body = '';
let error = '';

try {
  const contentDir = join(process.cwd(), 'src/content');
  const filePath = join(contentDir, collection, slug, `${locale}.md`);
  const content = readFileSync(filePath, 'utf-8');
  const parsed = parseFrontmatter(content);
  frontmatter = parsed.frontmatter;
  body = parsed.body;
} catch (e) {
  error = `Failed to load content: ${String(e)}`;
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit {collection} / {slug}</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; margin: 0; background: #f5f5f5; }
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    .header { background: #fff; padding: 20px; border-radius: 8px; margin-bottom: 20px; border-bottom: 3px solid #0066cc; }
    .header h1 { margin: 0; font-size: 24px; }
    .header p { margin: 8px 0 0; color: #666; }
    .editor { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .panel { background: #fff; padding: 20px; border-radius: 8px; }
    .panel h2 { margin: 0 0 20px; font-size: 18px; border-bottom: 2px solid #eee; padding-bottom: 10px; }
    .field { margin-bottom: 20px; }
    .field label { display: block; margin-bottom: 6px; font-weight: 500; font-size: 14px; color: #333; }
    .field input, .field textarea, .field select { width: 100%; padding: 8px 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px; font-family: inherit; }
    .field textarea { min-height: 100px; resize: vertical; font-family: 'Monaco', 'Courier New', monospace; }
    .field input:focus, .field textarea:focus, .field select:focus { outline: none; border-color: #0066cc; box-shadow: 0 0 0 3px rgba(0,102,204,0.1); }
    .array-field { background: #f9f9f9; padding: 12px; border-radius: 4px; margin-bottom: 12px; border-left: 3px solid #0066cc; }
    .array-item { display: grid; grid-template-columns: 1fr 40px; gap: 8px; margin-bottom: 8px; }
    .array-item input { }
    .array-item button { padding: 6px; background: #ff4444; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; }
    .add-btn, .save-btn { padding: 10px 20px; background: #0066cc; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 500; margin-right: 10px; }
    .add-btn:hover, .save-btn:hover { background: #0052a3; }
    .buttons { margin-top: 20px; display: flex; gap: 10px; }
    .error { background: #fee; color: #c33; padding: 12px; border-radius: 4px; margin-bottom: 20px; border-left: 3px solid #c33; }
    .success { background: #efe; color: #3c3; padding: 12px; border-radius: 4px; margin-bottom: 20px; border-left: 3px solid #3c3; }
    .preview { max-height: 600px; overflow-y: auto; background: #f9f9f9; padding: 16px; border-radius: 4px; }
    .preview h3 { margin-top: 0; }
    .meta { font-size: 12px; color: #999; margin: 10px 0; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>{collection} / {slug}</h1>
      <p>Locale: <strong>{locale}</strong></p>
    </div>

    {error && (
      <div class="error">{error}</div>
    )}

    <div id="success-msg" class="success" style="display: none;">Saved successfully!</div>

    <div class="editor">
      <div class="panel">
        <h2>Frontmatter</h2>
        <div id="form-fields"></div>
        <div class="buttons">
          <button class="save-btn" onclick="saveFrontmatter()">Save</button>
          <button class="add-btn" onclick="location.reload()">Reload</button>
        </div>
      </div>

      <div class="panel">
        <h2>Markdown Body</h2>
        <textarea id="body-editor">{body}</textarea>
        <div class="buttons">
          <button class="save-btn" onclick="saveBody()">Save Body</button>
        </div>
        <div class="preview">
          <h3>Content Preview</h3>
          <div id="preview" />
        </div>
      </div>
    </div>
    <script type="application/json" id="data">{JSON.stringify({collection, slug, locale, frontmatterData: frontmatter})}</script>
  </div>

  <script>
    const { collection, slug, locale, frontmatterData } = JSON.parse(document.getElementById('data').textContent);

    function renderForm() {
      const container = document.getElementById('form-fields');
      container.innerHTML = '';

      for (const [key, value] of Object.entries(frontmatterData)) {
        const field = createField(key, value);
        container.appendChild(field);
      }
    }

    function createField(key, value) {
      const div = document.createElement('div');
      div.className = 'field';

      const label = document.createElement('label');
      label.textContent = key;
      div.appendChild(label);

      if (Array.isArray(value)) {
        const arrayDiv = document.createElement('div');
        arrayDiv.className = 'array-field';

        value.forEach((item, idx) => {
          const itemDiv = document.createElement('div');
          itemDiv.className = 'array-item';

          const input = document.createElement('input');
          input.type = 'text';
          input.value = typeof item === 'object' ? JSON.stringify(item) : item;
          input.dataset.key = key;
          input.dataset.index = idx;

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = 'Del';
          btn.onclick = () => {
            itemDiv.remove();
          };

          itemDiv.appendChild(input);
          itemDiv.appendChild(btn);
          arrayDiv.appendChild(itemDiv);
        });

        const addBtn = document.createElement('button');
        addBtn.type = 'button';
        addBtn.className = 'add-btn';
        addBtn.textContent = '+ Add item';
        addBtn.style.width = '100%';
        addBtn.onclick = () => {
          const itemDiv = document.createElement('div');
          itemDiv.className = 'array-item';

          const input = document.createElement('input');
          input.type = 'text';
          input.dataset.key = key;
          input.dataset.index = value.length;

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = 'Del';
          btn.onclick = () => itemDiv.remove();

          itemDiv.appendChild(input);
          itemDiv.appendChild(btn);
          arrayDiv.insertBefore(itemDiv, addBtn);
        };

        arrayDiv.appendChild(addBtn);
        div.appendChild(arrayDiv);
      } else if (typeof value === 'string' && value.includes('\n')) {
        const textarea = document.createElement('textarea');
        textarea.value = value;
        textarea.dataset.key = key;
        div.appendChild(textarea);
      } else {
        const input = document.createElement('input');
        input.type = typeof value === 'number' ? 'number' : 'text';
        input.value = value;
        input.dataset.key = key;
        div.appendChild(input);
      }

      return div;
    }

    function getFormData() {
      const data = {};

      document.querySelectorAll('.field').forEach(field => {
        const inputs = field.querySelectorAll('input[data-key], textarea[data-key], select[data-key]');
        if (inputs.length === 1) {
          const input = inputs[0];
          const key = input.dataset.key;
          const value = input.value;
          data[key] = value;
        } else if (inputs.length > 1) {
          const key = inputs[0].dataset.key;
          const arr = [];
          inputs.forEach(input => {
            arr.push(input.value);
          });
          data[key] = arr;
        }
      });

      return data;
    }

    async function saveFrontmatter() {
      const frontmatter = getFormData();
      const body = document.getElementById('body-editor').value;

      try {
        const res = await fetch('/api/admin/save-content', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ collection, slug, locale, frontmatter, body })
        });

        if (!res.ok) throw new Error(await res.text());

        showSuccess();
      } catch (e) {
        alert('Save failed: ' + e.message);
      }
    }

    async function saveBody() {
      const body = document.getElementById('body-editor').value;
      const frontmatter = getFormData();

      try {
        const res = await fetch('/api/admin/save-content', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ collection, slug, locale, frontmatter, body })
        });

        if (!res.ok) throw new Error(await res.text());

        showSuccess();
      } catch (e) {
        alert('Save failed: ' + e.message);
      }
    }

    function showSuccess() {
      const msg = document.getElementById('success-msg');
      msg.style.display = 'block';
      setTimeout(() => msg.style.display = 'none', 3000);
    }

    function updatePreview() {
      const body = document.getElementById('body-editor').value;
      const preview = document.getElementById('preview');
      preview.innerHTML = '<p><em>Preview rendering not yet implemented</em></p><pre>' + body.substring(0, 200) + '</pre>';
    }

    renderForm();
    updatePreview();

    document.getElementById('body-editor').addEventListener('input', updatePreview);
  </script>
</body>
</html>
