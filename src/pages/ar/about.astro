---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import TranslationBanner from "../../components/TranslationBanner.astro";
import { topicOf, pickForLocale } from "../../lib/i18n";

const all = await getCollection("pages");
const aboutTopics = ["about/mission", "about/vision", "about/values"];

// Pick AR-preferred entries; if ANY section is missing translation, treat
// the whole page as fallback and render the EN version wholesale.
const picks = aboutTopics.map((topic) => pickForLocale(all, topic, "ar"));
const anyFallback = picks.some((p) => p && p.fallback);

const items = picks.filter((x): x is NonNullable<typeof x> => !!x);
const rendered = await Promise.all(items.map(async ({ entry }) => {
  const { Content } = await render(entry);
  return { entry, Content };
}));

const ICON: Record<string, string> = {
  mission: "fa-solid fa-bullseye",
  vision:  "fa-solid fa-eye",
  values:  "fa-solid fa-heart",
};

// EN copy for the hero when we're in fallback mode; AR copy when truly translated.
const heroCopy = anyFallback
  ? {
      dir: "ltr" as const,
      eyebrow: "About Us",
      h1: "Care that listens, medicine that thinks.",
      lede: "Alimran Medical Center is a specialised neurology and musculoskeletal clinic in Basra, Iraq. Our multidisciplinary team combines consultant-led surgical expertise with modern rehabilitation, brain-stimulation, and pain-management techniques.",
      cta: { label: "See the team", href: "/ar/doctors/" },
      ctaTitle: "Meet our doctors",
      ctaSub: "Board-certified consultants with decades of combined experience.",
    }
  : {
      dir: "rtl" as const,
      eyebrow: "من نحن",
      h1: "رعاية تُصغي إلى المريض، وطبٌ يفكر.",
      lede: "مركز العمران الطبي عيادة متخصصة في الأعصاب والجهاز العضلي الهيكلي في البصرة، العراق. فريقنا متعدد التخصصات يجمع خبرة الاستشاريين الجراحية مع أحدث أساليب التأهيل والتحفيز الدماغي وإدارة الألم.",
      cta: { label: "تعرّف على الفريق", href: "/ar/doctors/" },
      ctaTitle: "أطباؤنا",
      ctaSub: "استشاريون معتمدون بخبرة عقود متراكمة.",
    };
---

<BaseLayout title="من نحن — مركز العمران الطبي">
  <div dir={heroCopy.dir} lang={heroCopy.dir === "ltr" ? "en" : "ar"}>
    <section class="hero">
      <div class="container">
        <span class="eyebrow">{heroCopy.eyebrow}</span>
        <h1>{heroCopy.h1}</h1>
        <p class="lede">{heroCopy.lede}</p>
      </div>
    </section>

    {anyFallback && (
      <div class="container banner-wrap">
        <TranslationBanner fromLocale="en" toLocale="ar" />
      </div>
    )}

    <section class="values container">
      {rendered.map(({ entry, Content }) => {
        const slug = topicOf(entry.id).split("/").pop() ?? "";
        const iconClass = ICON[slug] ?? "fa-solid fa-circle-check";
        return (
          <article class="value-row" id={slug}>
            <div class="value-icon" aria-hidden="true"><i class={iconClass}></i></div>
            <div class="value-body">
              <h2>{entry.data.title.replace(/^OUR\s+/i, "")}</h2>
              <div class="prose"><Content /></div>
            </div>
          </article>
        );
      })}
    </section>

    <section class="cta-strip">
      <div class="container">
        <h2>{heroCopy.ctaTitle}</h2>
        <p>{heroCopy.ctaSub}</p>
        <a class="btn btn-primary" href={heroCopy.cta.href}>{heroCopy.cta.label}</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 2rem 0 1.25rem;
    background: linear-gradient(180deg, var(--brand-soft) 0%, var(--surface-alt) 100%);
    text-align: center;
  }
  @media (min-width: 640px) { .hero { padding: 4rem 0 2rem; } }
  .eyebrow { display: inline-block; color: var(--brand); font-weight: 600; font-size: 0.75rem; margin-bottom: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; }
  @media (min-width: 640px) { .eyebrow { font-size: 0.85rem; margin-bottom: 1rem; } }
  .hero h1 { max-width: 22ch; margin: 0 auto 0.75rem; }
  .lede { color: var(--ink-soft); max-width: 60ch; margin: 0 auto; font-size: clamp(0.95rem, 2.6vw, 1.1rem); }
  .banner-wrap { padding-top: 1.25rem; }
  .values { padding-block: 1.75rem; display: flex; flex-direction: column; gap: 1.25rem; }
  @media (min-width: 640px) { .values { padding-block: 3rem; gap: 1.75rem; } }
  .value-row { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; padding-inline-start: 0.75rem; border-inline-start: 3px solid var(--brand); }
  @media (min-width: 640px) { .value-row { gap: 1.25rem; padding-inline-start: 1.25rem; } }
  .value-icon { width: 40px; height: 40px; border-radius: 50%; background: var(--brand-soft); color: var(--brand); display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  @media (min-width: 640px) { .value-icon { width: 48px; height: 48px; } }
  .value-body h2 { color: var(--brand); font-size: 1.1rem; margin: 0 0 0.5em; text-transform: capitalize; }
  @media (min-width: 640px) { .value-body h2 { font-size: 1.25rem; } }
  .value-body .prose { max-width: none; }
  .cta-strip { background: var(--surface); border-top: 1px solid var(--border); padding: 2rem 0; text-align: center; }
  @media (min-width: 640px) { .cta-strip { padding: 3rem 0; } }
  .cta-strip p { color: var(--ink-soft); margin-bottom: 1.5rem; }
</style>
