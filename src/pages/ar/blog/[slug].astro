---
import { getCollection, render } from "astro:content";
import { topicOf, isLocale, localizedHref, currentLocale } from "../../../lib/i18n";
import { wordsIn } from "../../../lib/word-count";
import ArticleLayout from "../../../components/article/ArticleLayout.astro";
import ArticleSections from "../../../components/article/ArticleSections.astro";
import Media from "../../../components/article/Media.astro";

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);

export async function getStaticPaths() {
  const blogs = await getCollection("blog");
  return blogs
    .filter((e) => isLocale(e.id, "ar"))
    .map((entry) => ({ params: { slug: topicOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
const isRedesigned = entry.data.redesigned === true;
const { Content } = await render(entry);

function toArabicDigits(n: number): string {
  return String(n).replace(/[0-9]/g, (d) => "٠١٢٣٤٥٦٧٨٩"[Number(d)]);
}
function readingTimeAr(n: number): string {
  if (n <= 1) return "دقيقة واحدة";
  if (n === 2) return "دقيقتان";
  if (n <= 10) return `${toArabicDigits(n)} دقائق`;
  return `${toArabicDigits(n)} دقيقة`;
}

const wordCount =
  wordsIn((entry.data as { sections?: unknown }).sections) +
  wordsIn(entry.body);
const readingLabel = readingTimeAr(Math.max(1, Math.round(wordCount / 140)));

const publishedAt: unknown = (entry.data as { publishedAt?: unknown }).publishedAt;
const lastReviewed = publishedAt
  ? new Date(publishedAt as string).toLocaleDateString("ar-IQ", { month: "long", year: "numeric" })
  : "—";

type TocItem = { id: string; text: string; num: string };
let toc: TocItem[] = [];
if (isRedesigned && Array.isArray(entry.data.sections)) {
  let n = 0;
  entry.data.sections.forEach((s: { type: string; heading?: string }) => {
    if (!("heading" in s) || !s.heading) return;
    n += 1;
    toc.push({ id: `s-${n}`, text: s.heading, num: toArabicDigits(n).padStart(2, "٠") });
  });
}

function extractBodyImages(body: string | undefined): { alt: string; src: string }[] {
  if (!body) return [];
  const re = /!\[([^\]]*)\]\(([^)\s]+)(?:\s+"[^"]*")?\)/g;
  const out: { alt: string; src: string }[] = [];
  let m;
  while ((m = re.exec(body)) !== null) out.push({ alt: m[1], src: m[2] });
  return out;
}
const usingSections = isRedesigned && Array.isArray(entry.data.sections);
const bodyImages = usingSections ? extractBodyImages(entry.body) : [];
---

<ArticleLayout
  pageTitle={`${entry.data.title} — مركز العمران الطبي`}
  description={entry.data.description}
  locale="ar"
  breadcrumbs={[
    { label: "الرئيسية", href: L("/") },
    { label: "المدونة", href: L("/blog/") },
    { label: entry.data.title },
  ]}
  h1={entry.data.title}
  meta={[
    { label: "تمت المراجعة من قبل", value: "الدكتور حسين عمران موسى، استشاري الجراحة العصبية" },
    { label: "وقت القراءة", value: readingLabel },
    { label: "آخر مراجعة", value: lastReviewed },
  ]}
  toc={toc}
  tocLabel="على هذه الصفحة"
  callLabel="أسئلة؟"
  callBody="تواصل معنا لمناقشة هذا الموضوع مع فريقنا."
  ctaHeading="هل تحتاج إلى مزيد من المعلومات؟"
  ctaBody="تواصل معنا للحصول على المزيد من التفاصيل حول الموضوعات المغطاة في هذا المقال."
  disclaimer="يوفر هذا المقال معلومات عامة ولا يحل محل الاستشارة الطبية المتخصصة. إذا كان لديك مخاوف صحية محددة، يرجى استشارة مقدم الرعاية الصحية."
>
  {usingSections ? (
    <>
      <ArticleSections sections={entry.data.sections} locale={locale} />
      {bodyImages.map((img) => (
        <Media kind="image" src={img.src} alt={img.alt} />
      ))}
    </>
  ) : (
    <div class="art-prose">
      <Content />
    </div>
  )}
</ArticleLayout>
