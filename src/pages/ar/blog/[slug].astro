---
/**
 * Blog article — Arabic.
 * Uses the same full template as treatment articles with header band,
 * TOC, blocks, and CTA section.
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { topicOf, isLocale, localizedHref, currentLocale } from "../../../lib/i18n";
import { CONTACT } from "../../../consts";
import ArticleSections from "../../../components/article/ArticleSections.astro";
import Media from "../../../components/article/Media.astro";

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);
const callHref = `tel:${CONTACT.phones[0].replace(/\s/g, "")}`;
const secondCallHref = `tel:${CONTACT.phones[1].replace(/\s/g, "")}`;

export async function getStaticPaths() {
  const blogs = await getCollection("blog");
  return blogs
    .filter((e) => isLocale(e.id, "ar"))
    .map((entry) => ({ params: { slug: topicOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
const isRedesigned = entry.data.redesigned === true;
const { Content, headings } = await render(entry);

// Reading time
function wordsIn(v: unknown): number {
  if (v == null) return 0;
  if (typeof v === "string") {
    const t = v.replace(/!\[[^\]]*]\([^)]+\)/g, "").trim();
    return t ? t.split(/\s+/).length : 0;
  }
  if (Array.isArray(v)) return v.reduce((n, x) => n + wordsIn(x), 0);
  if (typeof v === "object") return Object.values(v as Record<string, unknown>).reduce((n, x) => n + wordsIn(x), 0);
  return 0;
}
const wordCount =
  wordsIn((entry.data as { sections?: unknown }).sections) +
  wordsIn(entry.body);
const readingLabel = `${Math.max(1, Math.round(wordCount / 180))} دقيقة`;

// Last reviewed
const publishedAt: unknown = (entry.data as { publishedAt?: unknown }).publishedAt;
const lastReviewed = publishedAt
  ? new Date(publishedAt as string).toLocaleDateString("ar-IQ", { month: "long", year: "numeric" })
  : "—";

// Build TOC from block headings
function toArabicDigits(n: number): string {
  return String(n).replace(/[0-9]/g, (d) => "٠١٢٣٤٥٦٧٨٩"[Number(d)]);
}
type TocItem = { id: string; text: string; num: string };
let toc: TocItem[] = [];
if (isRedesigned && Array.isArray(entry.data.sections)) {
  let n = 0;
  entry.data.sections.forEach((s: { type: string; heading?: string }) => {
    if (!("heading" in s) || !s.heading) return;
    n += 1;
    toc.push({ id: `s-${n}`, text: s.heading, num: toArabicDigits(n).padStart(2, "٠") });
  });
}
const showToc = toc.length >= 2;

// Fallback for redesigned articles: pull any raw markdown images
// (`![alt](src)`) out of the body so legacy media still renders.
function extractBodyImages(body: string | undefined): { alt: string; src: string }[] {
  if (!body) return [];
  const re = /!\[([^\]]*)\]\(([^)\s]+)(?:\s+"[^"]*")?\)/g;
  const out: { alt: string; src: string }[] = [];
  let m;
  while ((m = re.exec(body)) !== null) out.push({ alt: m[1], src: m[2] });
  return out;
}
// Only extract when the sections dispatcher is active — if there are no
// sections, the else-branch renders the full markdown body (which already
// contains the images) and running the fallback would double them up.
const usingSections = isRedesigned && Array.isArray(entry.data.sections);
const bodyImages = usingSections ? extractBodyImages(entry.body) : [];
---

<BaseLayout title={`${entry.data.title} — مركز العمران الطبي`} description={entry.data.description}>
  <!-- Head band -->
  <section class="art-head-band">
    <div class="art-head-wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={L("/")}> الرئيسية</a>
        <span class="crumb-sep" aria-hidden="true">›</span>
        <a href={L("/blog/")}> المدونة</a>
        <span class="crumb-sep" aria-hidden="true">›</span>
        <span class="crumb-current">{entry.data.title}</span>
      </nav>
      <div class="art-head-grid">
        <div class="art-head-copy">
          <h1 class="art-h1">{entry.data.title}</h1>
          {entry.data.description && <p class="art-standfirst">{entry.data.description}</p>}
        </div>
        <dl class="art-meta">
          <div><dt>تمت المراجعة من قبل</dt><dd>الدكتور حسين عمران موسى، استشاري الجراحة العصبية</dd></div>
          <div><dt>وقت القراءة</dt><dd>{readingLabel}</dd></div>
          <div><dt>آخر مراجعة</dt><dd>{lastReviewed}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <div class="art-container">
    <div class="art-grid">
      <aside class="art-aside">
        {showToc && (
          <nav class="art-toc" aria-label="On this page">
            <p class="art-toc-label">على هذه الصفحة</p>
            <span class="art-toc-rule" aria-hidden="true"></span>
            {toc.map((t) => (<a href={`#${t.id}`}>{t.text}</a>))}
          </nav>
        )}
        <div class="art-call-card">
          <p class="art-call-label">أسئلة؟</p>
          <p class="art-call-body">تواصل معنا لمناقشة هذا الموضوع مع فريقنا.</p>
          <a class="art-call-btn" href={callHref} dir="ltr">{CONTACT.phones[0]}</a>
        </div>
      </aside>

      <article class="art-body">
        {isRedesigned && Array.isArray(entry.data.sections) ? (
          <ArticleSections sections={entry.data.sections} locale={locale} />
        ) : (
          <div class="art-prose">
            <Content />
          </div>
        )}
        {usingSections && bodyImages.length > 0 && bodyImages.map((img) => (
          <Media kind="image" src={img.src} alt={img.alt} />
        ))}

        <section class="art-cta">
          <div>
            <h2>هل تحتاج إلى مزيد من المعلومات؟</h2>
            <p>تواصل معنا للحصول على المزيد من التفاصيل حول الموضوعات المغطاة في هذا المقال.</p>
          </div>
          <div class="art-cta-buttons">
            <a class="btn btn-primary art-cta-btn" href={callHref} dir="ltr">{CONTACT.phones[0]}</a>
            <a class="btn btn-secondary art-cta-btn" href={secondCallHref} dir="ltr">{CONTACT.phones[1]}</a>
          </div>
        </section>

        <p class="art-disclaimer">
          يوفر هذا المقال معلومات عامة ولا يحل محل الاستشارة الطبية المتخصصة.
          إذا كان لديك مخاوف صحية محددة، يرجى استشارة مقدم الرعاية الصحية.
        </p>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .art-head-band { border-bottom: 1px solid var(--line); }
  .art-head-wrap {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(24px, 3.5vw, 40px) 24px clamp(32px, 4.5vw, 52px);
  }
  .crumbs {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
    margin-bottom: clamp(24px, 3.5vw, 36px);
  }
  .crumbs a {
    font-family: var(--font-mono); font-size: 12px;
    color: var(--muted); text-decoration: none; letter-spacing: 0.02em;
  }
  .crumbs a:hover { color: var(--accent); text-decoration: none; }
  .crumb-sep { color: var(--line-strong); font-size: 12px; }
  .crumb-current { font-family: var(--font-mono); font-size: 12px; color: var(--accent); }

  .art-head-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(290px, 100%), 1fr));
    gap: clamp(24px, 4vw, 64px); align-items: end;
  }
  .art-head-copy { container-type: inline-size; min-width: 0; }
  .art-h1 {
    font-family: var(--font-display);
    font-size: clamp(29px, 7cqw, 54px);
    line-height: 1.08; font-weight: 400; letter-spacing: -0.02em;
    margin: 0 0 18px; color: var(--ink); text-wrap: pretty;
  }
  .art-standfirst {
    font-size: clamp(16.5px, 1.9vw, 19px);
    line-height: 1.6; color: var(--body); max-width: 58ch;
    text-wrap: pretty; margin: 0;
  }

  .art-meta {
    margin: 0;
    display: flex; flex-direction: column; gap: 13px;
    border-inline-start: 1px solid var(--line);
    padding-inline-start: clamp(18px, 2.5vw, 28px);
    min-width: 0;
  }
  .art-meta dt {
    font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--muted); margin-bottom: 4px;
  }
  .art-meta dd { margin: 0; font-size: 15px; color: var(--ink); line-height: 1.5; }

  .art-container {
    max-width: var(--page-max); margin: 0 auto;
    padding: 0 24px; container-type: inline-size;
  }
  .art-grid {
    display: grid; grid-template-columns: minmax(0, 1fr);
    gap: clamp(28px, 4vw, 72px); align-items: start;
  }
  .art-aside { padding-top: clamp(32px, 4.5vw, 56px); min-width: 0; position: static; }
  .art-toc { display: none; flex-direction: column; }
  @container (min-width: 820px) {
    .art-grid { grid-template-columns: minmax(0, 240px) minmax(0, 1fr); }
    .art-grid > .art-body { max-width: 740px; }
    .art-aside { position: sticky; top: 96px; }
    .art-toc { display: flex; }
  }

  .art-toc-label {
    font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--muted); margin: 0 0 14px;
  }
  .art-toc-rule { display: block; border-top: 1px solid var(--ink); }
  .art-toc a {
    display: block; font-size: 14.5px; line-height: 1.45;
    color: var(--body); padding: 11px 0;
    border-bottom: 1px solid var(--line-soft); text-decoration: none;
  }
  .art-toc a:hover { color: var(--accent); text-decoration: none; }

  .art-call-card {
    display: none;
    margin-top: 24px;
    border: 1px solid var(--line); background: var(--surface); padding: 20px;
  }
  @container (min-width: 820px) {
    .art-call-card { display: block; }
  }

  .art-call-label {
    font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 10px;
  }
  .art-call-body { font-size: 14px; line-height: 1.72; color: var(--body); margin: 0 0 16px; }
  .art-call-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 100%; min-height: 44px; padding: 0 16px;
    background: var(--accent); color: var(--white);
    font-size: 14.5px; font-weight: 500; border-radius: 2px;
    text-decoration: none;
  }
  .art-call-btn:hover { background: var(--accent-hover); color: var(--white); text-decoration: none; }

  .art-body { padding: clamp(32px, 4.5vw, 56px) 0 0; min-width: 0; }

  .art-prose { color: var(--ink); }
  .art-prose :global(p) {
    font-size: 17px; line-height: 1.72; color: var(--body);
    margin: 0 0 20px; text-wrap: pretty;
  }
  .art-prose :global(h2) {
    scroll-margin-top: 96px;
    font-family: var(--font-display);
    font-size: clamp(22px, 2.9vw, 29px);
    font-weight: 400; letter-spacing: -0.015em;
    color: var(--ink);
    margin: clamp(36px, 4.5vw, 52px) 0 20px;
    padding-bottom: 12px; border-bottom: 1px solid var(--ink);
    line-height: 1.1;
  }

  .art-cta {
    margin: clamp(48px, 6vw, 72px) 0 clamp(40px, 5vw, 56px);
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .art-cta > div:first-child h2 {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.9vw, 29px);
    font-weight: 400; letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0 0 12px;
    line-height: 1.1;
  }
  .art-cta > div:first-child p {
    font-size: 16px;
    line-height: 1.72;
    color: var(--body);
    margin: 0 0 24px;
  }
  .art-cta-buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (min-width: 480px) {
    .art-cta-buttons {
      flex-direction: row;
    }
  }
  .art-cta-btn {
    flex: 1;
  }

  .art-disclaimer {
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    margin: clamp(32px, 4vw, 48px) 0 0;
    padding-top: clamp(24px, 3vw, 32px);
    border-top: 1px solid var(--line);
  }
</style>
