---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { topicOf, pickForLocale } from "../../../lib/i18n";

const all = await getCollection("posts");
const topics = Array.from(new Set(all.map((e) => topicOf(e.id))));
const posts = topics
  .map((topic) => pickForLocale(all, topic, "ar"))
  .filter((x): x is NonNullable<typeof x> => !!x)
  .map(({ entry }) => entry)
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));
---

<BaseLayout title="المدونة — مركز العمران الطبي">
  <div class="container page">
    <header class="page-head"><h1>المدونة</h1></header>
    <div class="post-list">
      {posts.map((p) => (
        <a class="post-card card" href={`/ar/blog/${topicOf(p.id)}/`}>
          <h3>{p.data.title}</h3>
          {p.data.description && <p>{p.data.description}</p>}
          {p.data.publishedAt && (
            <span class="date">
              {p.data.publishedAt.toLocaleDateString("ar-IQ", { year: "numeric", month: "short", day: "numeric" })}
            </span>
          )}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page { padding-block: 1.5rem 2.5rem; }
  @media (min-width: 640px) { .page { padding-block: 3rem 4rem; } }
  .page-head { text-align: center; max-width: 60ch; margin: 0 auto 1.5rem; }
  @media (min-width: 640px) { .page-head { margin-bottom: 3rem; } }
  .post-list { display: flex; flex-direction: column; gap: 1rem; }
  .post-card { display: block; text-decoration: none; color: inherit; }
  .post-card h3 { color: var(--brand); margin-bottom: 0.4em; }
  .post-card p { color: var(--ink-soft); margin-bottom: 0.5em; }
  .date { color: var(--ink-muted); font-size: 0.85rem; }
</style>
