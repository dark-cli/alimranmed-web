---
/**
 * Conditions & Procedures — Arabic. 1:1 port of the "care" view in
 * `Alimran Neurosurgery AR.dc.html` (lines 296–411).
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SoonLink from "../../../components/article/SoonLink.astro";
import { CONTACT } from "../../../consts";
import { localizedHref, currentLocale, topicOf, isLocale } from "../../../lib/i18n";
import { BLOG_PATHWAY } from "../../../lib/pathways";
import { getCollection } from "astro:content";

// Redesigned-flag lookup (shared with EN via the treatments collection).
const _allT = await getCollection("treatments");
const _bySlug: Record<string, boolean> = {};
_allT.filter((e) => isLocale(e.id, "en")).forEach((e) => {
  _bySlug[topicOf(e.id)] = e.data.redesigned === true;
});

const allBlogs = (await getCollection("blog"))
  .filter((e) => isLocale(e.id, "ar") && e.data.clinicallyRelevant === true)
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));

const blogsByPathway: Record<"brain" | "spine" | "pain", typeof allBlogs> = {
  brain: [], spine: [], pain: [],
};
for (const b of allBlogs) {
  const p = BLOG_PATHWAY[topicOf(b.id)];
  if (p) blogsByPathway[p].push(b);
}

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);
const callHref = `tel:${CONTACT.phones[0].replace(/\s/g, "")}`;
const secondCallHref = `tel:${CONTACT.phones[1].replace(/\s/g, "")}`;

// Curated "Procedures & therapies we offer" — 6 flagship service categories,
// 25 items total. Mirror of the EN page structure.
const procedureCategories = [
  { num: "الفئة ٠١", title: "العلاج الطبيعي", basePath: "physiotherapy",
    items: [
      { name: "العلاج الطبيعي",           slug: "physical-therapy" },
      { name: "التحفيز الكهربائي",         slug: "electrical-stimulation" },
      { name: "العلاج بالليزر",           slug: "laser-therapy" },
      { name: "العلاج بالموجات فوق الصوتية", slug: "ultrasound-therapy" },
      { name: "روبوت LUNA EMG",           slug: "luna-emg-robot" },
    ] },
  { num: "الفئة ٠٢", title: "تقويم العمود الفقري", basePath: "chiropractic",
    items: [
      { name: "تقويم العمود الفقري", slug: "chiropractic" },
      { name: "سيغما",              slug: "sigma" },
      { name: "SpineMED",           slug: "spinmed" },
    ] },
  { num: "الفئة ٠٣", title: "تحفيز الدماغ", basePath: "brain-stimulation",
    items: [
      { name: "TMS",              slug: "tms" },
      { name: "tDCS",             slug: "tdcs" },
      { name: "TMS للألم",         slug: "tms-pain" },
      { name: "TMS للطنين",        slug: "tms-tinnitus" },
      { name: "TMS للصداع النصفي", slug: "tms-migraine" },
    ] },
  { num: "الفئة ٠٤", title: "الترددات الراديوية", basePath: "radiofrequency",
    items: [
      { name: "الترددات الراديوية",             slug: "radiofrequency" },
      { name: "رأب النواة",                    slug: "nucleoplasty" },
      { name: "ترددات راديوية للعمود الفقري",   slug: "spine" },
      { name: "ترددات راديوية للركبة",         slug: "knee" },
      { name: "ترددات راديوية للعصب الثلاثي التوائم", slug: "trigeminal-neuralgia" },
    ] },
  { num: "الفئة ٠٥", title: "الجراحة", basePath: "surgery",
    items: [
      { name: "جراحة العمود الفقري بالمنظار", slug: "endoscopic-spine" },
      { name: "التحفيز العميق للدماغ",       slug: "dbs" },
      { name: "استئصال القرص القطني",        slug: "lumbar-microdiscectomy" },
      { name: "رأب الفقرة",                 slug: "vertebroplasty" },
      { name: "جراحة قاعدة الجمجمة عبر الأنف", slug: "transnasal-transsphenoidal" },
    ] },
  { num: "الفئة ٠٦", title: "الطب التجديدي", basePath: "regenerative-medicine",
    items: [
      { name: "برولوثيرابي",     slug: "prolotherapy" },
      { name: "الطب التجديدي",   slug: "regenerative-medicine" },
    ] },
];

const pathways = [
  { num: "المسار ٠١", title: "الدماغ", key: "brain" as const,
    items: [
      { name: "أورام الدماغ",       slug: "brain-tumor" },
      { name: "الجلطة الدماغية",     slug: "stroke" },
      { name: "الصرع والاختلاجات",   slug: "epilepsy-seizures" },
      { name: "إصابات الرأس",        slug: "head-injury" },
      { name: "داء باركنسون",        slug: "parkinsons-disease" },
      { name: "اضطرابات الحركة",     slug: "motor-disorders" },
      { name: "شلل الوجه النصفي",    slug: "bells-palsy" },
    ] },
  { num: "المسار ٠٢", title: "العمود الفقري", key: "spine" as const,
    items: [
      { name: "القرص المنزلق",       slug: "herniated-disc" },
      { name: "عرق النسا",           slug: "sciatica" },
      { name: "إصابات الحبل الشوكي", slug: "spinal-cord-injury" },
      { name: "الجَنَف",              slug: "scoliosis" },
      { name: "الحَنَف الظهري",       slug: "kyphosis" },
      { name: "إصابة السوط",         slug: "whiplash" },
      { name: "المثانة العصبية",     slug: "neurogenic-bladder" },
    ] },
  { num: "المسار ٠٣", title: "الألم", key: "pain" as const,
    items: [
      { name: "الصداع المزمن واليومي", slug: "headaches" },
      { name: "آلام الرقبة",           slug: "neck-pain" },
      { name: "آلام الظهر",            slug: "back-pain" },
      { name: "الكتف المتجمد",         slug: "frozen-shoulder" },
      { name: "آلام الركبة",           slug: "knee-pain" },
      { name: "الألم العضلي الليفي",   slug: "fibromyalgia" },
      { name: "آلام الأورام المستعصية", slug: "cancer-pain" },
    ] },
];

// Photo strip — visual break between the two hairline-grid sections.
const photoStrip = [
  {
    caption: "جراحة العمود الفقري بالمنظار",
    src: "https://images.unsplash.com/photo-1550831107-1553da8c8464?w=1200&q=80&auto=format&fit=crop",
    alt: "استشاري جراحة الأعصاب أثناء عملية",
  },
  {
    caption: "التحفيز العصبي",
    src: "/images/home/tms-treatment-768.jpg",
    alt: "جلسة تحفيز مغناطيسي عبر الجمجمة",
  },
  {
    caption: "الكيّ بالترددات الراديوية",
    src: "https://images.unsplash.com/photo-1754941622138-b3c3671f2fa8?w=1200&q=80&auto=format&fit=crop",
    alt: "جهاز علاجي مُطبَّق على مريض خلال جلسة",
  },
];
---

<BaseLayout
  title="الحالات والإجراءات — مركز العمران الطبي"
  description="يصنّف المركز الحالات المحوَّلة في ثلاثة مسارات: الدماغ، العمود الفقري، والألم. جراحات وتدخلات وإعادة تأهيل بفريق واحد."
>
  <section class="intro">
    <div class="intro-inner">
      <p class="intro-eyebrow">ما نعالج والإجراءات</p>
      <h1 class="intro-h1">ما الذي نقيّمه، وكيف نعالجه.</h1>
      <p class="intro-lede">يصنّف المركز الحالات المحوَّلة في ثلاثة مسارات. يشمل الموعد الأول فحصًا عصبيًا كاملًا ومراجعة للصور الشعاعية المتوفرة، وتُسلَّم خطة مكتوبة للمريض وللطبيب المحوِّل.</p>
    </div>
  </section>

  <!-- "ما نعالج" — Three pathway columns -->
  <section class="pathways-section">
    <header class="section-head">
      <span class="section-eyebrow">الحالات</span>
      <h2 class="section-h2">ما نعالج</h2>
    </header>
    <div class="pathway-grid">
      {pathways.map((p) => (
        <div class="pathway-cell">
          <p class="pathway-num">{p.num}</p>
          <h3 class="pathway-name">{p.title}</h3>
          <ul>
            {p.items.map((c) => (
              <li>
                <SoonLink
                  href={L(`/treatments/${c.slug}/`)}
                  redesigned={_bySlug[c.slug] === true}
                  soonLabel="هذا المقال لم يُنجَز بعد في التصميم الجديد — قريبًا."
                >{c.name}</SoonLink>
              </li>
            ))}
          </ul>
          {blogsByPathway[p.key].length > 0 && (
            <div class="pathway-reading">
              <p class="pathway-reading-label">قراءة ذات صلة</p>
              <ul class="pathway-reading-list">
                {blogsByPathway[p.key].slice(0, 4).map((b) => (
                  <li>
                    <a href={L(`/blog/${topicOf(b.id)}/`)}>{b.data.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </div>
    <p class="section-see-all">
      <a class="see-all-link" href={L("/treatments/")}>← عرض جميع الحالات</a>
    </p>
  </section>

  <!-- "الإجراءات والعلاجات" — 6 curated service categories -->
  <section class="pathways-section">
    <header class="section-head">
      <span class="section-eyebrow">الإجراءات</span>
      <h2 class="section-h2">الإجراءات والعلاجات التي نقدمها</h2>
    </header>
    <div class="pathway-grid">
      {procedureCategories.map((cat) => (
        <div class="pathway-cell">
          <p class="pathway-num">{cat.num}</p>
          <h3 class="pathway-name">{cat.title}</h3>
          <ul>
            {cat.items.map((it) => (
              <li>
                <a href={L(`/services/${cat.basePath}/${it.slug}/`)}>{it.name}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="section-see-all">
      <a class="see-all-link" href={L("/services/")}>← عرض جميع الإجراءات</a>
    </p>
  </section>

  <!-- Photo strip — visual break between hairline-grid sections and CTA. -->
  <section class="photo-strip">
    <div class="photo-strip-grid">
      {photoStrip.map((p) => (
        <figure class="photo-cell">
          <img src={p.src} alt={p.alt} width="1200" height="900" loading="lazy" />
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="appt-section">
    <div class="appt-card">
      <div>
        <h2 class="appt-h2">حجز موعد</h2>
        <p class="appt-body">تُحجز المواعيد هاتفيًا عبر سكرتارية المركز. يُرجى تحضير الصور الشعاعية السابقة وتقارير العمليات وقائمة الأدوية الحالية قبل الاتصال.</p>
      </div>
      <div class="appt-buttons">
        <a class="btn btn-primary appt-btn" href={callHref}><span dir="ltr">{CONTACT.phones[0]}</span></a>
        <a class="btn btn-secondary appt-btn" href={secondCallHref}><span dir="ltr">{CONTACT.phones[1]}</span></a>
      </div>
    </div>
  </section>

  <!-- Recent articles — general entry point; contextual reading is now
       shown inside each pathway column. -->
  {allBlogs.length > 0 && (
    <section class="related-section">
      <header class="section-head">
        <span class="section-eyebrow">المقالات</span>
        <h2 class="section-h2">جديد المدونة</h2>
      </header>
      <div class="related-grid">
        {allBlogs.slice(0, 6).map((blog) => (
          <a class="related-card card" href={L(`/blog/${topicOf(blog.id)}/`)}>
            <h3>{blog.data.title}</h3>
            {blog.data.description && <p>{blog.data.description}</p>}
            {blog.data.publishedAt && (
              <span class="date">{blog.data.publishedAt.toLocaleDateString("ar-IQ", { year: "numeric", month: "short", day: "numeric" })}</span>
            )}
          </a>
        ))}
      </div>
      <p class="section-see-all">
        <a class="see-all-link" href={L("/blog/")}>← عرض جميع المقالات</a>
      </p>
    </section>
  )}
</BaseLayout>

<style>
  .intro { border-bottom: 1px solid var(--line); background: var(--surface); }
  .intro-inner {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(44px, 5.5vw, 72px) 24px clamp(40px, 5vw, 64px);
  }
  .intro-eyebrow { font-size: 12px; letter-spacing: 0.04em; color: var(--accent); margin: 0 0 20px; }
  .intro-h1 {
    font-family: var(--font-display);
    font-size: clamp(30px, 5vw, 52px);
    line-height: 1.18; font-weight: 700;
    margin: 0 0 18px; color: var(--ink); max-width: 24ch;
  }
  .intro-lede { font-size: 17px; line-height: 1.85; color: var(--body); margin: 0; max-width: 64ch; }

  /* Section header — shared by "ما نعالج" / "الإجراءات" */
  .section-head {
    display: flex; gap: 14px; align-items: baseline;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 14px;
    margin-bottom: clamp(28px, 3.5vw, 44px);
  }
  .section-eyebrow { font-size: 13px; color: var(--muted); }
  .section-h2 {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.4vw, 34px);
    font-weight: 700; margin: 0; color: var(--ink); line-height: 1.22;
  }
  .section-see-all { margin: clamp(20px, 2vw, 28px) 0 0; text-align: end; }
  .see-all-link {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 14px; color: var(--accent); text-decoration: none;
  }
  .see-all-link:hover { color: var(--accent-hover); text-decoration: none; }

  .pathways-section {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(44px, 5.5vw, 72px) 24px 0;
  }
  .pathway-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(255px, 100%), 1fr));
    gap: 1px; background: var(--line); border: 1px solid var(--line);
  }
  .pathway-cell { background: var(--white); padding: 34px 30px; }
  .pathway-num { font-size: 12px; letter-spacing: 0.04em; color: var(--accent); margin: 0 0 6px; }
  .pathway-name {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.8vw, 28px);
    font-weight: 700; margin: 0 0 22px; color: var(--ink);
  }
  .pathway-cell ul { list-style: none; margin: 0; padding: 0; }
  .pathway-cell li {
    padding: 11px 0; border-top: 1px solid var(--line-soft);
    font-size: 15px;
  }
  /* :global(a) reaches into SoonLink's own scope so both plain <a> and
     SoonLink-rendered anchors get the same clickable styling. */
  .pathway-cell li :global(a) {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }
  .pathway-cell li :global(a):hover {
    color: var(--accent-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Mobile: cap each column at 4 items — full lists are one tap away
     via the "Browse all …" links. */
  @media (max-width: 639px) {
    .pathway-cell li:nth-child(n+5) { display: none; }
  }

  .pathway-reading {
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .pathway-reading-label {
    font-size: 12px;
    color: var(--muted);
    margin: 0 0 12px;
  }
  .pathway-reading-list { list-style: none; margin: 0; padding: 0; }
  .pathway-reading-list li { padding: 8px 0; border-top: none; font-size: 14px; }
  .pathway-reading-list li:first-child { padding-top: 0; }
  .pathway-reading-list a { color: var(--accent); text-decoration: none; line-height: 1.7; }
  .pathway-reading-list a:hover { color: var(--accent-hover); text-decoration: underline; }

  /* Photo strip — visual break between hairline-grid sections. */
  .photo-strip {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(48px, 6vw, 80px) 24px 0;
  }
  .photo-strip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: clamp(20px, 2.5vw, 32px);
  }
  .photo-cell { margin: 0; min-width: 0; }
  .photo-cell img {
    display: block; width: 100%; height: auto;
    aspect-ratio: 4 / 3; object-fit: cover;
    border: 1px solid var(--line);
  }
  .photo-cell figcaption {
    font-size: 13px; color: var(--muted);
    margin-top: 12px; text-align: center;
  }

  .appt-section {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(48px, 6vw, 80px) 24px clamp(56px, 7vw, 96px);
  }
  .appt-card {
    border: 1px solid var(--line); background: var(--surface);
    padding: clamp(28px, 4vw, 44px) clamp(24px, 3.5vw, 40px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(245px, 100%), 1fr));
    gap: 36px; align-items: center;
  }
  .appt-h2 { font-family: var(--font-display); font-size: clamp(24px, 3vw, 32px); font-weight: 700; margin: 0 0 12px; color: var(--ink); }
  .appt-body { font-size: 16px; line-height: 1.85; color: var(--body); margin: 0; max-width: 54ch; }
  .appt-buttons { display: flex; flex-direction: column; gap: 10px; }
  .appt-btn { min-height: 52px; font-size: 16px; justify-content: center; }

  /* Related articles */
  .related-section {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(48px, 6vw, 80px) 24px clamp(56px, 7vw, 96px);
    border-top: 1px solid var(--line);
  }
  .related-head {
    display: flex; gap: 12px; align-items: baseline; margin-bottom: clamp(28px, 4vw, 44px);
  }
  .related-num {
    font-family: var(--font-mono);
    font-size: 12px; letter-spacing: 0.12em; text-transform: capitalize;
    color: var(--accent);
  }
  .related-h2 {
    font-family: var(--font-display);
    font-size: clamp(23px, 3vw, 30px);
    font-weight: 700; margin: 0; color: var(--ink);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: clamp(20px, 2vw, 32px);
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .related-card {
    display: block; text-decoration: none; color: inherit;
    border: 1px solid var(--line); padding: clamp(20px, 2vw, 24px);
    border-radius: 2px; transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .related-card:hover {
    background: var(--surface); border-color: var(--accent);
  }
  .related-card h3 {
    font-size: 16px; font-weight: 700; margin: 0 0 8px; color: var(--ink);
  }
  .related-card p {
    font-size: 14px; line-height: 1.65; color: var(--body); margin: 0 0 12px;
  }
  .related-card .date {
    font-family: var(--font-mono); font-size: 12px; color: var(--muted);
  }
  .related-link {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--accent); text-decoration: none; font-size: 14px; font-weight: 700;
    transition: color 0.15s ease;
  }
  .related-link:hover { color: var(--accent-hover); }
</style>
