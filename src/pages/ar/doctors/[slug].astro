---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DoctorProfile from "../../../components/DoctorProfile.astro";
import TranslationBanner from "../../../components/TranslationBanner.astro";
import { topicOf, pickForLocale, dictFor } from "../../../lib/i18n";

const t = dictFor("ar");

export async function getStaticPaths() {
  const items = await getCollection("doctors");
  const topics = Array.from(new Set(items.map((e) => topicOf(e.id))));
  return topics.map((topic) => {
    const pick = pickForLocale(items, topic, "ar");
    return pick ? { params: { slug: topic }, props: pick } : null;
  }).filter(Boolean) as Array<{ params: { slug: string }; props: { entry: (typeof items)[number]; fallback: boolean } }>;
}

const { entry, fallback } = Astro.props;

// If we're falling back to EN content, use EN labels — mixing AR chrome with
// EN content is confusing. Only translate the labels when the content is truly AR.
const labels = fallback ? undefined : {
  back: `← ${t["nav.doctors"]}`,
  memberships: "العضويات",
  languages: "اللغات",
  book: t["cta.callUs"],
};
const backHref = "/ar/doctors/";
---

<BaseLayout title={`${entry.data.fullName} — مركز العمران الطبي`} description={entry.data.description}>
  {fallback ? (
    <div dir="ltr" lang="en" class="fallback-wrap">
      <div class="container banner-wrap">
        <TranslationBanner fromLocale="en" toLocale="ar" />
      </div>
      <DoctorProfile entry={entry} labels={undefined} backHref={backHref} />
    </div>
  ) : (
    <DoctorProfile entry={entry} labels={labels} backHref={backHref} />
  )}
</BaseLayout>

<style>
  .banner-wrap { padding-top: 1.25rem; }
  @media (min-width: 640px) { .banner-wrap { padding-top: 2rem; } }
</style>
