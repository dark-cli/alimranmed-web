---
/**
 * Doctors index — Arabic. Mirror of en/doctors/index.astro.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { topicOf, pickForLocale, dictFor, localizedHref, currentLocale } from "../../../lib/i18n";

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);

const t = dictFor("ar");
const all = await getCollection("doctors");
const topics = Array.from(new Set(all.map((e) => topicOf(e.id))));
const doctors = topics
  .map((topic) => pickForLocale(all, topic, "ar"))
  .filter((x): x is NonNullable<typeof x> => !!x)
  .map(({ entry }) => entry)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`${t["nav.doctors"]} — مركز العمران الطبي`}
  description="رعاية طبية بإشراف استشاري متخصص في جراحة الأعصاب والعمود الفقري وطب الألم — تعرّف على فريق العيادة."
>
  <section class="intro">
    <div class="intro-inner">
      <p class="intro-eyebrow">فريقنا</p>
      <h1 class="intro-h1">رعاية بإشراف استشاري من فريق متخصص صغير.</h1>
      <p class="intro-lede">كل مريض في مركز العمران يتابعه استشاري محدد بالاسم — لا يُمرَّر بين المناوبات. تعرّف على الأطباء الذين يرافقونك من الموعد الأول حتى التعافي.</p>
    </div>
  </section>

  <section class="doctors-band">
    <div class="doctor-grid">
      {doctors.map((d) => {
        const href = L(`/doctors/${topicOf(d.id)}/`);
        return (
          <a class="doctor-card" href={href}>
            {d.data.photo && (
              <div class="photo-wrap">
                <img class="photo" src={d.data.photo} alt={d.data.fullName} loading="lazy" />
              </div>
            )}
            <div class="card-body">
              {d.data.specialty && <p class="specialty">{d.data.specialty}</p>}
              <h2 class="name">{d.data.fullName || d.data.title}</h2>
              {d.data.titles.length > 0 && (
                <p class="creds">{d.data.titles.join(" · ")}</p>
              )}
              {d.data.description && (
                <p class="desc">{d.data.description}</p>
              )}
              <dl class="stats">
                {d.data.memberships.length > 0 && (
                  <div>
                    <dt>العضويات</dt>
                    <dd>{d.data.memberships.length} جمعية دولية</dd>
                  </div>
                )}
                {d.data.languages.length > 0 && (
                  <div>
                    <dt>اللغات</dt>
                    <dd>{d.data.languages.join("، ")}</dd>
                  </div>
                )}
              </dl>
              <p class="cta">
                <span>عرض الملف الكامل</span>
                <span class="cta-arrow" aria-hidden="true">←</span>
              </p>
            </div>
          </a>
        );
      })}
    </div>

    {doctors.length === 0 && (
      <p class="empty">سيظهر الأطباء هنا بعد إضافتهم.</p>
    )}
  </section>
</BaseLayout>

<style>
  .intro { border-bottom: 1px solid var(--line); background: var(--surface); }
  .intro-inner {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(44px, 5.5vw, 72px) 24px clamp(40px, 5vw, 64px);
  }
  .intro-eyebrow { font-size: 12px; color: var(--accent); margin: 0 0 20px; }
  .intro-h1 {
    font-family: var(--font-display);
    font-size: clamp(30px, 5vw, 52px);
    line-height: 1.18; font-weight: 700;
    margin: 0 0 18px; color: var(--ink); max-width: 26ch;
  }
  .intro-lede { font-size: 17px; line-height: 1.85; color: var(--body); margin: 0; max-width: 64ch; }

  .doctors-band {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(40px, 5vw, 64px) 24px clamp(56px, 7vw, 96px);
  }
  .doctor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(20px, 2.5vw, 32px);
  }

  .doctor-card {
    display: block; text-decoration: none; color: inherit;
    border: 1px solid var(--line); background: var(--white);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .doctor-card:hover {
    border-color: var(--accent); background: var(--surface);
    text-decoration: none;
  }

  .photo-wrap {
    display: block; aspect-ratio: 4 / 3;
    overflow: hidden; background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .photo {
    display: block; width: 100%; height: 100%;
    object-fit: cover; object-position: center top;
  }

  .card-body { padding: clamp(24px, 3vw, 32px); }

  .specialty { font-size: 13px; color: var(--accent); margin: 0 0 12px; }
  .name {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.8vw, 30px);
    font-weight: 700; line-height: 1.22;
    color: var(--ink); margin: 0 0 10px;
  }
  .doctor-card:hover .name { color: var(--accent); }

  .creds { font-size: 13px; color: var(--muted); line-height: 1.7; margin: 0 0 18px; }
  .desc { font-size: 15px; line-height: 1.85; color: var(--body); margin: 0 0 20px; }

  .stats {
    display: flex; flex-direction: column; gap: 12px;
    margin: 0 0 24px; padding-top: 18px;
    border-top: 1px solid var(--line-soft);
  }
  .stats div { display: flex; flex-direction: column; gap: 2px; }
  .stats dt { font-size: 13px; color: var(--muted); }
  .stats dd { margin: 0; font-size: 14px; color: var(--ink); }

  .cta {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 14px; color: var(--accent);
    margin: 0; padding-top: 4px;
  }
  .cta-arrow { font-size: 16px; transition: transform 0.15s ease; }
  .doctor-card:hover .cta-arrow { transform: translateX(-4px); }

  .empty {
    text-align: center; color: var(--muted);
    font-size: 14px; margin: 40px 0;
  }
</style>
