---
/**
 * Home — Alimran Clinic — Arabic (redesign Sep 2026).
 * 1:1 port of `Alimran Neurosurgery AR.dc.html`. Larger type + looser
 * leading than the EN version; Arabic-Indic numerals; RTL-mirrored grid.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACT } from "../../consts";
import { localizedHref, currentLocale } from "../../lib/i18n";

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);
const callHref = `tel:${CONTACT.phones[0].replace(/\s/g, "")}`;
const secondCallHref = `tel:${CONTACT.phones[1].replace(/\s/g, "")}`;
const cvHref = L("/doctors/hussein-imran-mousa/");
const conditionsHref = L("/conditions/");

const stats = [
  { fig: "+٥٠٠٠", desc: "عملية أجراها الاستشاري بشكل مستقل" },
  { fig: "٢٥",    desc: "عامًا من الخبرة في جراحة الجهاز العصبي" },
  { fig: "٤",     desc: "أقسام — الجراحة، إدارة الألم، العلاج الطبيعي، إعادة التأهيل" },
  { fig: "٦",     desc: "أيام عمل أسبوعيًا، مع مناوبة للحالات الطارئة" },
];

const services = [
  { title: "الجراحة",                       desc: "جراحة مفتوحة ومنظارية للدماغ والعمود الفقري، وتشمل الرضوح والأورام.",
    items: ["تثقيب الجمجمة", "مايكرودسك", "تثبيت الفقرات واستئصال القرص المنزلق", "استبدال القرص الاصطناعي", "العمليات المنظارية"] },
  { title: "إدارة الألم",                    desc: "حقن وكيّ موجَّه بالتصوير للألم الذي لم يستجب للأدوية.",
    items: ["الترددات الراديوية", "حقن فوق الجافية والمفاصل الفقرية", "تخدير العُقد الودّية", "حقن الستيرويد", "البوتوكس لعلاج الصداع"] },
  { title: "تحفيز الدماغ والأعصاب",           desc: "إجراءات تجسيمية ووظيفية لاضطرابات الحركة والألم المستعصي.",
    items: ["التحفيز العميق للدماغ", "قسطرة وتحفيز الحبل الشوكي", "المضخة داخل القراب", "قطع الجذور الظهرية الانتقائي", "التحفيز المغناطيسي عبر الجمجمة"] },
  { title: "إعادة التأهيل والعلاج الطبيعي",   desc: "تأهيل يبدأ في الردهة ويستمر في المركز بعد الخروج.",
    items: ["العلاج الطبيعي", "التأهيل بعد الجراحة", "الطب التجديدي", "العلاج بالأوزون", "تمارين ولياقة تحت الإشراف"] },
];

const pathways = [
  { num: "المسار ٠١", title: "الدماغ",          items: ["أورام الدماغ", "الجلطة الدماغية", "الصرع", "إصابات الرأس", "داء باركنسون", "اضطرابات الحركة"] },
  { num: "المسار ٠٢", title: "العمود الفقري",   items: ["الديسك", "عرق النسا", "إصابات الحبل الشوكي", "الجنف", "الحدب", "إصابة العنق"] },
  { num: "المسار ٠٣", title: "الألم",            items: ["الصداع المزمن", "آلام الرقبة", "آلام الظهر", "الكتف المتجمد", "آلام الركبة", "آلام الأورام"] },
];

const facilities = [
  {
    label: "الاستقبال", sub: "صالة الانتظار",
    src: "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=1200&q=80&auto=format&fit=crop",
    alt: "استقبال المركز الطبي",
  },
  {
    label: "غرفة الاستشارة", sub: "الفحص ومراجعة الصور",
    // صورة توضيحية مطلوبة — نُقلت صورة الاستشاري إلى قسم البطل أعلاه.
  },
  {
    label: "غرفة الإجراءات", sub: "تخفيف الضغط عن العمود الفقري وتدخلات الألم",
    src: "/images/home/DSC_0054-1-1024x684.jpg",
    alt: "طاولة SpineMED لتخفيف الضغط عن العمود الفقري",
  },
  {
    label: "قاعة التأهيل", sub: "العلاج الطبيعي والتمارين",
    src: "https://images.unsplash.com/photo-1649751361457-01d3a696c7e6?w=1200&q=80&auto=format&fit=crop",
    alt: "أخصائي علاج طبيعي يعمل على ركبة مريض",
  },
];

const insideFacts = [
  { label: "العنوان",      value: "مجمّع النقبة الطبي، البراهة، البصرة، العراق" },
  { label: "أيام العمل",   value: "ستة أيام أسبوعيًا، مع مناوبة للحالات الطارئة" },
  { label: "العمليات",     value: "مستشفى الصدر التعليمي، البصرة" },
  { label: "حالات الأورام", value: "تُراجع في مركز البصرة التخصصي للأورام" },
];

const consultantFacts = [
  { label: "الزمالات", value: "مستشفى جامعة سيؤول الوطنية؛ عيادة موبي للألم، مومباي" },
  { label: "العضويات", value: "AANS وNASS وAOSpine وIASP وخمس جمعيات أخرى" },
  { label: "التدريس",  value: "مشرف على أطباء البورد العربي في جراحة الأعصاب منذ ٢٠١٦" },
  { label: "البحوث",   value: "خمسة بحوث محكّمة، ومشاركات في يوكوهاما ودبي وتامبا" },
];
---

<BaseLayout
  title="مركز العمران الطبي — جراحة الأعصاب وطب الألم، البصرة"
  description="يعالج مركز العمران الطبي أمراض الدماغ والعمود الفقري والألم المزمن، بأربعة أقسام تعمل انطلاقًا من تقييم واحد."
>
  <!-- ─── HERO ───────────────────────────────────────────────── -->
  <section class="hero-band">
    <div class="container hero">
    <div class="hero-text">
      <div class="hero-text-inner">
        <p class="hero-eyebrow">مركز العمران الطبي — البصرة، العراق</p>
        <h1 class="hero-h1">مركز واحد يجمع التشخيص والجراحة وإعادة التأهيل.</h1>
        <p class="hero-p">يعالج مركز العمران الطبي أمراض الدماغ والعمود الفقري والألم المزمن، بأربعة أقسام تعمل انطلاقًا من تقييم واحد، فلا يُحال المريض بين خدمات غير مترابطة.</p>
        <p class="hero-p">جراحة الأعصاب · إدارة الألم · تحفيز الدماغ والأعصاب · العلاج الطبيعي وإعادة التأهيل.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={conditionsHref}>ما نعالج</a>
          <a class="btn btn-secondary" href={callHref}>اتصل بالسكرتارية</a>
        </div>

        <div class="hero-credit">
          <img
            class="hero-avatar"
            src="/images/doctors/hussein-imran-mousa.jpg"
            alt="حسين عمران موسى"
            width="52" height="52"
          />
          <div class="hero-credit-body">
            <p>بإشراف <strong>الدكتور حسين عمران موسى</strong>، استشاري جراحة الجهاز العصبي</p>
            <a class="hero-credit-link" href={cvHref}>بورد عربي وعراقي في جراحة الأعصاب — السيرة الكاملة ←</a>
          </div>
        </div>
      </div>
    </div>
    <img
      class="hero-photo hero-photo-img"
      src="https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?w=1600&q=80&auto=format&fit=crop"
      alt="استشاري يناقش خطة العلاج مع مريضة"
      width="1600" height="1067"
      loading="eager"
      fetchpriority="high"
    />
    </div>
  </section>

  <!-- ─── STAT BAND ──────────────────────────────────────────── -->
  <section class="stats">
    <div class="stats-grid">
      {stats.map((s) => (
        <div class="stat-cell">
          <p class="stat-fig">{s.fig}</p>
          <p class="stat-desc">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── 01 CARE UNDER ONE ROOF ─────────────────────────────── -->
  <section class="pg-section">
    <header class="pg-head">
      <span class="pg-num">٠١</span>
      <h2 class="pg-h2">الرعاية تحت سقف واحد</h2>
    </header>
    <p class="pg-lede">التشخيص والجراحة والتدخل لعلاج الألم وإعادة التأهيل يقدّمها فريق واحد، فلا ينتقل المريض بين خدمات متفرقة بين صورة الرنين والعودة إلى عمله.</p>
    <div class="care-grid">
      {services.map((s) => (
        <article class="care-cell">
          <p class="care-title">{s.title}</p>
          <p class="care-desc">{s.desc}</p>
          <ul class="care-list">
            {s.items.map((i) => <li>{i}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- ─── 02 CONDITIONS WE TREAT ─────────────────────────────── -->
  <section class="pg-section">
    <header class="pg-head">
      <span class="pg-num">٠٢</span>
      <h2 class="pg-h2">ما نعالج</h2>
    </header>
    <div class="pathways">
      {pathways.map((p) => (
        <div class="pathway">
          <div class="pathway-head">
            <span class="pathway-num">{p.num}</span>
            <h3 class="pathway-name">{p.title}</h3>
          </div>
          <div class="chips">
            {p.items.map((c) => <span class="chip">{c}</span>)}
          </div>
        </div>
      ))}
    </div>
    <a class="pg-quiet-link" href={conditionsHref}>كل الحالات والإجراء المستخدم لها ←</a>
  </section>

  <!-- ─── 03 INSIDE THE CLINIC ───────────────────────────────── -->
  <section class="pg-section">
    <header class="pg-head">
      <span class="pg-num">٠٣</span>
      <h2 class="pg-h2">داخل المركز</h2>
    </header>
    <div class="facility-grid">
      {facilities.map((f) => (
        f.src
          ? <img class="facility-slot facility-img" src={f.src} alt={f.alt} width="1200" height="900" loading="lazy" />
          : (
            <div class="facility-slot photo-slot" aria-hidden="true">
              <p>{f.label}<br>{f.sub}</p>
            </div>
          )
      ))}
    </div>
    <div class="inside-split">
      <div>
        <p class="inside-body">يقع المركز في مجمّع النقبة الطبي في البراهة بالبصرة، على مقربة من مستشفى الصدر التعليمي حيث تُجرى العمليات. الاستشارة الخارجية وإجراءات الألم اليومية والعلاج بعد الجراحة كلها في موقع المركز.</p>
        <a class="btn btn-secondary" href={CONTACT.mapsUrl} target="_blank" rel="noopener">الموقع على الخريطة</a>
      </div>
      <dl class="facts">
        {insideFacts.map((f) => (
          <div class="fact-row">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ─── 04 THE LEAD CONSULTANT ─────────────────────────────── -->
  <section class="pg-section">
    <header class="pg-head">
      <span class="pg-num">٠٤</span>
      <h2 class="pg-h2">الاستشاري المسؤول</h2>
    </header>
    <div class="inside-split">
      <div>
        <h3 class="consultant-name">الدكتور حسين عمران موسى</h3>
        <p class="consultant-quals">بكالوريوس طب وجراحة · زمالة البورد العراقي في جراحة الجهاز العصبي</p>
        <p class="consultant-body">استشاري جراحة الجهاز العصبي في مستشفى الصدر التعليمي، ومدير العراق في جمعية الشرق الأوسط للجراحة التجسيمية والوظيفية، مع زمالات في طب الألم التداخلي في سيؤول ومومباي.</p>
        <a class="pg-quiet-link" href={cvHref}>السيرة العلمية والبحوث والتدريب ←</a>
      </div>
      <dl class="facts">
        {consultantFacts.map((f) => (
          <div class="fact-row">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ─── REFERRAL BAND ──────────────────────────────────────── -->
  <section class="pg-section">
    <div class="referral-card">
      <div class="referral-copy">
        <p class="referral-eyebrow">للأطباء المحوِّلين</p>
        <p class="referral-body">يُرجى إرسال الصور الشعاعية وملخص الحالة إلى المركز قبل الموعد. تُصنَّف الحالات العاجلة من قبل السكرتارية في اليوم نفسه، ويُرسل تقرير الخطة إلى الطبيب المحوِّل بعد الاستشارة.</p>
      </div>
      <div class="referral-col">
        <p class="referral-label">السكرتارية</p>
        <p><a href={callHref}><span dir="ltr">{CONTACT.phones[0]}</span></a></p>
        <p><a href={secondCallHref}><span dir="ltr">{CONTACT.phones[1]}</span></a></p>
      </div>
      <div class="referral-col">
        <p class="referral-label">التحويل بالبريد الإلكتروني</p>
        <p><a href={`mailto:${CONTACT.email}`}><span dir="ltr">{CONTACT.email}</span></a></p>
      </div>
    </div>
  </section>

  <div class="tail-space" aria-hidden="true"></div>
</BaseLayout>

<style>
  /* HERO — contained inside the centered 1180px column (same as EN). */
  .hero-band { border-bottom: 1px solid var(--line); }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
    padding-block: 0;
  }
  @media (min-width: 980px) {
    .hero { grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr); }
  }
  .hero-text {
    padding-block: clamp(44px, 5.5vw, 88px);
    padding-inline-end: clamp(24px, 3.5vw, 48px);
    padding-inline-start: 0;
    display: flex; align-items: center; container-type: inline-size;
  }
  .hero-text-inner { width: 100%; max-width: 680px; }
  @media (max-width: 979px) {
    .hero-text { padding-block: clamp(44px, 5.5vw, 88px); padding-inline: 0; }
    .hero-text-inner { max-width: 100%; margin: 0 auto; }
  }

  .hero-eyebrow { font-size: 12px; letter-spacing: 0.04em; color: var(--accent); margin: 0 0 22px; }
  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 8cqw, 62px);
    line-height: 1.15;
    font-weight: 700;
    color: var(--ink);
    text-wrap: pretty;
    margin: 0 0 20px;
  }
  .hero-p {
    font-size: 17px; line-height: 1.85; color: var(--body);
    max-width: 54ch; text-wrap: pretty; margin: 0 0 14px;
  }
  .hero-p:last-of-type { margin-bottom: 34px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

  .hero-credit {
    margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--line);
    display: flex; flex-wrap: wrap; gap: 14px; align-items: center;
  }
  .hero-avatar {
    width: 52px; height: 52px; border-radius: 50%;
    object-fit: cover; object-position: 50% 30%;
    flex: 0 0 auto; display: block;
  }
  .hero-credit-body { min-width: 0; }
  .hero-credit-body p { margin: 0; font-size: 14.5px; color: var(--ink); line-height: 1.7; }
  .hero-credit-body strong { font-weight: 600; }
  .hero-credit-link {
    display: inline-block; margin-top: 2px;
    font-size: 13.5px; color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong); padding-bottom: 1px;
  }
  .hero-credit-link:hover { border-bottom-color: var(--accent); text-decoration: none; }

  .hero-photo {
    align-self: stretch; justify-self: stretch;
    min-height: min(72vw, 420px);
    border: 1px solid var(--line);
    order: -1;
  }
  @media (min-width: 980px) {
    .hero-photo { min-height: 560px; order: 0; }
  }
  .hero-photo-img { width: 100%; height: 100%; object-fit: cover; display: block; max-height: none; }
  .hero-photo p {
    font-size: 12px; color: var(--muted);
    text-align: center; margin: 0; padding: 0 28px; line-height: 2;
  }

  /* STAT BAND */
  .stats { border-bottom: 1px solid var(--line); background: var(--surface); }
  .stats-grid {
    max-width: var(--page-max); margin: 0 auto; padding: 0 24px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(175px, 100%), 1fr));
    gap: 1px; background: var(--line);
  }
  .stat-cell { background: var(--surface); padding: 32px 24px; }
  .stat-fig {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.4vw, 40px);
    line-height: 1.2; margin: 0 0 8px;
    color: var(--accent); font-weight: 700;
  }
  .stat-desc { margin: 0; font-size: 13.5px; line-height: 1.7; color: var(--body); }

  /* SECTION SHELL */
  .pg-section {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(48px, 6vw, 88px) 24px 0;
  }
  .pg-head {
    display: flex; align-items: baseline; gap: 20px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 14px; margin-bottom: 32px;
  }
  .pg-num { font-size: 12px; letter-spacing: 0.06em; color: var(--muted); }
  .pg-h2 {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.6vw, 36px);
    font-weight: 700; margin: 0; color: var(--ink); line-height: 1.22;
  }
  .pg-lede { font-size: 16px; line-height: 1.85; color: var(--body); margin: 0 0 36px; max-width: 72ch; }

  .pg-quiet-link {
    display: inline-block; margin-top: 32px;
    font-size: 14.5px; color: var(--accent); text-decoration: none;
    border-bottom: 1px solid var(--line-strong); padding-bottom: 1px;
  }
  .pg-quiet-link:hover { border-bottom-color: var(--accent); text-decoration: none; }

  /* 01 CARE */
  .care-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 1px; background: var(--line); border: 1px solid var(--line);
  }
  .care-cell { background: var(--white); padding: 32px 28px; }
  .care-title { font-size: 12px; letter-spacing: 0.04em; color: var(--accent); margin: 0 0 14px; }
  .care-desc { font-size: 15px; line-height: 1.8; color: var(--body); margin: 0 0 20px; }
  .care-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 9px; }
  .care-list li { font-size: 14.5px; color: var(--ink); border-top: 1px solid var(--line-soft); padding-top: 9px; }

  /* 02 PATHWAYS */
  .pathways {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(255px, 100%), 1fr));
    gap: 40px;
  }
  .pathway-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 16px; }
  .pathway-num { font-size: 12px; letter-spacing: 0.04em; color: var(--accent); }
  .pathway-name {
    font-family: var(--font-display);
    font-size: 24px; font-weight: 700; margin: 0; color: var(--ink);
  }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    font-size: 14px; color: var(--ink);
    border: 1px solid var(--line); background: var(--white); padding: 7px 12px;
  }

  /* 03 FACILITIES + SPLIT */
  .facility-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 20px; margin-bottom: 40px;
  }
  .facility-slot { aspect-ratio: 4 / 3; min-height: 0; padding: 0 18px; }
  .facility-img { padding: 0; object-fit: cover; width: 100%; height: 100%; border: 1px solid var(--line); }
  .facility-slot p { font-size: 12px; color: var(--muted); text-align: center; line-height: 1.9; margin: 0; }

  .inside-split {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(270px, 100%), 1fr));
    gap: clamp(32px, 4vw, 64px); align-items: start;
  }
  .inside-body { font-size: 16px; line-height: 1.85; color: var(--body); margin: 0 0 20px; max-width: 56ch; }

  .facts { margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .fact-row {
    display: grid; grid-template-columns: minmax(92px, 150px) minmax(0, 1fr);
    gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line);
  }
  .fact-row dt { font-size: 13px; color: var(--muted); margin: 0; }
