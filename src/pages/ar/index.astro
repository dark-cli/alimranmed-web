---
/**
 * Home — Alimran Clinic — Arabic (redesign Sep 2026).
 * Same structure as en/index.astro, mirrored for RTL per HANDOFF §6.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACT } from "../../consts";
import { localizedHref, currentLocale } from "../../lib/i18n";

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);
const callHref = `tel:${CONTACT.phones[0].replace(/\s/g, "")}`;
const cvHref = L("/doctors/hussein-imran-mousa/");
const conditionsHref = L("/conditions/");

// Arabic-Indic numerals per HANDOFF §2.3
const stats = [
  { fig: "+٥٬٠٠٠", label: "استشارة" },
  { fig: "٢٥",     label: "سنة خبرة" },
  { fig: "٤",      label: "مسارات علاجية" },
  { fig: "٦",      label: "أيام في الأسبوع" },
];

const services = [
  { num: "٠١", title: "جراحة الأعصاب",  desc: "أورام الدماغ، جراحة العمود الفقري، وجراحة الأعصاب التوجيهية.", procedures: ["فتح الجمجمة", "استئصال القرص المجهري", "استئصال الصفيحة", "خزعة توجيهية", "تحويل السائل الدماغي"] },
  { num: "٠٢", title: "طب الألم التداخلي", desc: "إجراءات موجّهة بالتصوير لعلاج الألم المزمن.", procedures: ["الترددات الراديوية", "حقن الكورتيزون فوق الجافية", "حصر الأعصاب", "حقن المفاصل الوجيهية", "علاج نقاط الانطلاق"] },
  { num: "٠٣", title: "التحفيز العصبي", desc: "تحفيز دماغي غير جراحي للسكتة والصداع النصفي والاكتئاب.", procedures: ["TMS", "tDCS", "التحفيز الطرفي", "التحفيز المبهمي", "رسم القشرة الحركية"] },
  { num: "٠٤", title: "التعافي والعلاج", desc: "برامج تأهيل وعلاج طبيعي وطب تجديدي بإشراف استشاري.", procedures: ["العلاج الطبيعي", "الكيروبراكتيك", "الطب التجديدي", "التدريب الرياضي", "علاج الأوزون"] },
];

const pathways = [
  { title: "الدماغ", items: ["ورم الدماغ", "السكتة الدماغية", "الصرع", "إصابة الرأس", "شلل بيل", "ألم العصب الثلاثي", "استسقاء الدماغ"] },
  { title: "العمود الفقري", items: ["الانزلاق الغضروفي", "عرق النسا", "الجنف", "تضيّق النخاع", "إصابة العنق", "إصابة النخاع الشوكي", "الحداب"] },
  { title: "الألم",  items: ["ألم الظهر", "ألم الرقبة", "ألم الركبة", "الكتف المتجمدة", "الألم العضلي الليفي", "الصداع", "التهاب المفاصل"] },
];
---

<BaseLayout
  title="مركز العمران — جراحة الأعصاب وطب الألم في البصرة"
  description="رعاية استشارية متخصصة في جراحة الأعصاب وطب الألم والتأهيل — البصرة، العراق. بإشراف الدكتور حسين عمران موسى، استشاري جراحة الأعصاب."
>
  <!-- ─── Hero ───────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">مركز العمران · البصرة، العراق</span>
        <h1>جراحة أعصاب وطب ألم وتأهيل استشاري — تحت سقف واحد.</h1>
        <p class="hero-lede">
          مسار موحّد من التشخيص إلى إعادة التأهيل، بإشراف استشاري متخصص
          يمتلك ٢٥ سنة من الخبرة في الدماغ والعمود الفقري وطب الألم.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={callHref}>اتصل بالسكرتير</a>
          <a class="btn btn-secondary" href={conditionsHref}>تعرّف على ما نعالج</a>
        </div>

        <div class="doctor-credit">
          <div class="doctor-avatar photo-slot photo-slot--4x5" aria-hidden="true">
            صورة<br>٥٢ × ٥٢
          </div>
          <p>
            بإشراف <a class="link-quiet" href={cvHref}>الدكتور حسين عمران موسى</a>،
            استشاري جراحة الأعصاب &nbsp;·&nbsp; MBChB · FIBMS
          </p>
        </div>
      </div>

      <div class="hero-photo photo-slot photo-slot--landscape">
        صورة للمركز<br>
        الواجهة أو الاستقبال أو غرفة العلاج<br>
        أفقية · بعرض ١٦٠٠ بكسل على الأقل
      </div>
    </div>
  </section>

  <!-- ─── Stat band ──────────────────────────────────────────── -->
  <section class="stats" aria-label="لمحة سريعة">
    <div class="container">
      <div class="grid-hairline grid-hairline--surface stat-grid">
        {stats.map((s) => (
          <div class="stat-cell">
            <div class="stat-fig">{s.fig}</div>
            <div class="eyebrow">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── 01 Care under one roof ─────────────────────────────── -->
  <section class="section" id="care">
    <div class="container">
      <header class="section-head">
        <span class="section-num">٠١</span>
        <h2 class="section-title">رعاية شاملة تحت سقف واحد</h2>
      </header>
      <div class="grid-hairline services-grid">
        {services.map((s) => (
          <article class="service-cell">
            <span class="service-num eyebrow">{s.num}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <ul class="service-list">
              {s.procedures.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── 02 Conditions we treat ─────────────────────────────── -->
  <section class="section section-tinted" id="conditions">
    <div class="container">
      <header class="section-head">
        <span class="section-num">٠٢</span>
        <h2 class="section-title">حالات نعالجها</h2>
      </header>
      <div class="pathways-grid">
        {pathways.map((p) => (
          <div class="pathway-col">
            <h3 class="pathway-head">
              <span class="eyebrow">المسار</span>
              <span class="pathway-title">{p.title}</span>
            </h3>
            <ul class="pathway-list">
              {p.items.map((c) => <li>{c}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <div class="section-cta">
        <a class="btn btn-secondary" href={conditionsHref}>جميع الحالات والإجراءات ←</a>
      </div>
    </div>
  </section>

  <!-- ─── 03 Inside the clinic ───────────────────────────────── -->
  <section class="section" id="inside">
    <div class="container">
      <header class="section-head">
        <span class="section-num">٠٣</span>
        <h2 class="section-title">داخل المركز</h2>
      </header>
      <div class="grid-hairline facilities-grid">
        <div class="photo-slot photo-slot--4x3">الاستقبال<br>أفقية · بعرض ١٦٠٠ بكسل على الأقل</div>
        <div class="photo-slot photo-slot--4x3">غرفة الاستشارة<br>أفقية · بعرض ١٦٠٠ بكسل على الأقل</div>
        <div class="photo-slot photo-slot--4x3">غرفة الإجراءات<br>أفقية · بعرض ١٦٠٠ بكسل على الأقل</div>
        <div class="photo-slot photo-slot--4x3">صالة العلاج<br>أفقية · بعرض ١٦٠٠ بكسل على الأقل</div>
      </div>
      <div class="location-facts">
        <div class="register register-single">
          <div class="register-rows">
            <p><strong>الموقع</strong> — {CONTACT.addresses.ar}</p>
            <p><strong>ساعات العمل</strong> — السبت-الخميس ٠٩:٠٠-١٨:٠٠، الجمعة ١٤:٠٠-١٨:٠٠</p>
            <p><strong>الاتجاهات</strong> — <a href={CONTACT.mapsUrl} target="_blank" rel="noopener">افتح في خرائط جوجل ←</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 04 The lead consultant ─────────────────────────────── -->
  <section class="section section-tinted" id="consultant">
    <div class="container">
      <header class="section-head">
        <span class="section-num">٠٤</span>
        <h2 class="section-title">الاستشاري الرئيسي</h2>
      </header>
      <div class="consultant-grid">
        <div class="consultant-highlight">
          <h3>الدكتور حسين عمران موسى</h3>
          <p class="eyebrow">استشاري جراحة الأعصاب · مستشفى البصرة التعليمي · مركز العمران</p>
          <p class="consultant-lede">
            زميل المجلس العراقي للاختصاصات الطبية في جراحة الأعصاب، وعضو الجمعية الأمريكية لجراحي الأعصاب،
            والجمعية الدولية للجراحة المتقدمة وغير الجراحية للعمود الفقري. المدير الإقليمي لجمعية الشرق الأوسط
            لجراحة الأعصاب التوجيهية والوظيفية.
          </p>
          <p><a class="link-quiet" href={cvHref}>اقرأ السيرة الكاملة ←</a></p>
        </div>
        <div class="consultant-facts">
          <div class="register">
            <p class="register-label">منذ</p>
            <div class="register-rows">
              <p>٢٠٠٦ — استشاري جراحة الأعصاب</p>
            </div>
          </div>
          <div class="register">
            <p class="register-label">الزمالات</p>
            <div class="register-rows">
              <p><span dir="ltr">FIBMS (Neurosurgery)</span></p>
              <p><span dir="ltr">FIAANS</span></p>
              <p><span dir="ltr">FIISSP · FINASS</span></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Referral band ──────────────────────────────────────── -->
  <section class="referral">
    <div class="container referral-inner">
      <div>
        <span class="eyebrow">للأطباء المحيلين</span>
        <h2 class="referral-title">تحويل مريض</h2>
        <p>خط مباشر للسكرتير لجدولة المواعيد؛ يمكن إرسال الصور والتقارير على البريد الإلكتروني.</p>
      </div>
      <div class="referral-contact">
        {CONTACT.phones.map((p) => (
          <a class="referral-phone" href={`tel:${p.replace(/\s/g, "")}`}>
            <span dir="ltr">{p}</span>
          </a>
        ))}
        <a class="referral-email" href={`mailto:${CONTACT.email}`}>
          <span dir="ltr">{CONTACT.email}</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Same styles as en/index.astro — kept per-page so each locale can tweak
     independently if type metrics ever diverge. */
  .hero { padding-block: var(--hero-y); }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--col-gap);
    align-items: start;
    container-type: inline-size;
  }
  @media (min-width: 980px) { .hero-inner { grid-template-columns: 1fr 1fr; align-items: center; } }
  .hero-copy .eyebrow { display: block; margin-bottom: 20px; }
  .hero-copy h1 {
    font-size: clamp(30px, 7.6cqw, 58px);
    line-height: 1.22;
    margin: 0 0 24px;
    max-width: 16ch;
  }
  .hero-lede {
    font-size: clamp(16.5px, 1.9vw, 19px);
    line-height: 1.9;
    color: var(--body);
    max-width: 52ch;
    margin-bottom: 32px;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 40px; }
  .doctor-credit {
    display: flex; align-items: center; gap: 16px;
    padding-top: 24px; border-top: 1px solid var(--line);
  }
  .doctor-avatar {
    width: 52px; height: 52px; min-height: 0; padding: 0;
    aspect-ratio: 1; font-size: 9px; flex-shrink: 0;
  }
  .doctor-credit p { font-size: 14px; color: var(--body); margin: 0; }
  .hero-photo { order: -1; min-height: 320px; }
  @media (min-width: 980px) { .hero-photo { order: 0; min-height: 460px; } }

  .stats { padding-block: 0; }
  .stat-grid { grid-template-columns: repeat(auto-fit, minmax(min(175px, 100%), 1fr)); }
  .stat-cell { text-align: start; }
  .stat-fig {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.4vw, 40px);
    line-height: 1;
    color: var(--accent);
    margin-bottom: 10px;
    font-weight: 700;
  }

  .services-grid { grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .service-cell { display: flex; flex-direction: column; gap: 12px; }
  .service-num { color: var(--muted); }
  .service-cell h3 { margin: 0; font-size: clamp(20px, 2.6vw, 26px); }
  .service-cell p { color: var(--body); font-size: 15px; line-height: 1.9; }
  .service-list { list-style: none; padding: 0; margin: 8px 0 0; }
  .service-list li {
    padding: 10px 0; border-top: 1px solid var(--line-soft);
    font-size: 14px; color: var(--body);
  }

  .pathways-grid { display: grid; gap: 40px; grid-template-columns: repeat(auto-fit, minmax(min(255px, 100%), 1fr)); }
  .pathway-col { background: var(--white); padding: 28px; border: 1px solid var(--line); }
  .pathway-head { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
  .pathway-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 28px);
    color: var(--ink);
    font-weight: 700;
  }
  .pathway-list { list-style: none; padding: 0; margin: 0; }
  .pathway-list li {
    padding: 12px 0; border-top: 1px solid var(--line-soft);
    font-size: 15px; color: var(--body);
  }
  .pathway-list li:first-child { border-top: 1px solid var(--line); }
  .section-cta { margin-top: 40px; text-align: center; }

  .facilities-grid { grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .facilities-grid > .photo-slot { padding: 24px; }
  .location-facts { margin-top: 32px; }
  .register-single { grid-template-columns: 1fr; padding-block: 24px; border-top: 1px solid var(--line); }
  .register-single .register-rows > p { padding: 10px 0; font-size: 15px; }
  .register-single strong {
    color: var(--muted); font-weight: 500;
    font-family: var(--font-body); font-size: 14px;
    margin-inline-end: 8px;
  }

  .consultant-grid { display: grid; gap: var(--col-gap); grid-template-columns: 1fr; }
  @media (min-width: 900px) { .consultant-grid { grid-template-columns: 1.4fr 1fr; } }
  .consultant-highlight h3 { font-size: clamp(24px, 3vw, 32px); margin: 0 0 8px; }
  .consultant-highlight .eyebrow { display: block; margin-bottom: 16px; }
  .consultant-lede { font-size: 16px; line-height: 1.9; color: var(--body); max-width: 55ch; }
  .consultant-facts .register:first-child { border-top: 0; padding-top: 0; }

  .referral { background: var(--surface); padding-block: var(--section-y-last); }
  .referral-inner {
    display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center;
  }
  @media (min-width: 800px) { .referral-inner { grid-template-columns: 1.2fr 1fr; } }
  .referral .eyebrow { display: block; margin-bottom: 12px; }
  .referral-title { margin: 0 0 8px; font-size: clamp(24px, 3vw, 32px); }
  .referral p { color: var(--body); max-width: 42ch; }
  .referral-contact { display: flex; flex-direction: column; gap: 12px; }
  .referral-phone, .referral-email {
    display: block; padding: 18px 20px;
    background: var(--white); border: 1px solid var(--line);
    color: var(--accent); font-size: 16px; text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .referral-phone:hover, .referral-email:hover {
    border-color: var(--accent); text-decoration: none;
  }
</style>
