---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { topicOf, pickForLocale, dictFor } from "../../../../lib/i18n";

const t = dictFor("ar");

export async function getStaticPaths() {
  const all = await getCollection("services");
  const topics = Array.from(new Set(all.map((e) => topicOf(e.id))));
  const arPickups = topics.map((topic) => pickForLocale(all, topic, "ar")).filter((x): x is NonNullable<typeof x> => !!x);
  const arEntries = arPickups.map(({ entry }) => entry);

  const byCategory = new Map<string, typeof arEntries>();
  for (const entry of arEntries) {
    const topic = topicOf(entry.id);
    if (!topic.includes("/")) continue;
    const [category] = topic.split("/");
    if (!byCategory.has(category)) byCategory.set(category, []);
    byCategory.get(category)!.push(entry);
  }
  return [...byCategory.entries()].map(([category, entries]) => {
    // Find the category pickup (which includes the entry and fallback flag) to get its Arabic title
    const categoryPickup = arPickups.find((p) => topicOf(p.entry.id) === category);
    const categoryEntry = categoryPickup?.entry;
    return {
      params: { category },
      props: { category, entries, categoryEntry },
    };
  });
}

const { category, entries, categoryEntry } = Astro.props;
const sorted = entries.sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
// Use the Arabic title from the category entry if it exists, otherwise fallback to titlecased slug
const categoryTitle = categoryEntry?.data.title || category.split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join(" ");
---

<BaseLayout title={`${categoryTitle} — مركز العمران الطبي`}>
  <div class="container page">
    <header class="page-head">
      <a class="back" href="/ar/services/">← {t["nav.services"]}</a>
      <h1>{categoryTitle}</h1>
    </header>

    <div class="grid">
      {sorted.map((entry) => (
        <a class="card entry" href={`/ar/services/${topicOf(entry.id)}/`}>
          <h3>{entry.data.title}</h3>
          {entry.data.description && <p>{entry.data.description}</p>}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page { padding-block: 1.5rem 2.5rem; }
  @media (min-width: 640px) { .page { padding-block: 3rem 4rem; } }
  .page-head { text-align: center; max-width: 60ch; margin: 0 auto 1.5rem; }
  @media (min-width: 640px) { .page-head { margin-bottom: 3rem; } }
  .page-head h1 { text-transform: capitalize; }
  .back { display: inline-block; margin-bottom: 1rem; font-size: 0.9rem; color: var(--ink-soft); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; }
  .entry { text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 0.5rem; }
  .entry h3 { color: var(--brand); margin: 0; }
  .entry p { color: var(--ink-soft); margin: 0; font-size: 0.95rem; }
</style>
