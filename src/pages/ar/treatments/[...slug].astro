---
/**
 * Treatment article — Arabic. Mirror of en/treatments/[...slug].astro
 * with Arabic-Indic numerals, plural reading time, RTL type sizes.
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { topicOf, pickForLocale, localizedHref, currentLocale } from "../../../lib/i18n";
import { CONTACT } from "../../../consts";
import ArticleSections from "../../../components/article/ArticleSections.astro";

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);
const callHref = `tel:${CONTACT.phones[0].replace(/\s/g, "")}`;
const secondCallHref = `tel:${CONTACT.phones[1].replace(/\s/g, "")}`;

export async function getStaticPaths() {
  const items = await getCollection("treatments");
  const topics = Array.from(new Set(items.map((e) => topicOf(e.id))));
  return topics.map((topic) => {
    const pick = pickForLocale(items, topic, "ar");
    return pick ? { params: { slug: topic }, props: pick } : null;
  }).filter(Boolean) as Array<{ params: { slug: string }; props: { entry: (typeof items)[number]; fallback: boolean } }>;
}

const { entry } = Astro.props;
const isRedesigned = entry.data.redesigned === true;
const { Content, headings } = await render(entry);

const PATHWAY: Record<string, { label: string; pathway: string }> = {
  brain: { label: "الدماغ",        pathway: "الدماغ — جراحي" },
  spine: { label: "العمود الفقري",  pathway: "العمود الفقري — جراحي" },
  pain:  { label: "الألم",          pathway: "الألم — تداخلي" },
};
const cat = ((entry.data as { pathwayOverride?: string; category?: string })
  .pathwayOverride || entry.data.category || "pain").toLowerCase();
const pathway = PATHWAY[cat] || PATHWAY.pain;

function toArabicDigits(n: number): string {
  return String(n).replace(/[0-9]/g, (d) => "٠١٢٣٤٥٦٧٨٩"[Number(d)]);
}
function readingTimeAr(n: number): string {
  if (n <= 1) return "دقيقة واحدة";
  if (n === 2) return "دقيقتان";
  if (n <= 10) return `${toArabicDigits(n)} دقائق`;
  return `${toArabicDigits(n)} دقيقة`;
}

// Word count walks the section blocks (redesigned articles keep their
// text there, not in the markdown body). Arabic reads slower than
// English, so 140 wpm reflects clinical Arabic prose realistically.
function wordsIn(v: unknown): number {
  if (v == null) return 0;
  if (typeof v === "string") {
    const t = v.replace(/!\[[^\]]*]\([^)]+\)/g, "").trim();
    return t ? t.split(/\s+/).length : 0;
  }
  if (Array.isArray(v)) return v.reduce((n, x) => n + wordsIn(x), 0);
  if (typeof v === "object") return Object.values(v as Record<string, unknown>).reduce((n, x) => n + wordsIn(x), 0);
  return 0;
}
const wordCount =
  wordsIn((entry.data as { sections?: unknown }).sections) +
  wordsIn(entry.body);
const readingLabel = readingTimeAr(Math.max(1, Math.round(wordCount / 140)));

const publishedAt: unknown = (entry.data as { publishedAt?: unknown }).publishedAt;
const lastReviewed = publishedAt
  ? new Date(publishedAt as string).toLocaleDateString("ar-IQ", { month: "long", year: "numeric" })
  : "—";

type TocItem = { id: string; text: string; num: string };
let toc: TocItem[] = [];
if (isRedesigned && Array.isArray(entry.data.sections)) {
  let n = 0;
  entry.data.sections.forEach((s: { type: string; heading?: string }) => {
    if (!("heading" in s) || !s.heading) return;
    n += 1;
    toc.push({ id: `s-${n}`, text: s.heading, num: toArabicDigits(n).padStart(2, "٠") });
  });
} else {
  toc = (headings || [])
    .filter((h) => h.depth === 2)
    .map((h, i) => ({ id: h.slug, text: h.text, num: toArabicDigits(i + 1).padStart(2, "٠") }));
}
const showToc = toc.length >= 2;

const allTreatments = await getCollection("treatments");
function resolveRelated(slugs: string[]) {
  return slugs.map((slug) => {
    const pick = pickForLocale(allTreatments, `treatments/${slug}`, "ar");
    if (!pick) return null;
    const found = pick.entry;
    const rd = found.data.redesigned === true;
    const rcat = (found.data.pathwayOverride || found.data.category || "pain").toLowerCase();
    return {
      slug,
      title: found.data.title,
      category: PATHWAY[rcat]?.label || "الألم",
      href: rd ? L(`/treatments/${slug}/`) : "",
      redesigned: rd,
    };
  }).filter(Boolean) as {
    slug: string; title: string; category: string; href: string; redesigned: boolean;
  }[];
}

const standfirst = entry.data.description || "";
---

<BaseLayout title={`${entry.data.title} — مركز العمران الطبي`} description={standfirst}>
  <section class="art-head-band">
    <div class="art-head-wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={L("/")}>الرئيسية</a>
        <span class="crumb-sep" aria-hidden="true">‹</span>
        <a href={L("/conditions/")}>الحالات والإجراءات</a>
        <span class="crumb-sep" aria-hidden="true">‹</span>
        <span class="crumb-current">{pathway.label}</span>
      </nav>
      <div class="art-head-grid">
        <div class="art-head-copy">
          <h1 class="art-h1">{entry.data.title}</h1>
          {standfirst && <p class="art-standfirst">{standfirst}</p>}
        </div>
        <dl class="art-meta">
          <div><dt>المسار</dt><dd>{pathway.pathway}</dd></div>
          <div><dt>تمت المراجعة من قبل</dt><dd>الدكتور حسين عمران موسى، استشاري جراحة الأعصاب</dd></div>
          <div><dt>وقت القراءة</dt><dd>{readingLabel}</dd></div>
          <div><dt>آخر مراجعة</dt><dd>{lastReviewed}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <div class="art-container">
    <div class="art-grid">
      <aside class="art-aside">
        {showToc && (
          <nav class="art-toc" aria-label="في هذه الصفحة">
            <p class="art-toc-label">في هذه الصفحة</p>
            <span class="art-toc-rule" aria-hidden="true"></span>
            {toc.map((t) => (<a href={`#${t.id}`}>{t.text}</a>))}
          </nav>
        )}
        <div class="art-call-card">
          <p class="art-call-label">للاستفسار</p>
          <p class="art-call-body">تحدث مع السكرتير لحجز استشارة حول هذه الحالة.</p>
          <a class="art-call-btn" href={callHref} dir="ltr">{CONTACT.phones[0]}</a>
        </div>
      </aside>

      <article class="art-body">
        {isRedesigned && Array.isArray(entry.data.sections) ? (
          <ArticleSections sections={entry.data.sections} locale={locale} resolveRelated={resolveRelated} />
        ) : (
          <div class="art-prose">
            <Content />
          </div>
        )}

        <section class="art-cta">
          <div>
            <h2>احجز استشارة</h2>
            <p>يقوم السكرتير بجدولة المواعيد الأولى خلال ساعات العمل. يُرجى تحضير الصور الشعاعية السابقة وتقارير العمليات وقائمة الأدوية الحالية قبل الاتصال.</p>
          </div>
          <div class="art-cta-buttons">
            <a class="btn btn-primary art-cta-btn" href={callHref} dir="ltr">{CONTACT.phones[0]}</a>
            <a class="btn btn-secondary art-cta-btn" href={secondCallHref} dir="ltr">{CONTACT.phones[1]}</a>
          </div>
        </section>

        <p class="art-disclaimer">
          تقدم هذه الصفحة معلومات عامة حول {entry.data.title} وليست بديلاً عن التقييم الطبي الفردي.
          إذا كانت أعراضك شديدة أو تزداد سوءاً، فاتصل بطبيب على الفور.
        </p>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  /* Same shell as EN; only the labels above differ. Type sizes for the head
     h1 and body come from the RTL global overrides (rtl-overrides.css) plus
     the AR line-heights baked into the block components themselves. */
  .art-head-band { border-bottom: 1px solid var(--line); }
  .art-head-wrap {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(24px, 3.5vw, 40px) 24px clamp(32px, 4.5vw, 52px);
  }
  .crumbs {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
    margin-bottom: clamp(24px, 3.5vw, 36px);
  }
  .crumbs a { font-size: 13px; color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); text-decoration: none; }
  .crumb-sep { color: var(--line-strong); font-size: 12px; }
  .crumb-current { font-size: 13px; color: var(--accent); }

  .art-head-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(290px, 100%), 1fr));
    gap: clamp(24px, 4vw, 64px); align-items: end;
  }
  .art-head-copy { container-type: inline-size; min-width: 0; }
  .art-h1 {
    font-family: var(--font-display);
    font-size: clamp(28px, 7.4cqw, 52px);
    line-height: 1.22; font-weight: 700; letter-spacing: 0;
    margin: 0 0 18px; color: var(--ink); text-wrap: pretty;
  }
  .art-standfirst {
    font-size: clamp(16.5px, 1.9vw, 19px); line-height: 1.9;
    color: var(--body); max-width: 58ch; text-wrap: pretty; margin: 0;
  }
  .art-meta {
    margin: 0; display: flex; flex-direction: column; gap: 13px;
    border-inline-start: 1px solid var(--line);
    padding-inline-start: clamp(18px, 2.5vw, 28px);
    min-width: 0;
  }
  .art-meta dt {
    font-size: 12px; letter-spacing: 0.02em;
    color: var(--muted); margin-bottom: 4px;
  }
  .art-meta dd { margin: 0; font-size: 15px; color: var(--ink); line-height: 1.7; }

  .art-container {
    max-width: var(--page-max); margin: 0 auto;
    padding: 0 24px; container-type: inline-size;
  }
  .art-grid {
    display: grid; grid-template-columns: minmax(0, 1fr);
    gap: clamp(28px, 4vw, 72px); align-items: start;
  }
  .art-aside { padding-top: clamp(32px, 4.5vw, 56px); min-width: 0; position: static; }
  .art-toc { display: none; flex-direction: column; }
  @container (min-width: 820px) {
    .art-grid { grid-template-columns: minmax(0, 240px) minmax(0, 1fr); }
    .art-grid > .art-body { max-width: 740px; }
    .art-aside { position: sticky; top: 96px; }
    .art-toc { display: flex; }
  }

  .art-toc-label { font-size: 13px; color: var(--muted); margin: 0 0 14px; }
  .art-toc-rule { display: block; border-top: 1px solid var(--ink); }
  .art-toc a {
    display: block; font-size: 15px; line-height: 1.7;
    color: var(--body); padding: 11px 0;
    border-bottom: 1px solid var(--line-soft); text-decoration: none;
  }
  .art-toc a:hover { color: var(--accent); text-decoration: none; }

  .art-call-card {
    display: none;   /* mobile: FAB below takes over */
    margin-top: 24px; border: 1px solid var(--line);
    background: var(--surface); padding: 20px;
  }
  @container (min-width: 820px) {
    .art-call-card { display: block; }
  }

  .art-call-label { font-size: 13px; color: var(--accent); margin: 0 0 10px; }
  .art-call-body { font-size: 14px; line-height: 1.9; color: var(--body); margin: 0 0 16px; }
  .art-call-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 100%; min-height: 44px; padding: 0 16px;
    background: var(--accent); color: var(--white);
    font-size: 14.5px; font-weight: 500; border-radius: 2px;
    text-decoration: none;
  }
  .art-call-btn:hover { background: var(--accent-hover); color: var(--white); text-decoration: none; }

  .art-body { padding: clamp(32px, 4.5vw, 56px) 0 0; min-width: 0; }

  .art-prose { color: var(--ink); }
  .art-prose :global(p) {
    font-size: 17px; line-height: 1.95; color: var(--body);
    margin: 0 0 20px; text-wrap: pretty;
  }
  .art-prose :global(h2) {
    scroll-margin-top: 96px; font-family: var(--font-display);
    font-size: clamp(23px, 3.1vw, 30px); font-weight: 700; color: var(--ink);
    margin: clamp(36px, 4.5vw, 52px) 0 20px;
    padding-bottom: 12px; border-bottom: 1px solid var(--ink); line-height: 1.22;
  }
  .art-prose :global(h3) {
    font-family: var(--font-display);
    font-size: 21px; font-weight: 700; color: var(--ink);
    margin: clamp(28px, 3.5vw, 38px) 0 14px; line-height: 1.3;
  }
  .art-prose :global(strong) { font-weight: 600; color: var(--ink); }
  .art-prose :global(ul), .art-prose :global(ol) {
    list-style: none; margin: 0 0 24px; padding: 0;
    border-top: 1px solid var(--line);
  }
  .art-prose :global(li) {
    display: grid; grid-template-columns: 28px minmax(0, 1fr);
    gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line);
    font-size: 16px; line-height: 1.9; color: var(--body);
  }
  .art-prose :global(li)::before { content: "·"; font-size: 22px; color: var(--accent); line-height: 1; }

  .art-prose :global(figure) { margin: 0 0 28px; max-width: 100%; }
  .art-prose :global(figure img) {
    display: block; width: 100%; height: auto;
    border: 1px solid var(--line); background: var(--surface);
  }
  .art-prose :global(figure figcaption) {
    font-size: 13px; line-height: 1.7; color: var(--muted); margin-top: 10px;
  }
  .art-prose :global(p) > :global(img) {
    display: block; max-width: 100%; height: auto;
    border: 1px solid var(--line); background: var(--surface); margin: 0 0 28px;
  }
  .art-prose :global(blockquote) {
    margin: 32px 0;
    border-inline-start: 2px solid var(--accent);
    padding-inline-start: clamp(18px, 2.5vw, 26px);
  }
  .art-prose :global(blockquote) :global(p) {
    font-family: var(--font-display); font-size: clamp(19px, 2.3vw, 24px);
    line-height: 1.5; font-weight: 700; color: var(--ink); margin: 0;
    text-wrap: pretty;
  }

  .art-cta {
    border: 1px solid var(--line); background: var(--surface);
    padding: clamp(24px, 3.5vw, 36px);
    margin: clamp(40px, 5vw, 56px) 0 clamp(36px, 4.5vw, 48px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    gap: 26px; align-items: center;
  }
  .art-cta h2 {
    font-family: var(--font-display); font-size: clamp(22px, 2.7vw, 28px);
    font-weight: 700; letter-spacing: 0;
    margin: 0 0 10px; color: var(--ink);
  }
  .art-cta p { font-size: 16px; line-height: 1.9; color: var(--body); margin: 0; max-width: 46ch; }
  .art-cta-buttons { display: flex; flex-direction: column; gap: 10px; }
  .art-cta-btn { min-height: 52px; font-size: 16px; justify-content: center; }

  .art-disclaimer {
    font-size: 13.5px; line-height: 1.95; color: var(--muted);
    margin: 0 0 clamp(48px, 6vw, 88px);
    padding-top: 18px; border-top: 1px solid var(--line);
  }
</style>
