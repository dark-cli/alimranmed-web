---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .sort((a, b) => {
    const ad = a.data.publishedAt?.getTime() ?? 0;
    const bd = b.data.publishedAt?.getTime() ?? 0;
    return bd - ad;
  });
---

<BaseLayout title="Blog — Alimran Medical Center">
  <div class="container page">
    <header class="page-head">
      <h1>Blog</h1>
      <p>Medical articles and clinic updates.</p>
    </header>

    <div class="post-list">
      {posts.map((p) => (
        <a class="post-card card" href={`/blog/${p.id}/`}>
          <h3>{p.data.title}</h3>
          {p.data.description && <p>{p.data.description}</p>}
          {p.data.publishedAt && (
            <span class="date">
              {p.data.publishedAt.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
            </span>
          )}
        </a>
      ))}
    </div>

    {posts.length === 0 && (
      <p class="empty">Posts will appear here after the blog migration runs.</p>
    )}
  </div>
</BaseLayout>

<style>
  .page { padding-block: 1.5rem 2.5rem; }
  @media (min-width: 640px) { .page { padding-block: 3rem 4rem; } }
  .page-head { text-align: center; max-width: 60ch; margin: 0 auto 1.5rem; }
  @media (min-width: 640px) { .page-head { margin-bottom: 3rem; } }
  .page-head p { color: var(--ink-soft); }
  .post-list { display: flex; flex-direction: column; gap: 1rem; }
  .post-card { display: block; text-decoration: none; color: inherit; }
  .post-card:hover { text-decoration: none; }
  .post-card h3 { color: var(--brand); margin-bottom: 0.4em; }
  .post-card p { color: var(--ink-soft); margin-bottom: 0.5em; }
  .date { color: var(--ink-muted); font-size: 0.85rem; }
  .empty { text-align: center; color: var(--ink-muted); font-style: italic; }
</style>
