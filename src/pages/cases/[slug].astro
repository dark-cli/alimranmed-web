---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryPage from "../../components/EntryPage.astro";
import { topicOf, isLocale, localizedHref, currentLocale } from "../../lib/i18n";

const locale = currentLocale(Astro);

export async function getStaticPaths() {
  const items = await getCollection("cases");
  return items
    .filter((e) => isLocale(e.id, "en"))
    .map((entry) => ({ params: { slug: topicOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <EntryPage entry={entry} backHref={localizedHref("/cases/", locale)} backLabel="All cases" />
</BaseLayout>
