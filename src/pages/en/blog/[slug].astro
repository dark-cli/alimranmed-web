---
import { getCollection, render } from "astro:content";
import { topicOf, isLocale, localizedHref, currentLocale } from "../../../lib/i18n";
import { wordsIn } from "../../../lib/word-count";
import ArticleLayout from "../../../components/article/ArticleLayout.astro";
import ArticleSections from "../../../components/article/ArticleSections.astro";
import Media from "../../../components/article/Media.astro";

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);

export async function getStaticPaths() {
  const blogs = await getCollection("blog");
  return blogs
    .filter((e) => isLocale(e.id, "en"))
    .map((entry) => ({ params: { slug: topicOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
const isRedesigned = entry.data.redesigned === true;
const { Content } = await render(entry);

const wordCount =
  wordsIn((entry.data as { sections?: unknown }).sections) +
  wordsIn(entry.body);
const readingLabel = `${Math.max(1, Math.round(wordCount / 180))} min read`;

const publishedAt: unknown = (entry.data as { publishedAt?: unknown }).publishedAt;
const lastReviewed = publishedAt
  ? new Date(publishedAt as string).toLocaleDateString("en-US", { month: "long", year: "numeric" })
  : "—";

type TocItem = { id: string; text: string; num: string };
let toc: TocItem[] = [];
if (isRedesigned && Array.isArray(entry.data.sections)) {
  let n = 0;
  entry.data.sections.forEach((s: { type: string; heading?: string }) => {
    if (!("heading" in s) || !s.heading) return;
    n += 1;
    toc.push({ id: `s-${n}`, text: s.heading, num: String(n).padStart(2, "0") });
  });
}

function extractBodyImages(body: string | undefined): { alt: string; src: string }[] {
  if (!body) return [];
  const re = /!\[([^\]]*)\]\(([^)\s]+)(?:\s+"[^"]*")?\)/g;
  const out: { alt: string; src: string }[] = [];
  let m;
  while ((m = re.exec(body)) !== null) out.push({ alt: m[1], src: m[2] });
  return out;
}
const usingSections = isRedesigned && Array.isArray(entry.data.sections);
const bodyImages = usingSections ? extractBodyImages(entry.body) : [];
---

<ArticleLayout
  pageTitle={`${entry.data.title} — Alimran Medical Center`}
  description={entry.data.description}
  locale="en"
  breadcrumbs={[
    { label: "Home", href: L("/") },
    { label: "Blog", href: L("/blog/") },
    { label: entry.data.title },
  ]}
  h1={entry.data.title}
  meta={[
    { label: "Reviewed by", value: "Hussein Imran Mousa, consultant neurosurgeon" },
    { label: "Reading time", value: readingLabel },
    { label: "Last reviewed", value: lastReviewed },
  ]}
  toc={toc}
  tocLabel="On this page"
  callLabel="Questions?"
  callBody="Contact us to discuss this topic with our team."
  ctaHeading="Need more information?"
  ctaBody="Reach out to our team for more details about the topics covered in this article."
  disclaimer="This article provides general information and is not a substitute for professional medical advice. If you have specific health concerns, please consult with a healthcare provider."
>
  {usingSections ? (
    <>
      <ArticleSections sections={entry.data.sections} locale={locale} />
      {bodyImages.map((img) => (
        <Media kind="image" src={img.src} alt={img.alt} />
      ))}
    </>
  ) : (
    <div class="art-prose">
      <Content />
    </div>
  )}
</ArticleLayout>
