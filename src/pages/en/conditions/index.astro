---
/**
 * Conditions & Procedures — English. 1:1 port of the "care" view in
 * `Alimran Neurosurgery.dc.html` (lines 431–545).
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SoonLink from "../../../components/article/SoonLink.astro";
import { CONTACT } from "../../../consts";
import { localizedHref, currentLocale, topicOf, isLocale } from "../../../lib/i18n";
import { getCollection } from "astro:content";

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);
const callHref = `tel:${CONTACT.phones[0].replace(/\s/g, "")}`;
const secondCallHref = `tel:${CONTACT.phones[1].replace(/\s/g, "")}`;

// Look up which of the treatments in each pathway are already redesigned,
// so the pathway lists can grey out the ones that aren't ready yet.
const allTreatments = await getCollection("treatments");
const bySlug: Record<string, boolean> = {};
allTreatments.filter((e) => isLocale(e.id, "en")).forEach((e) => {
  bySlug[topicOf(e.id)] = e.data.redesigned === true;
});

const pathways = [
  { num: "Pathway 01", title: "Brain",
    items: [
      { name: "Brain tumour",         slug: "brain-tumor" },
      { name: "Stroke",               slug: "stroke" },
      { name: "Epilepsy and seizures", slug: "epilepsy-seizures" },
      { name: "Head injury",          slug: "head-injury" },
      { name: "Parkinson's disease",  slug: "parkinsons-disease" },
      { name: "Motor disorders",      slug: "motor-disorders" },
      { name: "Bell's palsy",         slug: "bells-palsy" },
    ] },
  { num: "Pathway 02", title: "Spine",
    items: [
      { name: "Herniated disc",       slug: "herniated-disc" },
      { name: "Sciatica",             slug: "sciatica" },
      { name: "Spinal cord injury",   slug: "spinal-cord-injury" },
      { name: "Scoliosis",            slug: "scoliosis" },
      { name: "Kyphosis",             slug: "kyphosis" },
      { name: "Whiplash",             slug: "whiplash" },
      { name: "Neurogenic bladder",   slug: "neurogenic-bladder" },
    ] },
  { num: "Pathway 03", title: "Pain",
    items: [
      { name: "Chronic and daily headache", slug: "headaches" },
      { name: "Neck pain",            slug: "neck-pain" },
      { name: "Back pain",            slug: "back-pain" },
      { name: "Frozen shoulder",      slug: "frozen-shoulder" },
      { name: "Knee pain",            slug: "knee-pain" },
      { name: "Fibromyalgia",         slug: "fibromyalgia" },
      { name: "Cancer-related intractable pain", slug: "cancer-pain" },
    ] },
];

const surgical = [
  {
    label: "THEATRE PHOTO", sub: "endoscopic spine procedure",
    title: "Endoscopic spine surgery",
    desc: "Destandau-technique discectomy for cervical and lumbar herniation, with fixation, fusion, kyphoplasty and vertebroplasty where deformity or fracture is present.",
    src: "https://images.unsplash.com/photo-1550831107-1553da8c8464?w=1200&q=80&auto=format&fit=crop",
    alt: "Consultant surgeon operating in theatre",
  },
  {
    label: "PROCEDURE PHOTO", sub: "DBS or spinal cord stimulation",
    title: "Neuromodulation",
    desc: "Deep brain stimulation, spinal cord stimulation and stereotactic lesioning for movement disorders, spasticity and refractory neuropathic pain.",
    src: "/images/home/tms-treatment-768.jpg",
    alt: "Neuromodulation delivered by trained operator",
  },
  {
    label: "PROCEDURE PHOTO", sub: "radiofrequency ablation, in clinic",
    title: "Radiofrequency ablation",
    desc: "Continuous and pulsed radiofrequency for facet-mediated pain, chronic headache and sympathetically maintained pain syndromes.",
    src: "https://images.unsplash.com/photo-1754941622138-b3c3671f2fa8?w=1200&q=80&auto=format&fit=crop",
    alt: "Clinical device applied to a patient in a treatment session",
  },
];

const interventional = [
  "Regional blocks",
  "Neurolytic procedures",
  "Radiofrequency ablation",
  "Sacroiliac joint injections",
  "Caudal epidural injections",
  "Median nerve injections",
  "Facet joint injections",
  "Interlaminar epidural injections",
  "Transforaminal (perineural) epidural injections",
  "Stellate ganglion & thoracic sympathetic blocks",
  "Coeliac ganglion & ganglion impar blocks",
  "Superior hypogastric plexus & lumbar sympathetic blocks",
];
---

<BaseLayout
  title="Conditions & Procedures — Alimran Clinic"
  description="The clinic groups referrals into three pathways: brain, spine and pain. Surgical, interventional and rehabilitative procedures under one team."
>
  <!-- Intro band -->
  <section class="intro">
    <div class="intro-inner">
      <p class="intro-eyebrow">Conditions & procedures</p>
      <h1 class="intro-h1">What we assess, and how we treat it.</h1>
      <p class="intro-lede">The clinic groups referrals into three pathways. Each first appointment includes a full neurological examination and a review of existing imaging; a written plan is issued to the patient and the referring clinician.</p>
    </div>
  </section>

  <!-- Three pathway columns (hairline grid) -->
  <section class="pathways-section">
    <div class="pathway-grid">
      {pathways.map((p) => (
        <div class="pathway-cell">
          <p class="pathway-num">{p.num}</p>
          <h2 class="pathway-name">{p.title}</h2>
          <ul>
            {p.items.map((c) => (
              <li>
                <SoonLink
                  href={L(`/treatments/${c.slug}/`)}
                  redesigned={bySlug[c.slug] === true}
                >{c.name}</SoonLink>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- 01 Surgical & advanced -->
  <section class="proc-section">
    <header class="proc-head">
      <span class="proc-num">01</span>
      <h2 class="proc-h2">Surgical & advanced procedures</h2>
    </header>
    <div class="surg-grid">
      {surgical.map((s) => (
        <article class="surg-card">
          {s.src
            ? <img class="surg-photo surg-photo-img" src={s.src} alt={s.alt} width="1200" height="900" loading="lazy" />
            : (
              <div class="surg-photo photo-slot" aria-hidden="true">
                <p>{s.label}<br>{s.sub}<br>4:3 · min 1200px wide</p>
              </div>
            )}
          <h3 class="surg-title">{s.title}</h3>
          <p class="surg-desc">{s.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- 02 Interventional register -->
  <section class="proc-section">
    <header class="proc-head">
      <span class="proc-num">02</span>
      <h2 class="proc-h2">Interventional pain register</h2>
    </header>
    <div class="int-grid">
      {interventional.map((name, i) => (
        <div class="int-row">
          <span class="int-num">{String(i + 1).padStart(2, "0")}</span>
          <span class="int-name">{name}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Appointment band -->
  <section class="appt-section">
    <div class="appt-card">
      <div>
        <h2 class="appt-h2">Arranging an appointment</h2>
        <p class="appt-body">Appointments are booked by telephone through the clinic secretary. Please have prior imaging, operative notes and a current medication list available at the time of the call.</p>
      </div>
      <div class="appt-buttons">
        <a class="btn btn-primary appt-btn" href={callHref}><span dir="ltr">{CONTACT.phones[0]}</span></a>
        <a class="btn btn-secondary appt-btn" href={secondCallHref}><span dir="ltr">{CONTACT.phones[1]}</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Intro band */
  .intro { border-bottom: 1px solid var(--line); background: var(--surface); }
  .intro-inner {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(44px, 5.5vw, 72px) 24px clamp(40px, 5vw, 64px);
  }
  .intro-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 20px;
  }
.intro-h1 {
    font-family: var(--font-display);
    font-size: clamp(30px, 5vw, 52px);
    line-height: 1.08;
    font-weight: 400;
    letter-spacing: -0.025em;
    margin: 0 0 18px;
    color: var(--ink);
    max-width: 20ch;
  }
.intro-lede { font-size: 17px; line-height: 1.65; color: var(--body); margin: 0; max-width: 62ch; }
/* Pathways — hairline grid */
  .pathways-section {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(44px, 5.5vw, 72px) 24px 0;
  }
  .pathway-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .pathway-cell { background: var(--white); padding: 34px 30px; }
  .pathway-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 6px;
  }
.pathway-name {
    font-family: var(--font-display);
    font-size: clamp(21px, 2.6vw, 26px);
    font-weight: 400;
    margin: 0 0 22px;
    color: var(--ink);
  }
.pathway-cell ul { list-style: none; margin: 0; padding: 0; }
  .pathway-cell li {
    padding: 11px 0;
    border-top: 1px solid var(--line-soft);
    font-size: 15px;
  }
  .pathway-cell li a { color: var(--ink); text-decoration: none; }
  .pathway-cell li a:hover { color: var(--accent); text-decoration: none; }

  /* Procedure section shell (01, 02) */
  .proc-section {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(48px, 6vw, 80px) 24px 0;
  }
  .proc-head {
    display: flex; align-items: baseline; gap: 20px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 14px; margin-bottom: 44px;
  }
  .proc-num { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; color: var(--muted); }
.proc-h2 {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.4vw, 34px);
    font-weight: 400; letter-spacing: -0.02em;
    margin: 0; color: var(--ink); line-height: 1.1;
  }
/* 01 Surgical cards */
  .surg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 32px;
  }
  .surg-photo { aspect-ratio: 4 / 3; min-height: 0; margin-bottom: 18px; padding: 0 20px; }
  .surg-photo-img { padding: 0; object-fit: cover; width: 100%; height: 100%; border: 1px solid var(--line); }
  .surg-photo p {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-align: center;
    margin: 0;
    line-height: 1.7;
  }
.surg-title {
    font-family: var(--font-display);
    font-size: 22px; font-weight: 400;
    margin: 0 0 10px; color: var(--ink);
  }
.surg-desc { font-size: 15px; line-height: 1.6; color: var(--body); margin: 0; }
/* 02 Interventional register */
  .int-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(270px, 100%), 1fr));
    gap: 0 clamp(32px, 4vw, 64px);
  }
  .int-row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .int-num { font-family: var(--font-mono); font-size: 12px; color: var(--accent); }
.int-name { font-size: 15px; color: var(--ink); }

  /* Appointment band */
  .appt-section {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(48px, 6vw, 80px) 24px clamp(56px, 7vw, 96px);
  }
  .appt-card {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: clamp(28px, 4vw, 44px) clamp(24px, 3.5vw, 40px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(245px, 100%), 1fr));
    gap: 36px;
    align-items: center;
  }
  .appt-h2 {
    font-family: var(--font-display);
    font-size: clamp(23px, 3vw, 30px);
    font-weight: 400; letter-spacing: -0.02em;
    margin: 0 0 12px; color: var(--ink);
  }
.appt-body { font-size: 16px; line-height: 1.65; color: var(--body); margin: 0; max-width: 52ch; }
.appt-buttons { display: flex; flex-direction: column; gap: 10px; }
  .appt-btn { min-height: 52px; font-size: 16px; justify-content: center; }
</style>
