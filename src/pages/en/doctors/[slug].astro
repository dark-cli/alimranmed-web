---
/**
 * Consultant CV — Alimran Clinic (redesign Sep 2026).
 * Structure per HANDOFF §4.2: eyebrow + name + role + qualification chips
 * + portrait slot, then five sticky-label registers.
 *
 * Only one doctor exists (Hussein Imran Mousa). The dynamic [slug] route
 * is preserved to keep the URL stable (/doctors/hussein-imran-mousa/) and
 * so future consultants can slot in with new md entries.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { topicOf, isLocale, localizedHref, currentLocale } from "../../../lib/i18n";

export async function getStaticPaths() {
  const items = await getCollection("doctors");
  return items
    .filter((e) => isLocale(e.id, "en"))
    .map((entry) => ({ params: { slug: topicOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);
const homeHref = L("/");

// CV register data. The current md doesn't structure this so we spell it out
// here — a later content pass can normalise the md and re-source these.
const appointments = [
  { period: "2006 — present", body: "Consultant Neurosurgeon, Alsadr Teaching Hospital, Basra — Neurosurgical Department." },
  { period: "2022 — present", body: "Iraq Director, Middle East Stereotactic and Functional Neurosurgery Society." },
  { period: "2016 — present", body: "Supervisor of Arabian Board Neurosurgeon junior doctors." },
  { period: "Board Member",   body: "Middle-Eastern Society of Stereotactic and Functional Neurosurgery." },
  { period: "2000 — 2005",    body: "Postgraduate training, Iraqi Medical Board Center, Baghdad." },
  { period: "1999 — 2000",    body: "Senior House Officer, General Surgery, Basrah General Hospital." },
];

const education = [
  { period: "1996", body: "MBChB — Medical College of Basra, Iraq." },
  { period: "2005", body: "Fellowship, Iraqi Board of Medical Specialization — Neurosurgery." },
  { period: "2016", body: "Consultant status." },
  { period: "2017", body: "Fellowship — Anesthesiology and Pain Medicine, Seoul National University Hospital." },
];

const memberships = [
  { year: "2022", name: "European Society for Stereotactic and Functional Neurosurgery" },
  { year: "2020", name: "European Stroke Organization" },
  { year: "2020", name: "World Stroke Organization" },
  { year: "2020", name: "International Spinal Cord Society" },
  { year: "2016", name: "North American Spine Society" },
  { year: "2015", name: "International Association for the Study of Pain" },
  { year: "2011", name: "AOSpine" },
  { year: "2011", name: "ATLS and ACLS" },
  { year: "2010", name: "American Association of Neurological Surgeons" },
];

const publications = [
  { period: "2015", body: "The outcome of paediatric gunshot head injuries. Int. J. Medicine & Pharmaceutical Sciences, Vol. 3, No. 3." },
  { period: "2014", body: "Civilian gunshot injuries in Basra. Int. J. Medicine & Pharmaceutical Sciences, Vol. 4, No. 6." },
  { period: "2014", body: "Indications and non-indications for epidural drain use in lumbar spine surgery up to three levels. Int. J. Medicine & Pharmaceutical Sciences, Vol. 4, No. 6." },
  { period: "2014", body: "Efficacy of Botox injections around scalp nerves for prevention of chronic daily headache. Int. J. Medicine & Pharmaceutical Sciences, Vol. 4, No. 5." },
  { period: "2013", body: "Elevated white blood cell count as a predictor for severe polytrauma. Thi-Qar Medical Journal, Vol. 7, No. 2." },
];

const conferences = [
  { period: "2016", body: "16th World Congress on Pain, IASP — Yokohama, Japan. Paper on pulsed radiofrequency for chronic headache." },
  { period: "2016", body: "Annual International Spine Conference — Dubai. Paper on sandbag use to prevent CSF leak after spine surgery." },
  { period: "2015", body: "International Conference on Emergency Head & Neck Injuries — Basra. Paper on paediatric gunshot head injuries." },
  { period: "2013", body: "3rd International Basra Fair Conference (Cambridge) — Basra. Paper on spinal cord stimulation." },
  { period: "2013", body: "2nd International Nasiriyah Medical Conference. Paper on WBC count as a predictor of severe polytrauma." },
  { period: "2013", body: "2nd International Emergency Medicine Conference — Basra. Presentation on civilian gunshot head injuries." },
  { period: "2012", body: "Minimally Invasive Spine Workshop, DePuy — Zug, Switzerland." },
  { period: "2010", body: "Middle East Society for Advancement and Innovation, Boston University Medical School workshops — Beirut, Lebanon." },
  { period: "2009", body: "2nd International Advanced Training Course on Prof. Destandau's Endoscopic Spine Technique — Chandigarh, India." },
];
---

<BaseLayout
  title={`${entry.data.fullName} — Alimran Clinic`}
  description={entry.data.description}
>
  <!-- ─── Header row ─────────────────────────────────────────── -->
  <section class="cv-head">
    <div class="container cv-head-inner">
      <div class="cv-head-copy">
        <span class="eyebrow">Lead consultant · Clinical profile</span>
        <h1>{entry.data.fullName}</h1>
        <p class="cv-role">{entry.data.specialty}</p>
        <ul class="cv-chips" aria-label="Qualifications">
          {entry.data.titles.map((t: string) => <li><span dir="ltr">{t}</span></li>)}
        </ul>
        <p class="cv-desc">{entry.data.description}</p>
      </div>
      <div class="cv-portrait photo-slot photo-slot--4x5">
        PORTRAIT<br>
        clinic or hospital setting<br>
        4:5 · min 1200px wide
      </div>
    </div>
  </section>

  <!-- ─── Registers ──────────────────────────────────────────── -->
  <div class="container cv-registers">
    <div class="register">
      <p class="register-label">Appointments</p>
      <div class="register-rows">
        {appointments.map((r) => (
          <div class="register-row">
            <span class="row-period"><span dir="ltr">{r.period}</span></span>
            <p class="row-body">{r.body}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="register">
      <p class="register-label">Education</p>
      <div class="register-rows">
        {education.map((r) => (
          <div class="register-row">
            <span class="row-period"><span dir="ltr">{r.period}</span></span>
            <p class="row-body">{r.body}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="register">
      <p class="register-label">Memberships</p>
      <div class="register-rows register-members">
        {memberships.map((m) => (
          <div class="member-row">
            <span class="member-name">{m.name}</span>
            <span class="member-year"><span dir="ltr">{m.year}</span></span>
          </div>
        ))}
      </div>
    </div>

    <div class="register">
      <p class="register-label">Publications</p>
      <div class="register-rows">
        {publications.map((r) => (
          <div class="register-row">
            <span class="row-period"><span dir="ltr">{r.period}</span></span>
            <p class="row-body">{r.body}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="register">
      <p class="register-label">Conferences</p>
      <div class="register-rows">
        {conferences.map((r) => (
          <div class="register-row">
            <span class="row-period"><span dir="ltr">{r.period}</span></span>
            <p class="row-body">{r.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .cv-head { padding-block: var(--hero-y) 0; }
  .cv-head-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--col-gap);
    align-items: start;
    container-type: inline-size;
  }
  @media (min-width: 900px) { .cv-head-inner { grid-template-columns: 1fr 1fr; } }

  .cv-head-copy .eyebrow { display: block; margin-bottom: 20px; }
  .cv-head-copy h1 {
    font-size: clamp(28px, 9cqw, 54px);
    line-height: 1.07;
    margin: 0 0 12px;
  }
  .cv-role {
    font-size: 17px;
    color: var(--accent);
    margin: 0 0 20px;
    font-weight: 500;
  }
  .cv-chips {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cv-chips li {
    padding: 6px 12px;
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--body);
    letter-spacing: 0.02em;
  }
  html[dir="rtl"] .cv-chips li { font-family: var(--font-body); font-size: 13px; }
  .cv-desc {
    color: var(--body);
    font-size: 16px;
    line-height: 1.65;
    max-width: 52ch;
    margin: 0;
  }
  html[dir="rtl"] .cv-desc { line-height: 1.9; }

  .cv-portrait { order: -1; min-height: 360px; }
  @media (min-width: 900px) { .cv-portrait { order: 0; min-height: 460px; } }

  /* ─── Registers ──────────────────────────────────────────── */
  .cv-registers { padding-block: clamp(32px, 4vw, 56px) var(--section-y-last); }

  .register-row {
    display: grid;
    grid-template-columns: minmax(120px, 160px) 1fr;
    gap: 24px;
    padding-block: 16px;
    border-top: 1px solid var(--line-soft);
    align-items: baseline;
  }
  .register-row:first-child { border-top: 0; padding-top: 0; }
  .row-period {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  html[dir="rtl"] .row-period { font-family: var(--font-body); letter-spacing: 0; font-size: 14px; }
  .row-body {
    color: var(--body);
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }
  html[dir="rtl"] .row-body { line-height: 1.9; }

  @media (max-width: 640px) {
    .register-row { grid-template-columns: 1fr; gap: 4px; }
  }

  /* Memberships: two columns with year on the right (HANDOFF §4.2) */
  .register-members { display: flex; flex-direction: column; }
  .member-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-block: 14px;
    border-top: 1px solid var(--line-soft);
    font-size: 15px;
    color: var(--body);
  }
  .member-row:first-child { border-top: 0; padding-top: 0; }
  .member-name { flex: 1 1 auto; }
  .member-year {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }
  html[dir="rtl"] .member-year { font-family: var(--font-body); }
</style>
