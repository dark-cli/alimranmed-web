---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DoctorProfile from "../../../components/DoctorProfile.astro";
import { topicOf, isLocale, localizedHref, currentLocale } from "../../../lib/i18n";

const locale = currentLocale(Astro);

export async function getStaticPaths() {
  const items = await getCollection("doctors");
  return items
    .filter((e) => isLocale(e.id, "en"))
    .map((entry) => ({ params: { slug: topicOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
---

<BaseLayout title={`${entry.data.fullName} — Alimran Medical Center`} description={entry.data.description}>
  <DoctorProfile entry={entry} backHref={localizedHref("/doctors/", locale)} />
</BaseLayout>
