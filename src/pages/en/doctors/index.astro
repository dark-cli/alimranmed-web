---
/**
 * Doctors index — English. Rebuilt to match the design system: intro band,
 * hairline-bordered cards, every visible element is inside one clickable
 * link, and a "View full profile →" call-to-action makes the click target
 * unambiguous.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { topicOf, isLocale, localizedHref, currentLocale } from "../../../lib/i18n";

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);

const doctors = (await getCollection("doctors"))
  .filter((e) => isLocale(e.id, "en"))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Our doctors — Alimran Medical Center"
  description="Consultant-led neurosurgery, spine and pain medicine at Alimran Clinic — meet the team."
>
  <!-- Intro band -->
  <section class="intro">
    <div class="intro-inner">
      <p class="intro-eyebrow">Our team</p>
      <h1 class="intro-h1">Consultant-led care from a small specialist team.</h1>
      <p class="intro-lede">Every patient at Alimran Clinic is assessed and followed up by a named consultant — not passed between shifts. Meet the doctors who see you from first appointment to recovery.</p>
    </div>
  </section>

  <!-- Doctor grid -->
  <section class="doctors-band">
    <div class="doctor-grid">
      {doctors.map((d) => {
        const href = L(`/doctors/${topicOf(d.id)}/`);
        return (
          <a class="doctor-card" href={href}>
            {d.data.photo && (
              <div class="photo-wrap">
                <img class="photo" src={d.data.photo} alt={d.data.fullName} loading="lazy" />
              </div>
            )}
            <div class="card-body">
              {d.data.specialty && <p class="specialty">{d.data.specialty}</p>}
              <h2 class="name">{d.data.fullName || d.data.title}</h2>
              {d.data.titles.length > 0 && (
                <p class="creds">{d.data.titles.join(" · ")}</p>
              )}
              {d.data.description && (
                <p class="desc">{d.data.description}</p>
              )}
              <dl class="stats">
                {d.data.memberships.length > 0 && (
                  <div>
                    <dt>Memberships</dt>
                    <dd>{d.data.memberships.length} international societies</dd>
                  </div>
                )}
                {d.data.languages.length > 0 && (
                  <div>
                    <dt>Languages</dt>
                    <dd>{d.data.languages.join(", ")}</dd>
                  </div>
                )}
              </dl>
              <p class="cta">
                <span>View full profile</span>
                <span class="cta-arrow" aria-hidden="true">→</span>
              </p>
            </div>
          </a>
        );
      })}
    </div>

    {doctors.length === 0 && (
      <p class="empty">Doctors will appear here once populated.</p>
    )}
  </section>
</BaseLayout>

<style>
  /* Intro band — matches /conditions/ and /blog/ */
  .intro { border-bottom: 1px solid var(--line); background: var(--surface); }
  .intro-inner {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(44px, 5.5vw, 72px) 24px clamp(40px, 5vw, 64px);
  }
  .intro-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 20px;
  }
  .intro-h1 {
    font-family: var(--font-display);
    font-size: clamp(30px, 5vw, 52px);
    line-height: 1.08;
    font-weight: 400;
    letter-spacing: -0.025em;
    margin: 0 0 18px;
    color: var(--ink);
    max-width: 24ch;
  }
  .intro-lede { font-size: 17px; line-height: 1.65; color: var(--body); margin: 0; max-width: 62ch; }

  /* Doctor grid */
  .doctors-band {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(40px, 5vw, 64px) 24px clamp(56px, 7vw, 96px);
  }
  .doctor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(20px, 2.5vw, 32px);
  }

  /* Whole card is a clickable link — no ambiguity about what leads where. */
  .doctor-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line);
    background: var(--white);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .doctor-card:hover {
    border-color: var(--accent);
    background: var(--surface);
    text-decoration: none;
  }

  .photo-wrap {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .card-body { padding: clamp(24px, 3vw, 32px); }

  .specialty {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 12px;
  }
  .name {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.8vw, 30px);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.15;
    color: var(--ink);
    margin: 0 0 10px;
  }
  .doctor-card:hover .name { color: var(--accent); }

  .creds {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--muted);
    line-height: 1.5;
    margin: 0 0 18px;
  }

  .desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--body);
    margin: 0 0 20px;
  }

  .stats {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0 0 24px;
    padding-top: 18px;
    border-top: 1px solid var(--line-soft);
  }
  .stats div { display: flex; flex-direction: column; gap: 2px; }
  .stats dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .stats dd {
    margin: 0;
    font-size: 14px;
    color: var(--ink);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
    padding-top: 4px;
    border-top: 1px solid transparent;
  }
  .cta-arrow {
    font-size: 16px;
    transition: transform 0.15s ease;
  }
  .doctor-card:hover .cta-arrow { transform: translateX(4px); }

  /* RTL adjustments (Arabic uses the same component) */
  :global(html[dir="rtl"]) .specialty,
  :global(html[dir="rtl"]) .stats dt {
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 13px;
  }
  :global(html[dir="rtl"]) .name { font-weight: 700; }
  :global(html[dir="rtl"]) .creds { font-family: var(--font-body); font-size: 13px; }
  :global(html[dir="rtl"]) .cta {
    font-family: var(--font-body);
    letter-spacing: 0;
    text-transform: none;
    font-size: 14px;
  }
  :global(html[dir="rtl"]) .doctor-card:hover .cta-arrow { transform: translateX(-4px); }

  .empty {
    text-align: center;
    color: var(--muted);
    font-size: 14px;
    margin: 40px 0;
  }
</style>
