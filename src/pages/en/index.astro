---
/**
 * Home — Alimran Clinic (redesign Sep 2026).
 * 1:1 port of `Alimran Neurosurgery.dc.html` — every value, spacing and
 * hierarchy taken from the prototype, not from the handoff prose.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACT } from "../../consts";
import { localizedHref, currentLocale } from "../../lib/i18n";

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);
const callHref = `tel:${CONTACT.phones[0].replace(/\s/g, "")}`;
const secondCallHref = `tel:${CONTACT.phones[1].replace(/\s/g, "")}`;
const cvHref = L("/doctors/hussein-imran-mousa/");
const conditionsHref = L("/conditions/");

const stats = [
  { fig: "5,000+", desc: "Operations performed by the lead consultant" },
  { fig: "25",     desc: "Years of neurosurgical practice behind the clinic" },
  { fig: "4",      desc: "Departments — surgery, pain medicine, physiotherapy, rehabilitation" },
  { fig: "6",      desc: "Clinic days a week, including an out-of-hours on-call roster" },
];

const services = [
  { title: "Neurosurgery",        desc: "Open and endoscopic surgery of the brain and spine, including trauma and tumour work.",
    items: ["Burr holes & craniotomy", "Microdiscectomy", "Cervical discectomy & fusion", "Artificial disc replacement", "Spinal decompression"] },
  { title: "Interventional pain", desc: "Image-guided injections and ablation for pain that has not responded to medication.",
    items: ["Radiofrequency ablation", "Epidural & facet injections", "Sympathetic nerve blocks", "Steroid injections", "Botulinum toxin for headache"] },
  { title: "Neuromodulation",     desc: "Stereotactic and functional procedures for movement disorders and refractory pain.",
    items: ["Deep brain stimulation", "Spinal cord stimulation", "Intrathecal pump & catheter", "Selective dorsal rhizotomy", "Brain lesioning"] },
  { title: "Recovery & therapy",  desc: "Rehabilitation that begins on the ward and continues in the clinic after discharge.",
    items: ["Physiotherapy", "Post-operative rehabilitation", "Regenerative medicine", "Ozone therapy", "Supervised exercise & fitness"] },
];

const pathways = [
  { num: "PATHWAY 01", title: "Brain", items: ["Brain tumour", "Stroke", "Epilepsy", "Head injury", "Parkinson's disease", "Motor disorders"] },
  { num: "PATHWAY 02", title: "Spine", items: ["Herniated disc", "Sciatica", "Spinal cord injury", "Scoliosis", "Kyphosis", "Whiplash"] },
  { num: "PATHWAY 03", title: "Pain",  items: ["Chronic headache", "Neck pain", "Back pain", "Frozen shoulder", "Knee pain", "Cancer pain"] },
];

const facilities = [
  { label: "RECEPTION",       sub: "waiting area" },
  { label: "CONSULTING ROOM", sub: "examination & imaging review" },
  { label: "PROCEDURE ROOM",  sub: "fluoroscopy-guided intervention" },
  { label: "THERAPY GYM",     sub: "physiotherapy & rehabilitation" },
];

const insideFacts = [
  { label: "Address",         value: "Alnkba Medical Collection, Breaha, Basra, Iraq" },
  { label: "Clinic days",     value: "Six days a week, with an out-of-hours on-call roster" },
  { label: "Surgery",         value: "Alsadr Teaching Hospital, Basra" },
  { label: "Oncology cases",  value: "Seen at the Basra Specialised Oncology Centre" },
];

const consultantFacts = [
  { label: "Fellowships", value: "Seoul National University Hospital; Mobi Pain Clinic, Mumbai" },
  { label: "Societies",   value: "AANS, NASS, AOSpine, IASP and five others" },
  { label: "Teaching",    value: "Supervisor of Arabian Board neurosurgery trainees since 2016" },
  { label: "Research",    value: "Five peer-reviewed papers; presentations in Yokohama, Dubai and Tampa" },
];
---

<BaseLayout
  title="Alimran Clinic — Neurosurgery & Pain Medicine, Basra"
  description="Alimran Clinic treats disorders of the brain, the spine and chronic pain — four departments working from one assessment, so patients are not sent between unconnected services."
>
  <!-- ─── HERO ───────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-text">
      <div class="hero-text-inner">
        <p class="hero-eyebrow">Alimran Clinic — Basra, Iraq</p>
        <h1 class="hero-h1">A clinic where the scan, the operation and the recovery happen in one place.</h1>
        <p class="hero-p">Alimran Clinic treats disorders of the brain, the spine and chronic pain — four departments working from one assessment, so patients are not sent between unconnected services.</p>
        <p class="hero-p">Neurosurgery · Interventional pain · Neuromodulation · Physiotherapy and rehabilitation.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={conditionsHref}>What we treat</a>
          <a class="btn btn-secondary" href={callHref}>Call the secretary</a>
        </div>

        <div class="hero-credit">
          <img
            class="hero-avatar"
            src="/images/doctors/hussein-imran-mousa.jpg"
            alt="Hussein Imran Mousa"
            width="52" height="52"
          />
          <div class="hero-credit-body">
            <p>Led by <strong>Hussein Imran Mousa</strong>, consultant neurosurgeon</p>
            <a class="hero-credit-link" href={cvHref}>MBChB · FIBMS (Neurosurgery) — full CV →</a>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-photo photo-slot" aria-hidden="true">
      <p>CLINIC PHOTOGRAPH<br>exterior, reception or treatment room<br>landscape · min 1600px wide</p>
    </div>
  </section>

  <!-- ─── STAT BAND ──────────────────────────────────────────── -->
  <section class="stats">
    <div class="stats-grid">
      {stats.map((s) => (
        <div class="stat-cell">
          <p class="stat-fig">{s.fig}</p>
          <p class="stat-desc">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── 01 CARE UNDER ONE ROOF ─────────────────────────────── -->
  <section class="pg-section">
    <header class="pg-head">
      <span class="pg-num">01</span>
      <h2 class="pg-h2">Care under one roof</h2>
    </header>
    <p class="pg-lede">Diagnosis, surgery, pain intervention and recovery are delivered by one team, so a patient is not passed between unconnected services between the scan and the return to work.</p>
    <div class="care-grid">
      {services.map((s) => (
        <article class="care-cell">
          <p class="care-title">{s.title}</p>
          <p class="care-desc">{s.desc}</p>
          <ul class="care-list">
            {s.items.map((i) => <li>{i}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- ─── 02 CONDITIONS WE TREAT ─────────────────────────────── -->
  <section class="pg-section">
    <header class="pg-head">
      <span class="pg-num">02</span>
      <h2 class="pg-h2">Conditions we treat</h2>
    </header>
    <div class="pathways">
      {pathways.map((p) => (
        <div class="pathway">
          <div class="pathway-head">
            <span class="pathway-num">{p.num}</span>
            <h3 class="pathway-name">{p.title}</h3>
          </div>
          <div class="chips">
            {p.items.map((c) => <span class="chip">{c}</span>)}
          </div>
        </div>
      ))}
    </div>
    <a class="pg-quiet-link" href={conditionsHref}>Every condition, and the procedure used for it →</a>
  </section>

  <!-- ─── 03 INSIDE THE CLINIC ───────────────────────────────── -->
  <section class="pg-section">
    <header class="pg-head">
      <span class="pg-num">03</span>
      <h2 class="pg-h2">Inside the clinic</h2>
    </header>
    <div class="facility-grid">
      {facilities.map((f) => (
        <div class="facility-slot photo-slot" aria-hidden="true">
          <p>{f.label}<br>{f.sub}</p>
        </div>
      ))}
    </div>
    <div class="inside-split">
      <div>
        <p class="inside-body">The clinic sits within the Alnkba medical collection in Breaha, Basra, minutes from Alsadr Teaching Hospital, where the surgical lists are held. Outpatient assessment, day-case pain procedures and post-operative therapy all take place on site.</p>
        <a class="btn btn-secondary" href={CONTACT.mapsUrl} target="_blank" rel="noopener">Directions on the map</a>
      </div>
      <dl class="facts">
        {insideFacts.map((f) => (
          <div class="fact-row">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ─── 04 THE LEAD CONSULTANT ─────────────────────────────── -->
  <section class="pg-section">
    <header class="pg-head">
      <span class="pg-num">04</span>
      <h2 class="pg-h2">The lead consultant</h2>
    </header>
    <div class="inside-split">
      <div>
        <h3 class="consultant-name">Hussein Imran Mousa</h3>
        <p class="consultant-quals">MBChB · FIBMS (Neurosurgery) · FIAANS</p>
        <p class="consultant-body">Consultant neurosurgeon at Alsadr Teaching Hospital and Iraq Director for Middle East Stereotactic and Functional Neurosurgery, with fellowship training in interventional pain medicine in Seoul and Mumbai.</p>
        <a class="pg-quiet-link" href={cvHref}>Full CV, publications and training →</a>
      </div>
      <dl class="facts">
        {consultantFacts.map((f) => (
          <div class="fact-row">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ─── REFERRAL BAND ──────────────────────────────────────── -->
  <section class="pg-section">
    <div class="referral-card">
      <div class="referral-copy">
        <p class="referral-eyebrow">For referring clinicians</p>
        <p class="referral-body">Send imaging and a clinical summary to the clinic ahead of the appointment. Urgent cases are triaged by the secretary the same working day, and a written plan goes back to the referrer after the consultation.</p>
      </div>
      <div class="referral-col">
        <p class="referral-label">Secretary</p>
        <p><a href={callHref}><span dir="ltr">{CONTACT.phones[0]}</span></a></p>
        <p><a href={secondCallHref}><span dir="ltr">{CONTACT.phones[1]}</span></a></p>
      </div>
      <div class="referral-col">
        <p class="referral-label">Referrals by email</p>
        <p><a href={`mailto:${CONTACT.email}`}><span dir="ltr">{CONTACT.email}</span></a></p>
      </div>
    </div>
  </section>

  <!-- Bottom spacing (matches prototype's empty section) -->
  <div class="tail-space" aria-hidden="true"></div>
</BaseLayout>

<style>
  /* ─── HERO ────────────────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 980px) {
    .hero { grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr); }
  }

  .hero-text {
    padding: clamp(44px, 5.5vw, 88px) clamp(24px, 3.5vw, 48px);
    display: flex;
    align-items: center;
    container-type: inline-size;
  }
  @media (min-width: 980px) {
    /* Align text left edge with container: max(24, (100vw - 1180) / 2 + 24) */
    .hero-text {
      padding-inline-start: max(24px, calc((100vw - 1180px) / 2 + 24px));
    }
  }
  .hero-text-inner { width: 100%; max-width: 640px; }
  @media (max-width: 979px) {
    .hero-text-inner { max-width: 100%; margin: 0 auto; }
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 22px;
  }
  html[dir="rtl"] .hero-eyebrow { font-family: var(--font-body); letter-spacing: 0.02em; text-transform: none; font-size: 13px; }

  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(30px, 7.6cqw, 58px);
    line-height: 1.06;
    font-weight: 400;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: pretty;
    margin: 0 0 20px;
  }
  html[dir="rtl"] .hero-h1 { font-weight: 700; letter-spacing: 0; line-height: 1.22; }

  .hero-p {
    font-size: 17px;
    line-height: 1.65;
    color: var(--body);
    max-width: 52ch;
    text-wrap: pretty;
    margin: 0 0 14px;
  }
  html[dir="rtl"] .hero-p { line-height: 1.9; }
  .hero-p:last-of-type { margin-bottom: 34px; }

  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

  .hero-credit {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  .hero-avatar {
    width: 52px; height: 52px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 30%;
    flex: 0 0 auto;
    display: block;
  }
  .hero-credit-body { min-width: 0; }
  .hero-credit-body p {
    margin: 0;
    font-size: 14.5px;
    color: var(--ink);
    line-height: 1.5;
  }
  .hero-credit-body strong { font-weight: 500; }
  .hero-credit-link {
    display: inline-block;
    margin-top: 2px;
    font-size: 13.5px;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 1px;
  }
  .hero-credit-link:hover { border-bottom-color: var(--accent); text-decoration: none; }

  .hero-photo {
    align-self: stretch;
    justify-self: stretch;
    min-height: min(72vw, 420px);
    border: 0;
    border-inline-start: 1px solid var(--line);
    order: -1;
  }
  @media (min-width: 980px) {
    .hero-photo { min-height: 560px; order: 0; }
  }
  .hero-photo p {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-align: center;
    margin: 0;
    padding: 0 28px;
    line-height: 1.8;
  }
  html[dir="rtl"] .hero-photo p { font-family: var(--font-body); letter-spacing: 0; font-size: 12px; }

  /* ─── STAT BAND ───────────────────────────────────────────── */
  .stats {
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }
  .stats-grid {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(175px, 100%), 1fr));
    gap: 1px;
    background: var(--line);
  }
  .stat-cell {
    background: var(--surface);
    padding: 32px 24px;
  }
  .stat-fig {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.4vw, 40px);
    line-height: 1;
    margin: 0 0 8px;
    color: var(--accent);
    font-weight: 400;
  }
  html[dir="rtl"] .stat-fig { font-weight: 700; }
  .stat-desc {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--body);
  }
  html[dir="rtl"] .stat-desc { line-height: 1.9; }

  /* ─── SECTION SHELL (01–04) ───────────────────────────────── */
  .pg-section {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(48px, 6vw, 88px) 24px 0;
  }
  .pg-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 14px;
    margin-bottom: 44px;
  }
  .pg-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  html[dir="rtl"] .pg-num { font-family: var(--font-body); letter-spacing: 0.02em; font-size: 13px; }
  .pg-h2 {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.4vw, 34px);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--ink);
    line-height: 1.1;
  }
  html[dir="rtl"] .pg-h2 { font-weight: 700; letter-spacing: 0; line-height: 1.22; }

  .pg-lede {
    font-size: 16px;
    line-height: 1.65;
    color: var(--body);
    margin: -20px 0 36px;
    max-width: 70ch;
  }
  html[dir="rtl"] .pg-lede { line-height: 1.9; }

  .pg-quiet-link {
    display: inline-block;
    margin-top: 32px;
    font-size: 14.5px;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 1px;
  }
  .pg-quiet-link:hover { border-bottom-color: var(--accent); text-decoration: none; }

  /* ─── 01 CARE GRID ────────────────────────────────────────── */
  .care-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .care-cell {
    background: var(--white);
    padding: 32px 28px;
  }
  .care-title {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 14px;
  }
  html[dir="rtl"] .care-title { font-family: var(--font-body); letter-spacing: 0.02em; text-transform: none; font-size: 13px; }
  .care-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--body);
    margin: 0 0 20px;
  }
  html[dir="rtl"] .care-desc { line-height: 1.9; }
  .care-list {
    margin: 0; padding: 0; list-style: none;
    display: flex; flex-direction: column; gap: 9px;
  }
  .care-list li {
    font-size: 14.5px;
    color: var(--ink);
    border-top: 1px solid var(--line-soft);
    padding-top: 9px;
  }

  /* ─── 02 PATHWAYS + CHIPS ─────────────────────────────────── */
  .pathways {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(255px, 100%), 1fr));
    gap: 40px;
  }
  .pathway-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
  }
  .pathway-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--accent);
  }
  html[dir="rtl"] .pathway-num { font-family: var(--font-body); letter-spacing: 0.02em; font-size: 13px; }
  .pathway-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
    margin: 0;
    color: var(--ink);
  }
  html[dir="rtl"] .pathway-name { font-weight: 700; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    font-size: 14px;
    color: var(--ink);
    border: 1px solid var(--line);
    background: var(--white);
    padding: 7px 12px;
  }

  /* ─── 03 FACILITIES + SPLIT ───────────────────────────────── */
  .facility-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }
  .facility-slot { aspect-ratio: 4 / 3; min-height: 0; padding: 0 18px; }
  .facility-slot p {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-align: center;
    line-height: 1.7;
    margin: 0;
  }
  html[dir="rtl"] .facility-slot p { font-family: var(--font-body); letter-spacing: 0; font-size: 12px; }

  .inside-split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(270px, 100%), 1fr));
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }
  .inside-body {
    font-size: 16px;
    line-height: 1.65;
    color: var(--body);
    margin: 0 0 20px;
    max-width: 54ch;
  }
  html[dir="rtl"] .inside-body { line-height: 1.9; }

  .facts {
    margin: 0; padding: 0;
    border-top: 1px solid var(--ink);
  }
  .fact-row {
    display: grid;
    grid-template-columns: minmax(92px, 150px) minmax(0, 1fr);
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .fact-row dt {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
    margin: 0;
  }
  html[dir="rtl"] .fact-row dt { font-family: var(--font-body); font-size: 14px; }
  .fact-row dd {
    font-size: 15px;
    color: var(--ink);
    margin: 0;
    line-height: 1.55;
  }
  html[dir="rtl"] .fact-row dd { line-height: 1.9; }

  /* ─── 04 CONSULTANT ───────────────────────────────────────── */
  .consultant-name {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 400;
    margin: 0 0 6px;
    color: var(--ink);
  }
  html[dir="rtl"] .consultant-name { font-weight: 700; }
  .consultant-quals {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 20px;
  }
  html[dir="rtl"] .consultant-quals { font-family: var(--font-body); letter-spacing: 0.02em; text-transform: none; font-size: 13px; }
  .consultant-body {
    font-size: 16px;
    line-height: 1.65;
    color: var(--body);
    margin: 0 0 24px;
    max-width: 54ch;
  }
  html[dir="rtl"] .consultant-body { line-height: 1.9; }

  /* ─── REFERRAL BAND ───────────────────────────────────────── */
  .referral-card {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: clamp(28px, 4vw, 44px) clamp(24px, 3.5vw, 40px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(245px, 100%), 1fr));
    gap: 36px;
    align-items: start;
  }
  .referral-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 14px;
  }
  html[dir="rtl"] .referral-eyebrow { font-family: var(--font-body); letter-spacing: 0.02em; text-transform: none; font-size: 13px; }
  .referral-body {
    font-size: 16px;
    line-height: 1.65;
    color: var(--body);
    margin: 0;
    max-width: 50ch;
  }
  html[dir="rtl"] .referral-body { line-height: 1.9; }
  .referral-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 8px;
  }
