---
/**
 * Home — Alimran Clinic (redesigned Sep 2026).
 * Structure per HANDOFF §4.1.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACT } from "../../consts";
import { localizedHref, currentLocale } from "../../lib/i18n";

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);
const callHref = `tel:${CONTACT.phones[0].replace(/\s/g, "")}`;
const cvHref = L("/doctors/hussein-imran-mousa/");
const conditionsHref = L("/conditions/");

const stats = [
  { fig: "5,000+", label: "Consultations" },
  { fig: "25",     label: "Years experience" },
  { fig: "4",      label: "Clinical pathways" },
  { fig: "6",      label: "Days a week" },
];

const services = [
  { num: "01", title: "Neurosurgery",   desc: "Brain tumours, spinal decompression, functional and stereotactic neurosurgery.", procedures: ["Craniotomy", "Microdiscectomy", "Laminectomy", "Stereotactic biopsy", "CSF diversion"] },
  { num: "02", title: "Interventional pain", desc: "Image-guided procedures for chronic back, neck and joint pain.", procedures: ["Radiofrequency ablation", "Epidural steroid injection", "Nerve blocks", "Facet joint injection", "Trigger point therapy"] },
  { num: "03", title: "Neuromodulation", desc: "Non-invasive brain stimulation for stroke, migraine and mood disorders.", procedures: ["TMS", "tDCS", "Peripheral stimulation", "Vagal stimulation", "Motor cortex mapping"] },
  { num: "04", title: "Recovery & therapy", desc: "Consultant-supervised rehabilitation, physiotherapy and regenerative care.", procedures: ["Physiotherapy", "Chiropractic", "Regenerative medicine", "Fitness training", "Ozone therapy"] },
];

const pathways = [
  { title: "Brain", items: ["Brain tumour", "Stroke", "Epilepsy", "Head injury", "Bell's palsy", "Trigeminal neuralgia", "Hydrocephalus"] },
  { title: "Spine", items: ["Herniated disc", "Sciatica", "Scoliosis", "Spinal stenosis", "Whiplash", "Spinal cord injury", "Kyphosis"] },
  { title: "Pain",  items: ["Back pain", "Neck pain", "Knee pain", "Frozen shoulder", "Fibromyalgia", "Headaches", "Arthritis"] },
];
---

<BaseLayout
  title="Alimran Clinic — Neurosurgery & Pain Medicine in Basra"
  description="Consultant-led neurosurgical, pain, and rehabilitation care in Basra, Iraq. Led by Hussein Imran Mousa, consultant neurosurgeon."
>
  <!-- ─── Hero ───────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Alimran Clinic · Basra, Iraq</span>
        <h1>Consultant neurosurgery, pain medicine and recovery — under one roof.</h1>
        <p class="hero-lede">
          A single referral pathway from diagnosis to rehabilitation, led by a
          consultant with 25 years of experience across brain, spine and pain.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={callHref}>Call the secretary</a>
          <a class="btn btn-secondary" href={conditionsHref}>See what we treat</a>
        </div>

        <!-- Doctor credit strip (small — the site belongs to the clinic) -->
        <div class="doctor-credit">
          <div class="doctor-avatar photo-slot photo-slot--4x5" aria-hidden="true">
            AVATAR<br>52 × 52
          </div>
          <p>
            Led by <a class="link-quiet" href={cvHref}>Hussein Imran Mousa</a>,
            consultant neurosurgeon &nbsp;·&nbsp; MBChB · FIBMS
          </p>
        </div>
      </div>

      <div class="hero-photo photo-slot photo-slot--landscape">
        CLINIC PHOTOGRAPH<br>
        exterior, reception or treatment room<br>
        landscape · min 1600px wide
      </div>
    </div>
  </section>

  <!-- ─── Stat band ──────────────────────────────────────────── -->
  <section class="stats" aria-label="At a glance">
    <div class="container">
      <div class="grid-hairline grid-hairline--surface stat-grid">
        {stats.map((s) => (
          <div class="stat-cell">
            <div class="stat-fig">{s.fig}</div>
            <div class="eyebrow">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── 01 Care under one roof ─────────────────────────────── -->
  <section class="section" id="care">
    <div class="container">
      <header class="section-head">
        <span class="section-num">01</span>
        <h2 class="section-title">Care under one roof</h2>
      </header>
      <div class="grid-hairline services-grid">
        {services.map((s) => (
          <article class="service-cell">
            <span class="service-num eyebrow">{s.num}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <ul class="service-list">
              {s.procedures.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── 02 Conditions we treat ─────────────────────────────── -->
  <section class="section section-tinted" id="conditions">
    <div class="container">
      <header class="section-head">
        <span class="section-num">02</span>
        <h2 class="section-title">Conditions we treat</h2>
      </header>
      <div class="pathways-grid">
        {pathways.map((p) => (
          <div class="pathway-col">
            <h3 class="pathway-head">
              <span class="eyebrow">Pathway</span>
              <span class="pathway-title">{p.title}</span>
            </h3>
            <ul class="pathway-list">
              {p.items.map((c) => <li>{c}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <div class="section-cta">
        <a class="btn btn-secondary" href={conditionsHref}>All conditions & procedures →</a>
      </div>
    </div>
  </section>

  <!-- ─── 03 Inside the clinic ───────────────────────────────── -->
  <section class="section" id="inside">
    <div class="container">
      <header class="section-head">
        <span class="section-num">03</span>
        <h2 class="section-title">Inside the clinic</h2>
      </header>
      <div class="grid-hairline facilities-grid">
        <div class="photo-slot photo-slot--4x3">RECEPTION<br>landscape · min 1600px wide</div>
        <div class="photo-slot photo-slot--4x3">CONSULTING ROOM<br>landscape · min 1600px wide</div>
        <div class="photo-slot photo-slot--4x3">PROCEDURE ROOM<br>landscape · min 1600px wide</div>
        <div class="photo-slot photo-slot--4x3">THERAPY GYM<br>landscape · min 1600px wide</div>
      </div>
      <div class="location-facts">
        <div class="register register-single">
          <div class="register-rows">
            <p><strong>Location</strong> — {CONTACT.addresses.en}</p>
            <p><strong>Hours</strong> — Sat–Thu 09:00–18:00, Fri 14:00–18:00</p>
            <p><strong>Directions</strong> — <a href={CONTACT.mapsUrl} target="_blank" rel="noopener">Open in Google Maps →</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 04 The lead consultant ─────────────────────────────── -->
  <section class="section section-tinted" id="consultant">
    <div class="container">
      <header class="section-head">
        <span class="section-num">04</span>
        <h2 class="section-title">The lead consultant</h2>
      </header>
      <div class="consultant-grid">
        <div class="consultant-highlight">
          <h3>Hussein Imran Mousa</h3>
          <p class="eyebrow">Consultant neurosurgeon · Basra Teaching Hospital · Alimran Clinic</p>
          <p class="consultant-lede">
            Fellow of the Iraqi Board of Medical Specialisations (Neurosurgery), the American
            Association of Neurological Surgeons, and the International Association of Non-invasive
            and Advanced Spine Surgery. Iraq director for the Middle East Stereotactic and
            Functional Neurosurgery Society.
          </p>
          <p><a class="link-quiet" href={cvHref}>Read the full CV →</a></p>
        </div>
        <div class="consultant-facts">
          <div class="register">
            <p class="register-label">Since</p>
            <div class="register-rows">
              <p>2006 — Consultant Neurosurgeon</p>
            </div>
          </div>
          <div class="register">
            <p class="register-label">Fellowships</p>
            <div class="register-rows">
              <p>FIBMS (Neurosurgery)</p>
              <p>FIAANS</p>
              <p>FIISSP · FINASS</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Referral band ──────────────────────────────────────── -->
  <section class="referral">
    <div class="container referral-inner">
      <div>
        <span class="eyebrow">For referring clinicians</span>
        <h2 class="referral-title">Refer a patient</h2>
        <p>Direct line to the secretary for scheduling; imaging and letters can be sent to the clinic email.</p>
      </div>
      <div class="referral-contact">
        {CONTACT.phones.map((p) => (
          <a class="referral-phone" href={`tel:${p.replace(/\s/g, "")}`}>
            <span dir="ltr">{p}</span>
          </a>
        ))}
        <a class="referral-email" href={`mailto:${CONTACT.email}`}>
          <span dir="ltr">{CONTACT.email}</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Hero ────────────────────────────────────────────────── */
  .hero { padding-block: var(--hero-y); }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--col-gap);
    align-items: start;
    container-type: inline-size;
  }
  @media (min-width: 980px) {
    .hero-inner { grid-template-columns: 1fr 1fr; align-items: center; }
  }

  .hero-copy .eyebrow { display: block; margin-bottom: 20px; }
  .hero-copy h1 {
    font-size: clamp(30px, 7.6cqw, 58px);
    line-height: 1.06;
    margin: 0 0 24px;
    max-width: 14ch;
  }
  .hero-lede {
    font-size: clamp(16.5px, 1.9vw, 19px);
    line-height: 1.6;
    color: var(--body);
    max-width: 52ch;
    margin-bottom: 32px;
  }
  html[dir="rtl"] .hero-lede { line-height: 1.9; }

  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 40px; }

  .doctor-credit {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .doctor-avatar {
    width: 52px;
    height: 52px;
    min-height: 0;
    padding: 0;
    aspect-ratio: 1;
    font-size: 9px;
    flex-shrink: 0;
  }
  .doctor-credit p {
    font-size: 14px;
    color: var(--body);
    margin: 0;
  }

  .hero-photo {
    /* Photo comes first on mobile */
    order: -1;
    min-height: 320px;
  }
  @media (min-width: 980px) {
    .hero-photo { order: 0; min-height: 460px; }
  }

  /* ─── Stat band ───────────────────────────────────────────── */
  .stats { padding-block: 0; }
  .stat-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(175px, 100%), 1fr));
  }
  .stat-cell { text-align: start; }
  .stat-fig {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.4vw, 40px);
    line-height: 1;
    color: var(--accent);
    margin-bottom: 10px;
  }
  html[dir="rtl"] .stat-fig { font-weight: 700; }

  /* ─── Services (01) ───────────────────────────────────────── */
  .services-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
  }
  .service-cell { display: flex; flex-direction: column; gap: 12px; }
  .service-num { color: var(--muted); }
  .service-cell h3 { margin: 0; font-size: clamp(20px, 2.6vw, 26px); }
  .service-cell p { color: var(--body); font-size: 15px; line-height: 1.55; }
  .service-list {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .service-list li {
    padding: 10px 0;
    border-top: 1px solid var(--line-soft);
    font-size: 14px;
    color: var(--body);
  }

  /* ─── Pathways (02) ───────────────────────────────────────── */
  .pathways-grid {
    display: grid;
    gap: 40px;
    grid-template-columns: repeat(auto-fit, minmax(min(255px, 100%), 1fr));
  }
  .pathway-col { background: var(--white); padding: 28px; border: 1px solid var(--line); }
  .pathway-head { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
  .pathway-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 28px);
    color: var(--ink);
  }
  html[dir="rtl"] .pathway-title { font-weight: 700; }
  .pathway-list { list-style: none; padding: 0; margin: 0; }
  .pathway-list li {
    padding: 12px 0;
    border-top: 1px solid var(--line-soft);
    font-size: 15px;
    color: var(--body);
  }
  .pathway-list li:first-child { border-top: 1px solid var(--line); }
  .section-cta { margin-top: 40px; text-align: center; }

  /* ─── Facilities (03) ─────────────────────────────────────── */
  .facilities-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
  }
  .facilities-grid > .photo-slot { padding: 24px; }
  .location-facts { margin-top: 32px; }
  .register-single { grid-template-columns: 1fr; padding-block: 24px; border-top: 1px solid var(--line); }
  .register-single .register-rows > p { padding: 10px 0; font-size: 15px; }
  .register-single strong { color: var(--muted); font-weight: 500; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; margin-inline-end: 8px; }
  html[dir="rtl"] .register-single strong { font-family: var(--font-body); letter-spacing: 0; text-transform: none; font-size: 14px; }

  /* ─── Consultant highlight (04) ───────────────────────────── */
  .consultant-grid {
    display: grid;
    gap: var(--col-gap);
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .consultant-grid { grid-template-columns: 1.4fr 1fr; }
  }
  .consultant-highlight h3 {
    font-size: clamp(24px, 3vw, 32px);
    margin: 0 0 8px;
  }
  .consultant-highlight .eyebrow { display: block; margin-bottom: 16px; }
  .consultant-lede { font-size: 16px; line-height: 1.6; color: var(--body); max-width: 55ch; }
  .consultant-facts .register:first-child { border-top: 0; padding-top: 0; }

  /* ─── Referral band ───────────────────────────────────────── */
  .referral {
    background: var(--surface);
    padding-block: var(--section-y-last);
  }
  .referral-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 800px) {
    .referral-inner { grid-template-columns: 1.2fr 1fr; }
  }
  .referral .eyebrow { display: block; margin-bottom: 12px; }
  .referral-title { margin: 0 0 8px; font-size: clamp(24px, 3vw, 32px); }
  .referral p { color: var(--body); max-width: 42ch; }
  .referral-contact {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .referral-phone, .referral-email {
    display: block;
    padding: 18px 20px;
    background: var(--white);
    border: 1px solid var(--line);
    color: var(--accent);
    font-size: 16px;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .referral-phone:hover, .referral-email:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
</style>
