---
/**
 * Treatment article — English.
 *
 * Two rendering paths:
 *   • Redesigned (frontmatter `redesigned: true`) → block dispatch.
 *     Reads `sections: [...]` and renders each block via its component.
 *     TOC is auto-built from any block that carries a `heading`.
 *   • Legacy → the plain markdown body rendered inside the same chrome.
 *
 * Layout chrome (breadcrumb, meta rail, aside, CTA, disclaimer) is shared.
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { topicOf, isLocale, localizedHref, currentLocale } from "../../../lib/i18n";
import { CONTACT } from "../../../consts";
import AtGlance from "../../../components/article/AtGlance.astro";
import Prose from "../../../components/article/Prose.astro";
import PullQuote from "../../../components/article/PullQuote.astro";
import ComparisonPair from "../../../components/article/ComparisonPair.astro";
import StatsFacts from "../../../components/article/StatsFacts.astro";
import TreatmentGroups from "../../../components/article/TreatmentGroups.astro";
import Related from "../../../components/article/Related.astro";

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);
const callHref = `tel:${CONTACT.phones[0].replace(/\s/g, "")}`;
const secondCallHref = `tel:${CONTACT.phones[1].replace(/\s/g, "")}`;

export async function getStaticPaths() {
  const items = await getCollection("treatments");
  return items
    .filter((e) => isLocale(e.id, "en"))
    .map((entry) => ({ params: { slug: topicOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
const isRedesigned = entry.data.redesigned === true;
const { Content, headings } = await render(entry);

// Pathway map
const PATHWAY: Record<string, { label: string; pathway: string }> = {
  brain: { label: "Brain", pathway: "Brain — neurosurgical" },
  spine: { label: "Spine", pathway: "Spine — surgical" },
  pain:  { label: "Pain",  pathway: "Pain — interventional" },
};
const cat = ((entry.data as { pathwayOverride?: string; category?: string })
  .pathwayOverride || entry.data.category || "pain").toLowerCase();
const pathway = PATHWAY[cat] || PATHWAY.pain;

// Reading time — walks the section blocks (redesigned articles keep
// their content there, not in the markdown body) and adds the raw
// markdown body for legacy articles. 180 wpm reflects clinical prose,
// which reads slower than casual content.
function wordsIn(v: unknown): number {
  if (v == null) return 0;
  if (typeof v === "string") {
    const t = v.replace(/!\[[^\]]*]\([^)]+\)/g, "").trim();
    return t ? t.split(/\s+/).length : 0;
  }
  if (Array.isArray(v)) return v.reduce((n, x) => n + wordsIn(x), 0);
  if (typeof v === "object") return Object.values(v as Record<string, unknown>).reduce((n, x) => n + wordsIn(x), 0);
  return 0;
}
const wordCount =
  wordsIn((entry.data as { sections?: unknown }).sections) +
  wordsIn(entry.body);
const readingLabel = `${Math.max(1, Math.round(wordCount / 180))} min read`;

// Last reviewed
const publishedAt: unknown = (entry.data as { publishedAt?: unknown }).publishedAt;
const lastReviewed = publishedAt
  ? new Date(publishedAt as string).toLocaleDateString("en-US", { month: "long", year: "numeric" })
  : "—";

// Build TOC and section numbering from block headings (redesigned) or from
// rendered h2s (legacy).
type TocItem = { id: string; text: string; num: string };
let toc: TocItem[] = [];
let numberedIds: Record<string, string> = {}; // heading text → "01"
if (isRedesigned && Array.isArray(entry.data.sections)) {
  let n = 0;
  entry.data.sections.forEach((s: { type: string; heading?: string }) => {
    if (!("heading" in s) || !s.heading) return;
    n += 1;
    const num = String(n).padStart(2, "0");
    const id = `s-${n}`;
    toc.push({ id, text: s.heading, num });
    numberedIds[s.heading] = id;
  });
} else {
  toc = (headings || [])
    .filter((h) => h.depth === 2)
    .map((h, i) => ({ id: h.slug, text: h.text, num: String(i + 1).padStart(2, "0") }));
}
const showToc = toc.length >= 2;

// For the redesigned dispatcher we need to know the section index at
// render-time so each block can pass num/id to SectionHead.
let sectionIndex = 0;
function nextNumId(hasHeading: boolean): { num?: string; id?: string } {
  if (!hasHeading) return {};
  sectionIndex += 1;
  return { num: String(sectionIndex).padStart(2, "0"), id: `s-${sectionIndex}` };
}

// Related lookup — resolve slugs to entries in the same locale so we can
// mark each as redesigned/not, pick title + category label.
const allTreatments = await getCollection("treatments");
const enTreatments = allTreatments.filter((e) => isLocale(e.id, "en"));
function resolveRelated(slugs: string[]) {
  return slugs.map((slug) => {
    const found = enTreatments.find((e) => topicOf(e.id) === slug);
    if (!found) return null;
    const rd = found.data.redesigned === true;
    const rcat = (found.data.pathwayOverride || found.data.category || "pain").toLowerCase();
    return {
      slug,
      title: found.data.title,
      category: PATHWAY[rcat]?.label || "Pain",
      href: rd ? L(`/treatments/${slug}/`) : "",
      redesigned: rd,
    };
  }).filter(Boolean) as {
    slug: string; title: string; category: string; href: string; redesigned: boolean;
  }[];
}

const standfirst = entry.data.description || "";
const soonMsg = "This article isn't in the new design yet — coming soon.";
---

<BaseLayout title={`${entry.data.title} — Alimran Clinic`} description={standfirst}>
  <!-- Head band -->
  <section class="art-head-band">
    <div class="art-head-wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={L("/")}>Home</a>
        <span class="crumb-sep" aria-hidden="true">›</span>
        <a href={L("/conditions/")}>Conditions treated</a>
        <span class="crumb-sep" aria-hidden="true">›</span>
        <span class="crumb-current">{pathway.label}</span>
      </nav>
      <div class="art-head-grid">
        <div class="art-head-copy">
          <h1 class="art-h1">{entry.data.title}</h1>
          {standfirst && <p class="art-standfirst">{standfirst}</p>}
        </div>
        <dl class="art-meta">
          <div><dt>Pathway</dt><dd>{pathway.pathway}</dd></div>
          <div><dt>Reviewed by</dt><dd>Hussein Imran Mousa, consultant neurosurgeon</dd></div>
          <div><dt>Reading time</dt><dd>{readingLabel}</dd></div>
          <div><dt>Last reviewed</dt><dd>{lastReviewed}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <div class="art-container">
    <div class="art-grid">
      <aside class="art-aside">
        {showToc && (
          <nav class="art-toc" aria-label="On this page">
            <p class="art-toc-label">On this page</p>
            <span class="art-toc-rule" aria-hidden="true"></span>
            {toc.map((t) => (<a href={`#${t.id}`}>{t.text}</a>))}
          </nav>
        )}
        <div class="art-call-card">
          <p class="art-call-label">Discuss this</p>
          <p class="art-call-body">Speak to the secretary about a consultation for this condition.</p>
          <a class="art-call-btn" href={callHref} dir="ltr">{CONTACT.phones[0]}</a>
        </div>
      </aside>

      <!-- Floating call FAB — mobile-only replacement for the aside card.
           Fades in after the reader scrolls past ~200px. -->
      <a class="art-fab" href={callHref} aria-label={`Call the secretary — ${CONTACT.phones[0]}`}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
      </a>
      <script is:inline>
        (function () {
          if (window.__artFabBound) return;
          window.__artFabBound = true;
          function tick() {
            document.querySelectorAll('.art-fab').forEach(function (el) {
              if (window.scrollY > 200) el.classList.add('is-visible');
              else el.classList.remove('is-visible');
            });
          }
          document.addEventListener('scroll', tick, { passive: true });
          document.addEventListener('astro:page-load', tick);
          tick();
        })();
      </script>

      <article class="art-body">
        {isRedesigned && Array.isArray(entry.data.sections) ? (
          entry.data.sections.map((s: any) => {
            const { num, id } = nextNumId(!!s.heading);
            if (s.type === "at-a-glance")     return <AtGlance items={s.items} glanceLabel="At a glance" />;
            if (s.type === "prose")           return <Prose num={num} heading={s.heading} body={s.body} id={id} />;
            if (s.type === "pull-quote")      return <PullQuote text={s.text} attribution={s.attribution} />;
            if (s.type === "comparison-pair") return <ComparisonPair num={num} heading={s.heading} id={id} intro={s.intro} a={s.a} b={s.b} />;
            if (s.type === "stats-facts")     return <StatsFacts num={num} heading={s.heading} id={id} intro={s.intro} stats={s.stats} facts={s.facts} factsTitle="Key facts" factNumbers={s.facts.map((_: string, i: number) => String(i + 1).padStart(2, "0"))} />;
            if (s.type === "treatment-groups") return <TreatmentGroups num={num} heading={s.heading} id={id} intro={s.intro} note={s.note} groups={s.groups} />;
            if (s.type === "related")         return <Related items={resolveRelated(s.slugs)} relatedLabel="Related reading" soonLabel={soonMsg} />;
            return null;
          })
        ) : (
          <div class="art-prose">
            <Content />
          </div>
        )}

        <section class="art-cta">
          <div>
            <h2>Book a consultation</h2>
            <p>The secretary schedules first appointments during clinic hours; please have prior imaging, operative notes and a current medication list available at the time of the call.</p>
          </div>
          <div class="art-cta-buttons">
            <a class="btn btn-primary art-cta-btn" href={callHref} dir="ltr">{CONTACT.phones[0]}</a>
            <a class="btn btn-secondary art-cta-btn" href={secondCallHref} dir="ltr">{CONTACT.phones[1]}</a>
          </div>
        </section>

        <p class="art-disclaimer">
          This page provides general information about {entry.data.title.toLowerCase()} and is not a substitute
          for individual medical assessment. If your symptoms are severe or worsening, contact a
          clinician promptly.
        </p>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .art-head-band { border-bottom: 1px solid var(--line); }
  .art-head-wrap {
    max-width: var(--page-max); margin: 0 auto;
    padding: clamp(24px, 3.5vw, 40px) 24px clamp(32px, 4.5vw, 52px);
  }
  .crumbs {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
    margin-bottom: clamp(24px, 3.5vw, 36px);
  }
  .crumbs a {
    font-family: var(--font-mono); font-size: 12px;
    color: var(--muted); text-decoration: none; letter-spacing: 0.02em;
  }
  .crumbs a:hover { color: var(--accent); text-decoration: none; }
  .crumb-sep { color: var(--line-strong); font-size: 12px; }
  .crumb-current { font-family: var(--font-mono); font-size: 12px; color: var(--accent); }

  .art-head-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(290px, 100%), 1fr));
    gap: clamp(24px, 4vw, 64px); align-items: end;
  }
  .art-head-copy { container-type: inline-size; min-width: 0; }
  .art-h1 {
    font-family: var(--font-display);
    font-size: clamp(29px, 7cqw, 54px);
    line-height: 1.08; font-weight: 400; letter-spacing: -0.02em;
    margin: 0 0 18px; color: var(--ink); text-wrap: pretty;
  }
  .art-standfirst {
    font-size: clamp(16.5px, 1.9vw, 19px);
    line-height: 1.6; color: var(--body); max-width: 58ch;
    text-wrap: pretty; margin: 0;
  }

  .art-meta {
    margin: 0;
    display: flex; flex-direction: column; gap: 13px;
    border-inline-start: 1px solid var(--line);
    padding-inline-start: clamp(18px, 2.5vw, 28px);
    min-width: 0;
  }
  .art-meta dt {
    font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--muted); margin-bottom: 4px;
  }
  .art-meta dd { margin: 0; font-size: 15px; color: var(--ink); line-height: 1.5; }

  .art-container {
    max-width: var(--page-max); margin: 0 auto;
    padding: 0 24px; container-type: inline-size;
  }
  .art-grid {
    display: grid; grid-template-columns: minmax(0, 1fr);
    gap: clamp(28px, 4vw, 72px); align-items: start;
  }
  .art-aside { padding-top: clamp(32px, 4.5vw, 56px); min-width: 0; position: static; }
  .art-toc { display: none; flex-direction: column; }
  @container (min-width: 820px) {
    .art-grid { grid-template-columns: minmax(0, 240px) minmax(0, 1fr); }
    .art-grid > .art-body { max-width: 740px; }
    .art-aside { position: sticky; top: 96px; }
    .art-toc { display: flex; }
  }

  .art-toc-label {
    font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--muted); margin: 0 0 14px;
  }
  .art-toc-rule { display: block; border-top: 1px solid var(--ink); }
  .art-toc a {
    display: block; font-size: 14.5px; line-height: 1.45;
    color: var(--body); padding: 11px 0;
    border-bottom: 1px solid var(--line-soft); text-decoration: none;
  }
  .art-toc a:hover { color: var(--accent); text-decoration: none; }

  .art-call-card {
    display: none;   /* mobile: FAB takes over — see .art-fab below */
    margin-top: 24px;
    border: 1px solid var(--line); background: var(--surface); padding: 20px;
  }
  @container (min-width: 820px) {
    .art-call-card { display: block; }
  }

  /* Floating call button — mobile only, fades in after ~200px scroll. */
  .art-fab {
    position: fixed;
    bottom: 20px;
    inset-inline-end: 20px;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: var(--accent);
    color: var(--white);
    border-radius: 50%;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(11, 94, 120, 0.38);
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
    transition: opacity 220ms ease, transform 220ms ease;
  }
  .art-fab.is-visible { opacity: 1; transform: translateY(0); pointer-events: auto; }
  .art-fab:hover { background: var(--accent-hover); color: var(--white); text-decoration: none; }
  @container (min-width: 820px) {
    /* Desktop: the aside card handles the CTA; no FAB. */
    .art-fab { display: none; }
  }
  .art-call-label {
    font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 10px;
  }
  .art-call-body { font-size: 14px; line-height: 1.72; color: var(--body); margin: 0 0 16px; }
  .art-call-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 100%; min-height: 44px; padding: 0 16px;
    background: var(--accent); color: var(--white);
    font-size: 14.5px; font-weight: 500; border-radius: 2px;
    text-decoration: none;
  }
  .art-call-btn:hover { background: var(--accent-hover); color: var(--white); text-decoration: none; }

  .art-body { padding: clamp(32px, 4.5vw, 56px) 0 0; min-width: 0; }

  /* Legacy prose (only when article.redesigned !== true) */
  .art-prose { color: var(--ink); }
  .art-prose :global(p) {
    font-size: 17px; line-height: 1.72; color: var(--body);
    margin: 0 0 20px; text-wrap: pretty;
  }
  .art-prose :global(h2) {
    scroll-margin-top: 96px;
    font-family: var(--font-display);
    font-size: clamp(22px, 2.9vw, 29px);
    font-weight: 400; letter-spacing: -0.015em;
    color: var(--ink);
    margin: clamp(36px, 4.5vw, 52px) 0 20px;
    padding-bottom: 12px; border-bottom: 1px solid var(--ink);
    line-height: 1.1;
  }
  .art-prose :global(h3) {
    font-family: var(--font-display);
    font-size: 20px; font-weight: 400; color: var(--ink);
    margin: clamp(28px, 3.5vw, 38px) 0 14px;
    line-height: 1.2;
  }
  .art-prose :global(strong) { font-weight: 600; color: var(--ink); }
  .art-prose :global(ul), .art-prose :global(ol) {
    list-style: none; margin: 0 0 24px; padding: 0;
    border-top: 1px solid var(--line);
  }
  .art-prose :global(li) {
    display: grid; grid-template-columns: 28px minmax(0, 1fr);
    gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line);
    font-size: 16px; line-height: 1.72; color: var(--body);
  }
  .art-prose :global(li)::before {
    content: "·"; font-family: var(--font-mono);
    font-size: 22px; color: var(--accent); line-height: 1;
  }
  .art-prose :global(figure) { margin: 0 0 28px; max-width: 100%; }
  .art-prose :global(figure img) {
    display: block; width: 100%; height: auto;
    border: 1px solid var(--line); background: var(--surface);
  }
  .art-prose :global(figure figcaption) {
    font-family: var(--font-mono); font-size: 12px; line-height: 1.6;
    color: var(--muted); margin-top: 10px; letter-spacing: 0.02em;
  }
  .art-prose :global(p) > :global(img) {
    display: block; max-width: 100%; height: auto;
    border: 1px solid var(--line); background: var(--surface); margin: 0 0 28px;
  }
  .art-prose :global(blockquote) {
    margin: 32px 0;
    border-inline-start: 2px solid var(--accent);
    padding-inline-start: clamp(18px, 2.5vw, 26px);
  }
  .art-prose :global(blockquote) :global(p) {
    font-family: var(--font-display); font-size: clamp(19px, 2.3vw, 24px);
    line-height: 1.45; font-weight: 400; color: var(--ink); margin: 0;
    text-wrap: pretty;
  }

  /* CTA + disclaimer */
  .art-cta {
    border: 1px solid var(--line); background: var(--surface);
    padding: clamp(24px, 3.5vw, 36px);
    margin: clamp(40px, 5vw, 56px) 0 clamp(36px, 4.5vw, 48px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    gap: 26px; align-items: center;
  }
  .art-cta h2 {
    font-family: var(--font-display); font-size: clamp(22px, 2.7vw, 28px);
    font-weight: 400; letter-spacing: -0.015em;
    margin: 0 0 10px; color: var(--ink);
  }
  .art-cta p { font-size: 16px; line-height: 1.72; color: var(--body); margin: 0; max-width: 46ch; }
  .art-cta-buttons { display: flex; flex-direction: column; gap: 10px; }
  .art-cta-btn { min-height: 52px; font-size: 16px; justify-content: center; }

  .art-disclaimer {
    font-size: 13.5px; line-height: 1.75; color: var(--muted);
    margin: 0 0 clamp(48px, 6vw, 88px);
    padding-top: 18px; border-top: 1px solid var(--line);
  }
</style>
