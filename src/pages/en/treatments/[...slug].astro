---
import { getCollection, render } from "astro:content";
import { topicOf, isLocale, localizedHref, currentLocale } from "../../../lib/i18n";
import { wordsIn } from "../../../lib/word-count";
import ArticleLayout from "../../../components/article/ArticleLayout.astro";
import ArticleSections from "../../../components/article/ArticleSections.astro";

const locale = currentLocale(Astro);
const L = (href: string) => localizedHref(href, locale);

export async function getStaticPaths() {
  const items = await getCollection("treatments");
  return items
    .filter((e) => isLocale(e.id, "en"))
    .map((entry) => ({ params: { slug: topicOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
const isRedesigned = entry.data.redesigned === true;
const { Content, headings } = await render(entry);

const PATHWAY: Record<string, { label: string; pathway: string }> = {
  brain: { label: "Brain", pathway: "Brain — neurosurgical" },
  spine: { label: "Spine", pathway: "Spine — surgical" },
  pain:  { label: "Pain",  pathway: "Pain — interventional" },
};
const cat = ((entry.data as { pathwayOverride?: string; category?: string })
  .pathwayOverride || entry.data.category || "pain").toLowerCase();
const pathway = PATHWAY[cat] || PATHWAY.pain;

const wordCount =
  wordsIn((entry.data as { sections?: unknown }).sections) +
  wordsIn(entry.body);
const readingLabel = `${Math.max(1, Math.round(wordCount / 180))} min read`;

const publishedAt: unknown = (entry.data as { publishedAt?: unknown }).publishedAt;
const lastReviewed = publishedAt
  ? new Date(publishedAt as string).toLocaleDateString("en-US", { month: "long", year: "numeric" })
  : "—";

type TocItem = { id: string; text: string; num: string };
let toc: TocItem[] = [];
if (isRedesigned && Array.isArray(entry.data.sections)) {
  let n = 0;
  entry.data.sections.forEach((s: { type: string; heading?: string }) => {
    if (!("heading" in s) || !s.heading) return;
    n += 1;
    toc.push({ id: `s-${n}`, text: s.heading, num: String(n).padStart(2, "0") });
  });
} else {
  toc = (headings || [])
    .filter((h) => h.depth === 2)
    .map((h, i) => ({ id: h.slug, text: h.text, num: String(i + 1).padStart(2, "0") }));
}

const allTreatments = await getCollection("treatments");
const enTreatments = allTreatments.filter((e) => isLocale(e.id, "en"));
function resolveRelated(slugs: string[]) {
  return slugs.map((slug) => {
    const found = enTreatments.find((e) => topicOf(e.id) === slug);
    if (!found) return null;
    const rd = found.data.redesigned === true;
    const rcat = (found.data.pathwayOverride || found.data.category || "pain").toLowerCase();
    return {
      slug,
      title: found.data.title,
      category: PATHWAY[rcat]?.label || "Pain",
      href: rd ? L(`/treatments/${slug}/`) : "",
      redesigned: rd,
    };
  }).filter(Boolean) as {
    slug: string; title: string; category: string; href: string; redesigned: boolean;
  }[];
}

const standfirst = entry.data.description || "";
---

<ArticleLayout
  pageTitle={`${entry.data.title} — Alimran Clinic`}
  description={standfirst}
  locale="en"
  breadcrumbs={[
    { label: "Home", href: L("/") },
    { label: "Conditions treated", href: L("/conditions/") },
    { label: pathway.label },
  ]}
  h1={entry.data.title}
  meta={[
    { label: "Pathway", value: pathway.pathway },
    { label: "Reviewed by", value: "Hussein Imran Mousa, consultant neurosurgeon" },
    { label: "Reading time", value: readingLabel },
    { label: "Last reviewed", value: lastReviewed },
  ]}
  toc={toc}
  tocLabel="On this page"
  callLabel="Discuss this"
  callBody="Speak to the secretary about a consultation for this condition."
  ctaHeading="Book a consultation"
  ctaBody="The secretary schedules first appointments during clinic hours; please have prior imaging, operative notes and a current medication list available at the time of the call."
  disclaimer={`This page provides general information about ${entry.data.title.toLowerCase()} and is not a substitute for individual medical assessment. If your symptoms are severe or worsening, contact a clinician promptly.`}
>
  {isRedesigned && Array.isArray(entry.data.sections) ? (
    <ArticleSections sections={entry.data.sections} locale={locale} resolveRelated={resolveRelated} />
  ) : (
    <div class="art-prose">
      <Content />
    </div>
  )}
</ArticleLayout>
