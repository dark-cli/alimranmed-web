---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { CONTACT } from "../consts";
import en from "../i18n/en.json";

const dict = en as Record<string, string>;

const doctors = (await getCollection("doctors"))
  .sort((a, b) => a.data.order - b.data.order);

// Featured service categories (top-level landing pages). Hrefs match the
// nav in src/data/navigation.ts.
const featured: Array<{ href: string; title: string; desc: string }> = [
  { href: "/treatments/", title: "What We Treat", desc: "Comprehensive taxonomy of neurology, pain, and musculoskeletal conditions." },
  { href: "/services/chiropractic/", title: "Chiropractic", desc: "SPINMED and Sigma systems for precise spinal alignment." },
  { href: "/services/brain-stimulation/", title: "Brain Stimulation", desc: "TMS and tDCS for stroke, migraine, depression, tinnitus, and more." },
  { href: "/services/physiotherapy/", title: "Physiotherapy", desc: "LUNA EMG robot, magnetic field, laser, ultrasound, and more." },
  { href: "/services/surgery/", title: "Surgery", desc: "Vertebroplasty, endoscopic spine surgery, DBS, and beyond." },
  { href: "/services/rehabilitation/", title: "Rehabilitation", desc: "Stroke recovery, speech therapy, occupational therapy, and nursing care." },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Alimran Medical Center · Basra, Iraq</span>
        <h1>Specialised care for neurology & musculoskeletal disorders.</h1>
        <p class="lede">
          Consultant-led diagnosis and treatment across chiropractic, rehabilitation,
          pain management, brain stimulation, physiotherapy, and neurosurgery — with
          the latest evidence-based techniques.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={`tel:${CONTACT.phones[0].replace(/\s/g, "")}`}>{dict["cta.callUs"]}</a>
          <a class="btn btn-ghost" href="/doctors/">{dict["nav.doctors"]}</a>
        </div>
      </div>
      <div class="hero-panel" aria-hidden="true">
        <div class="pulse"></div>
        <svg viewBox="0 0 200 200" width="220" height="220">
          <defs>
            <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="var(--brand)" />
              <stop offset="1" stop-color="var(--accent)" />
            </linearGradient>
          </defs>
          <circle cx="100" cy="100" r="90" fill="none" stroke="url(#g)" stroke-width="6" opacity="0.35" />
          <circle cx="100" cy="100" r="60" fill="none" stroke="url(#g)" stroke-width="6" opacity="0.6" />
          <circle cx="100" cy="100" r="30" fill="url(#g)" />
        </svg>
      </div>
    </div>
  </section>

  <section class="specialties">
    <div class="container">
      <header class="section-head">
        <h2>Our services</h2>
        <p>Every treatment offered under one roof, delivered by consultant-led teams.</p>
      </header>
      <div class="specialty-grid">
        {featured.map((f) => (
          <a class="specialty-card card" href={f.href}>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
            <span class="learn-more">Explore →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {doctors.length > 0 && (
    <section class="doctors-section">
      <div class="container">
        <header class="section-head">
          <h2>{dict["nav.doctors"]}</h2>
        </header>
        <div class="doctor-grid">
          {doctors.map((d) => (
            <a class="doctor-card card" href={`/doctors/${d.id}/`}>
              <h3>{d.data.fullName || d.data.title}</h3>
              {d.data.specialty && <p class="specialty">{d.data.specialty}</p>}
              {d.data.titles.length > 0 && (
                <p class="creds">{d.data.titles.join(" · ")}</p>
              )}
              <span class="learn-more">View profile →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="contact-strip">
    <div class="container contact-inner">
      <div>
        <h2>Get in touch</h2>
        <p>We answer during clinic hours. For urgent matters call ahead.</p>
      </div>
      <div class="contact-details">
        {CONTACT.phones.map((p) => (
          <a class="contact-item" href={`tel:${p.replace(/\s/g, "")}`}>
            <strong>{p}</strong>
          </a>
        ))}
        <a class="contact-item" href={`mailto:${CONTACT.email}`}>
          <strong>{CONTACT.email}</strong>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 4rem 0 3rem;
    background: linear-gradient(180deg, var(--brand-soft) 0%, var(--surface-alt) 100%);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: 1.4fr 1fr; }
  }
  .eyebrow {
    display: inline-block;
    color: var(--brand);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .hero-copy h1 { max-width: 20ch; }
  .hero-copy .lede {
    font-size: 1.1rem;
    color: var(--ink-soft);
    max-width: 60ch;
    margin-bottom: 1.5rem;
  }
  .hero-cta { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .hero-panel {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .pulse {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(47, 167, 122, 0.15), transparent 70%);
    animation: pulse 3s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.05); opacity: 0.8; }
  }

  .specialties, .doctors-section, .contact-strip { padding: 4rem 0; }
  .section-head {
    text-align: center;
    max-width: 60ch;
    margin: 0 auto 2rem;
  }
  .section-head p { color: var(--ink-soft); }

  .specialty-grid, .doctor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .specialty-card, .doctor-card { text-decoration: none; color: inherit; display: block; }
  .specialty-card:hover, .doctor-card:hover { text-decoration: none; }
  .specialty-card h3, .doctor-card h3 { color: var(--brand); }
  .specialty-card p, .doctor-card p { color: var(--ink-soft); }
  .learn-more { color: var(--brand); font-weight: 600; font-size: 0.9rem; }
  .doctor-card .specialty { font-weight: 600; color: var(--ink); margin-bottom: 0.3em; }
  .doctor-card .creds { font-size: 0.85rem; color: var(--ink-muted); }

  .contact-strip {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 700px) {
    .contact-inner { grid-template-columns: 1fr 1fr; }
  }
  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .contact-item {
    display: inline-block;
    padding: 0.85em 1em;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--brand);
    text-decoration: none;
  }
  .contact-item:hover { border-color: var(--brand); background: var(--brand-soft); }
</style>
