---
import { getCollection, render } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { topicOf, isLocale } from "../../lib/i18n";

// Only emits EN pages here; AR mirror at /pages/ar/treatments/[...slug].astro
export async function getStaticPaths() {
  const items = await getCollection("treatments");
  return items
    .filter((e) => isLocale(e.id, "en"))
    .map((entry) => ({ params: { slug: topicOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ContentLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  category={entry.data.category}
  backHref="/treatments/"
  backLabel="What We Treat"
>
  <Content />
</ContentLayout>
